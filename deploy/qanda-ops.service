[Unit]
Description=QandA restricted deployment and container operations
Requires=docker.service
After=docker.service network-online.target
PartOf=docker.service
Before=qanda-tailnet.service

[Service]
Type=simple
ExecStartPre=/usr/local/lib/qanda/network-guard.py
ExecStartPre=/usr/sbin/sshd -t -f /etc/ssh/qanda-ops.conf
ExecStart=/usr/sbin/sshd -D -e -f /etc/ssh/qanda-ops.conf
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
