<root-portal enable="{{true}}" wx:if="{{visible}}">
<view class="portal-theme overview" wx:if="{{visible}}">
  <!-- 根节点保留 wx:if，关闭浮层时释放占位。 -->
  <view class="mask" catchtap="handleMaskTap" catchtouchmove="noop"></view>

  <view class="panel" catchtap="noop" hover-class="none">
    <view class="panel-grip"></view>

    <view class="panel-header">
      <text class="panel-title">答题卡</text>
    </view>

    <!-- 统计兼作图例，交卷前只展示作答状态，避免泄露判题结果。 -->
    <view class="panel-stats" wx:if="{{showStatus}}">
      <view class="stat-item stat-current">
        <view class="status-swatch swatch-current" aria-hidden="true"></view>
        <text class="stat-label">当前</text>
      </view>
      <view class="stat-item">
        <view class="status-swatch swatch-pending" aria-hidden="true"></view>
        <text class="stat-label">未答</text>
        <text class="stat-count">{{unansweredCount}}</text>
      </view>
      <view class="stat-item">
        <view class="status-swatch swatch-draft" aria-hidden="true"></view>
        <text class="stat-label">草稿</text>
        <text class="stat-count">{{draftCount}}</text>
      </view>
      <view class="stat-item">
        <view class="status-swatch swatch-answered" aria-hidden="true"></view>
        <text class="stat-label">已答</text>
        <text class="stat-count">{{answeredCount}}</text>
      </view>
      <view class="stat-item stat-marked">
        <view class="status-swatch swatch-mark" aria-hidden="true"></view>
        <text class="stat-label">标记</text>
        <text class="stat-count">{{markedCount}}</text>
      </view>
    </view>
    <text class="panel-sub" wx:else>点击题号快速查看</text>

    <scroll-view class="grid-scroll" scroll-y enhanced bounces show-scrollbar="{{false}}">
      <view class="grid">
        <view
          wx:for="{{items}}"
          wx:key="index"
          class="cell {{item.isCurrent ? 'cell-current' : ''}} {{item.isDraft ? 'cell-draft' : (item.answered ? 'cell-answered' : 'cell-pending')}}"
          data-index="{{item.index}}"
          bindtap="handleItemTap"
          hover-class="cell-hover"
          hover-start-time="0"
          hover-stay-time="80"
        >
          <text class="cell-number">{{item.number}}</text>
          <view class="cell-mark" wx:if="{{item.isMarked}}"></view>
        </view>
      </view>
    </scroll-view>

    <!-- 按钮组三态，对应设计稿的三个答题卡面板：
         ① 还有未答 → 确认结束（红描边，左）/ 继续答题（蓝，右）
         ② 全答完且有标记 → 继续答题 / 含标记，前往查看，确认结束另起一行（红描边）
         ③ 全答完无标记 → 继续答题 / 确认结束（橙实心，交卷成了唯一主操作） -->
    <view class="panel-actions">
      <view class="panel-row" wx:if="{{unansweredCount > 0}}">
        <button
          class="q-button q-button--danger panel-btn"
          wx:if="{{canSubmit}}"
          bindtap="handleSubmitTap"
          hover-class="q-button-hover"
          hover-start-time="0"
          hover-stay-time="80"
        >确认结束</button>
        <button
          class="q-button q-button--primary panel-btn"
          bindtap="handleMaskTap"
          hover-class="q-button-hover"
          hover-start-time="0"
          hover-stay-time="80"
        >继续答题</button>
      </view>

      <block wx:else>
        <view class="panel-row">
          <button
            class="q-button q-button--primary panel-btn"
            bindtap="handleMaskTap"
            hover-class="q-button-hover"
            hover-start-time="0"
            hover-stay-time="80"
          >继续答题</button>
          <button
            class="q-button q-button--primary panel-btn"
            wx:if="{{markedCount > 0}}"
            bindtap="handleJumpMarkedTap"
            hover-class="q-button-hover"
            hover-start-time="0"
            hover-stay-time="80"
          >含标记，前往查看</button>
          <button
            class="q-button q-button--primary panel-btn"
            wx:else
            bindtap="handleSubmitTap"
            hover-class="q-button-hover"
            hover-start-time="0"
            hover-stay-time="80"
          >确认结束</button>
        </view>
        <button
          class="q-button q-button--danger panel-btn panel-row-single"
          wx:if="{{markedCount > 0}}"
          bindtap="handleSubmitTap"
          hover-class="q-button-hover"
          hover-start-time="0"
          hover-stay-time="80"
        >确认结束</button>
      </block>
    </view>
  </view>
</view>

</root-portal>
