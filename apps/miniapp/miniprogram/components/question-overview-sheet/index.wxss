@import "../../styles/controls.wxss";

.overview {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  display: flex;
  align-items: flex-end;
}

.mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 22, 33, 0.45);
}

.panel {
  position: relative;
  width: 100%;
  max-height: 68vh;
  padding: 16rpx 40rpx 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--card);
  border-radius: var(--radius-overlay) var(--radius-overlay) 0 0;
  display: flex;
  flex-direction: column;
}

/* 顶部拖动条：只做视觉暗示，不接手势 */
.panel-grip {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  background: var(--line);
  border-radius: 999rpx;
}

.panel-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.panel-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--text-main);
}

.panel-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  margin-bottom: 24rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  flex: none;
  white-space: nowrap;
}

.stat-label {
  color: var(--text-sub);
}

.stat-count {
  margin-left: 6rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  color: var(--text-main);
}

.stat-current {
  margin-right: 8rpx;
}

.stat-marked {
  margin-left: 8rpx;
}

@media (max-width: 350px) {
  .panel-stats { gap: 8rpx; }
}

.panel-sub {
  font-size: var(--font-caption);
  color: var(--text-sub);
  margin-bottom: 8rpx;
}

.status-swatch {
  flex: none;
  width: 18rpx;
  height: 18rpx;
  border-radius: 4rpx;
  margin-right: 6rpx;
  box-sizing: border-box;
}

.swatch-answered {
  background: var(--success-soft);
  border: 2rpx solid var(--success);
}

.swatch-pending {
  background: var(--card);
  border: 2rpx dashed var(--line);
}

.swatch-draft {
  background: var(--warning-soft);
  border: 2rpx dashed var(--warning);
}

.swatch-current {
  background: var(--brand);
}

.swatch-mark {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--warning);
}

.grid-scroll {
  flex: 1;
  min-height: 0;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  padding-bottom: 8rpx;
}

.cell {
  position: relative;
  flex: 0 0 auto;
  /* 6 格正好铺满一行：(100% - 5×间距) / 6，写死宽度会在右边剩一条空档 */
  width: calc((100% - 80rpx) / 6);
  height: 90rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-tag);
  /* 基态 = 未答：白底虚线框。⚠️ 必须 border-box，否则 2rpx 边框会把 6 格挤成 5 格 */
  background: var(--card);
  border: 2rpx dashed var(--line);
  box-sizing: border-box;
  transition: opacity 100ms ease;
}

.cell:nth-child(6n) {
  margin-right: 0;
}

.cell-hover {
  opacity: 0.86;
}

.cell-number {
  font-size: var(--font-secondary);
  font-weight: 600;
  color: var(--text-sub);
}

.cell.cell-answered {
  background: var(--success-soft);
  border-style: solid;
  border-color: var(--success-soft);
}

.cell.cell-answered .cell-number {
  color: var(--success);
}

/* 当前题压过其它状态：蓝底白字，一眼能找到「我在哪」 */
.cell.cell-current {
  background: var(--brand);
  border-style: solid;
  border-color: var(--brand);
}

.cell.cell-current .cell-number {
  color: var(--card);
}

/* 标记点固定在右上角，不随题号居中 */
.cell-mark {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--warning);
}

.panel-actions {
  flex: none;
  padding-top: 20rpx;
}

.panel-row {
  display: flex;
  align-items: center;
}

.panel-row-single {
  margin-top: 18rpx;
}

.panel-btn {
  flex: 1;

  box-sizing: border-box;

}

.panel-btn + .panel-btn {
  margin-left: 20rpx;
}

/* 按压反馈只用 opacity：弹层里的按钮如果加位移，整块面板会跟着视觉抖动 */
.panel-btn-hover {
  opacity: 0.86;
}

.cell-draft { background: var(--warning-soft); border-color: var(--warning); border-style: dashed; }
.cell-draft .cell-number { color: var(--warning); }
