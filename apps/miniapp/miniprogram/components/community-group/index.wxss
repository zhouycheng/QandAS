@import "../../styles/controls.wxss";
:host { display: block; flex: none; }
.group-card { margin: 24rpx 0; padding: 24rpx; border: 2rpx solid var(--page-bg); border-radius: var(--radius-card); background: var(--card); }
.group-entry { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; }
.group-title { display: block; color: var(--text-main); font-size: var(--font-body); font-weight: 600; }
.group-description { display: block; margin-top: 10rpx; color: var(--text-sub); font-size: var(--font-caption); }
.group-arrow { margin-left: 16rpx; color: var(--text-sub); font-size: var(--font-title); }
.group-qr { display: block; width: 100%; }
.group-help { display: block; padding: 16rpx 0; color: var(--text-sub); font-size: var(--font-caption); line-height: 1.6; text-align: center; }
.group-hover { opacity: .65; }
.group-compact { margin-left: 16rpx; padding: 8rpx 16rpx; border: 1rpx solid rgba(255, 255, 255, .5); border-radius: 999rpx; color: var(--card); font-size: var(--font-secondary); line-height: 1.5; white-space: nowrap; }
.group-compact-arrow { margin-left: 6rpx; font-size: var(--font-secondary); }
