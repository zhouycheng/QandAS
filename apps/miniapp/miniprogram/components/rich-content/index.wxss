.rich-content { line-height: 1.7; overflow-wrap: anywhere; min-width: 0; }
.rich-code { border-radius: 12rpx; overflow: hidden; margin: 20rpx 0; background: #f6f7f9; font-weight: 400; }
.code-bar { display: flex; align-items: center; justify-content: space-between; padding: 10rpx 24rpx 0; color: #86909c; font-size: 21rpx; font-weight: 400; }
.code-copy { margin: 0; padding: 4rpx 0 4rpx 20rpx; border: 0; border-radius: 0; line-height: 1.7; color: #667085; background: transparent; font-size: 22rpx; font-weight: 400; }
.code-copy::after { border: 0; }
.code-scroll { width: 100%; padding: 12rpx 24rpx 24rpx; box-sizing: border-box; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .88em; font-weight: 400; line-height: 1.65; }
.rich-fill-line { display: flex; flex-wrap: wrap; align-items: baseline; margin: 8rpx 0; line-height: 2.1; }
.rich-inline { display: inline-block; min-width: 0; max-width: 100%; }
.rich-blank { display: inline-block; vertical-align: baseline; width: 180rpx; height: 1.7em; margin: 0 8rpx; padding: 0 8rpx; border: 0; border-bottom: 2rpx solid #86909c; border-radius: 0; background: transparent; color: #1d2129; font-size: inherit; font-weight: 400; text-align: center; box-sizing: border-box; }
.rich-blank:focus { outline: 0; border-bottom-color: #466bff; }
.table-scroll { width: 100%; margin: 12rpx 0; }
.rich-link { color: #165dff; font-size: 24rpx; padding: 8rpx 0; overflow-wrap: anywhere; }
.copy-hover { opacity: .65; }

.rich-fill-table { display: table; border-collapse: collapse; min-width: 100%; }
.rich-fill-row { display: table-row; }
.rich-fill-cell { display: table-cell; min-width: 100rpx; border: 1rpx solid #ddd; padding: 12rpx; white-space: nowrap; }
.rich-fill-heading { font-weight: 600; }
