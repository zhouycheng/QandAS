@import "../../styles/controls.wxss";
.rich-content { line-height: 1.65; overflow-wrap: anywhere; min-width: 0; }
.rich-code { border-radius: var(--radius-tag); overflow: hidden; margin: 20rpx 0; background: var(--page-bg); font-weight: 400; }
.code-bar { display: flex; align-items: center; justify-content: space-between; padding: 10rpx 24rpx 0; color: var(--text-sub); font-size: var(--font-caption); font-weight: 400; }
.code-copy { margin: 0;         }
.code-scroll { width: 100%; padding: 12rpx 24rpx 24rpx; box-sizing: border-box; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: inherit; font-weight: 400; line-height: 1.65; }
.rich-fill-line { display: flex; flex-wrap: wrap; align-items: baseline; margin: 8rpx 0; line-height: 2.1; }
.rich-inline { display: inline-block; min-width: 0; max-width: 100%; }
.rich-blank { display: inline-block; vertical-align: baseline; width: 180rpx; height: 1.7em; margin: 0 8rpx; padding: 0 8rpx; border: 0; border-bottom: 2rpx solid var(--text-sub); border-radius: 0; background: transparent; color: var(--text-main); font-size: inherit; font-weight: 400; text-align: center; box-sizing: border-box; }
.rich-blank:focus { outline: 0; border-bottom-color: var(--brand); }
.table-scroll { width: 100%; margin: 12rpx 0; }
.rich-link { color: var(--brand); font-size: var(--font-secondary); padding: 8rpx 0; overflow-wrap: anywhere; }
.copy-hover { opacity: .65; }

.rich-fill-table { display: table; border-collapse: collapse; min-width: 100%; }
.rich-fill-row { display: table-row; }
.rich-fill-cell { display: table-cell; min-width: 100rpx; border: 1rpx solid var(--line); padding: 12rpx; white-space: nowrap; }
.rich-fill-heading { font-weight: 600; }
