@import "../../styles/controls.wxss";
.toast-position { position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 1200; max-width: 80vw; pointer-events: none; }
.toast-bubble { padding: 24rpx 34rpx; border-radius: var(--radius-card); background: rgba(28, 34, 48, .9); color: var(--card); font-size: var(--font-secondary); line-height: 1.5; text-align: center; box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, .12); animation: toast-enter 160ms ease-out both; }
.toast-bubble.is-leaving { animation: toast-leave 160ms ease-in both; }
@keyframes toast-enter { from { opacity: 0; transform: translateY(8rpx) scale(.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes toast-leave { from { opacity: 1; transform: translateY(0) scale(1); } to { opacity: 0; transform: translateY(-4rpx) scale(.98); } }
