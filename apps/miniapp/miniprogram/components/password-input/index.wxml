<view class="portal-theme password-field">
  <input class="field-input input-class {{error ? 'field-input-error' : ''}}" type="text" password="{{!visible}}" value="{{value}}" placeholder="{{placeholder}}" placeholder-class="field-ph" maxlength="{{maxlength}}" disabled="{{disabled}}" focus="{{focused}}" confirm-type="{{confirmType}}" bindinput="input" bindconfirm="confirm" bindfocus="focus" bindblur="blur" />
  <view class="password-eye {{visible ? 'password-eye-on' : ''}} {{disabled ? 'password-eye-disabled' : ''}}" role="button" aria-label="{{visible ? '隐藏密码' : '显示密码'}}" catchtap="toggleVisibility" hover-class="password-eye-hover" hover-start-time="0" hover-stay-time="80">
    <view class="password-eye-icon"></view>
  </view>
</view>
