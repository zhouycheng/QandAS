<view class="pra-stem"><rich-content text="{{(currentQuestion.stem) || ''}}" format="{{(currentQuestion.contentFormat) || 'PLAIN_TEXT'}}" blanks="{{currentQuestion.isFillBlank ? blankInputs : null}}" disabled="{{answerLocked}}" managed-keyboard="{{!editLayout}}" bindblankinput="inputBlank" bindblankfocus="onAnswerFocus" bindblankblur="onAnswerBlur" bindblankkeyboard="onKeyboardHeight" /></view><question-images paths="{{(currentQuestion.imagePaths) || []}}" /><view class="pra-analysis" wx:if="{{isViewMode && !editLayout && shouldRevealAnswer}}"><include src="practice-analysis.wxml" /></view>
