<view class="pra-content" id="layout-content">
  <view id="layout-module-info" class="pra-module module-info {{editLayout ? 'layout-module' : ''}} {{dragId === 'info' ? 'layout-dragging' : ''}}" style="order: {{layoutRanks.info}};" data-module="info">
    <view class="layout-insert" wx:if="{{editLayout && dragTarget === 'info'}}">松手放在这里</view>
    <view class="layout-drag-surface" wx:if="{{editLayout}}" data-module="info" aria-label="拖动{{moduleLabels.info}}调整顺序" catchtouchstart="{{layoutDrag.start}}"></view>
<view class="pra-meta">
      <text class="pra-meta-index">{{currentNumber}}/{{total}}</text>
      <view class="pra-meta-tags"><text wx:if="{{practiceModeText}}" class="pra-meta-type">{{practiceModeText}}</text><text class="pra-meta-type">{{currentQuestion.typeText}}</text></view>
      <text class="pra-meta-timer">{{isTimed ? timerText : elapsedText}}</text>
    </view>
  </view>
  <view id="layout-module-stem" class="pra-module module-stem {{editLayout ? 'layout-module' : ''}} {{dragId === 'stem' ? 'layout-dragging' : ''}}" hidden="{{fixedLayout && !editLayout && keyboardVisible && !paneHeights.stem}}" style="order: {{layoutRanks.stem}};" data-module="stem">
    <view class="layout-insert" wx:if="{{editLayout && dragTarget === 'stem'}}">松手放在这里</view>
    <view class="layout-drag-surface" wx:if="{{editLayout}}" data-module="stem" aria-label="拖动{{moduleLabels.stem}}调整顺序" catchtouchstart="{{layoutDrag.start}}"></view>
    <view wx:if="{{currentQuestion.material && !readingLayout}}" class="pra-pane pra-material-pane" hidden="{{!editLayout && keyboardVisible}}" style="{{!fixedLayout ? '' : 'height:' + paneHeights.material + 'px;'}}">
      <scroll-view class="pra-pane-scroll" scroll-y="{{fixedLayout}}" enhanced bounces="{{false}}" show-scrollbar="{{false}}" scroll-top="{{paneScroll.material}}" data-pane="material" bindscroll="onPaneScroll">
        <view class="pra-pane-content" data-pane="material"><view class="pra-material"><text class="pra-side-title">阅读材料</text><rich-content text="{{(currentQuestion.material.passage) || ''}}" format="{{(currentQuestion.material.contentFormat) || 'PLAIN_TEXT'}}" /><question-images paths="{{(currentQuestion.material.imagePaths) || []}}" /></view></view>
      </scroll-view>
      <text wx:if="{{fixedLayout && !editLayout && paneOverflow.material}}" class="pra-scroll-hint">区域内滑动阅读</text>
    </view>
    <view class="pra-pane pra-stem-pane" hidden="{{fixedLayout && !editLayout && keyboardVisible && !paneHeights.stem}}" style="{{!fixedLayout ? '' : 'height:' + paneHeights.stem + 'px;'}}">
      <scroll-view class="pra-pane-scroll" scroll-y="{{fixedLayout}}" enhanced bounces="{{false}}" show-scrollbar="{{false}}" scroll-top="{{paneScroll.stem}}" data-pane="stem" bindscroll="onPaneScroll">
        <view class="pra-pane-content" data-pane="stem"><include src="practice-stem.wxml" /></view>
      </scroll-view>
      <text wx:if="{{fixedLayout && !editLayout && paneOverflow.stem}}" class="pra-scroll-hint">区域内滑动阅读</text>
    </view>
  </view>
  <view wx:if="{{!currentQuestion.isFillBlank}}" id="layout-module-response" class="pra-module module-response {{editLayout ? 'layout-module' : ''}} {{dragId === 'response' ? 'layout-dragging' : ''}}" style="order: {{layoutRanks.response}};" data-module="response">
    <view class="layout-insert" wx:if="{{editLayout && dragTarget === 'response'}}">松手放在这里</view>
    <view class="layout-drag-surface" wx:if="{{editLayout}}" data-module="response" aria-label="拖动{{moduleLabels.response}}调整顺序" catchtouchstart="{{layoutDrag.start}}"></view>
    <view class="pra-pane pra-response-pane" style="{{!fixedLayout ? '' : 'height:' + paneHeights.response + 'px;'}}">
      <scroll-view class="pra-pane-scroll" scroll-y="{{(fixedLayout) && (!currentQuestion.isShortAnswer || isViewMode)}}" enhanced bounces="{{false}}" show-scrollbar="{{false}}" scroll-top="{{paneScroll.response}}" data-pane="response" bindscroll="onPaneScroll">
        <view class="pra-pane-content {{currentQuestion.isShortAnswer ? 'pra-textarea-content' : 'pra-options-content'}}" style="{{fixedLayout && !currentQuestion.isShortAnswer ? 'min-height:' + paneHeights.response + 'px;' : ''}}" data-pane="response">
<include src="practice-response.wxml" />
        </view>
      </scroll-view>
      <text wx:if="{{fixedLayout && !editLayout && !currentQuestion.isShortAnswer && paneOverflow.response}}" class="pra-scroll-hint">区域内滑动作答</text>
    </view>
  </view>
  <view wx:if="{{editLayout || fixedLayout || layoutRanks.tools !== 3}}" id="layout-module-tools" class="pra-module module-tools {{editLayout ? 'layout-module' : ''}} {{dragId === 'tools' ? 'layout-dragging' : ''}}" hidden="{{!editLayout && keyboardCompact}}" style="order: {{layoutRanks.tools}};" data-module="tools">
    <view class="layout-insert" wx:if="{{editLayout && dragTarget === 'tools'}}">松手放在这里</view>
    <view class="layout-drag-surface" wx:if="{{editLayout}}" data-module="tools" aria-label="拖动{{moduleLabels.tools}}调整顺序" catchtouchstart="{{layoutDrag.start}}"></view>
<include src="practice-tools.wxml" />
  </view>
</view>
<view class="pra-body-pad"></view>
