<view class="pra-content" id="layout-content">
  <view id="layout-module-info" class="pra-module module-info {{editLayout ? 'layout-module' : ''}} {{dragId === 'info' ? 'layout-dragging' : ''}}" style="order: {{layoutRanks.info}};" data-module="info">
    <view class="layout-insert" wx:if="{{editLayout && dragTarget === 'info'}}">松手放在这里</view>
    <view class="layout-drag-surface" wx:if="{{editLayout}}" data-module="info" aria-label="拖动{{moduleLabels.info}}调整顺序" catchtouchstart="{{layoutDrag.start}}"></view>
<view class="pra-meta">
      <text class="pra-meta-index">{{currentNumber}}/{{total}}</text>
      <text class="pra-meta-type">{{currentQuestion.typeText}}</text>
      <text class="pra-meta-timer">{{isTimed ? timerText : elapsedText}}</text>
    </view>
  </view>
  <view id="layout-module-stem" class="pra-module module-stem {{editLayout ? 'layout-module' : ''}} {{dragId === 'stem' ? 'layout-dragging' : ''}}" hidden="{{!editLayout && keyboardVisible && !paneHeights.stem}}" style="order: {{layoutRanks.stem}};" data-module="stem">
    <view class="layout-insert" wx:if="{{editLayout && dragTarget === 'stem'}}">松手放在这里</view>
    <view class="layout-drag-surface" wx:if="{{editLayout}}" data-module="stem" aria-label="拖动{{moduleLabels.stem}}调整顺序" catchtouchstart="{{layoutDrag.start}}"></view>
    <view wx:if="{{currentQuestion.material}}" class="pra-pane pra-material-pane" hidden="{{!editLayout && keyboardVisible}}" style="{{editLayout ? '' : 'height:' + paneHeights.material + 'px;'}}">
      <scroll-view class="pra-pane-scroll" scroll-y="{{!editLayout}}" enhanced bounces="{{false}}" show-scrollbar="{{false}}" scroll-top="{{paneScroll.material}}" data-pane="material" bindscroll="onPaneScroll">
        <view class="pra-pane-content" data-pane="material"><view class="pra-material"><text class="pra-side-title">阅读材料</text><rich-content text="{{(currentQuestion.material.passage) || ''}}" format="{{(currentQuestion.material.contentFormat) || 'PLAIN_TEXT'}}" /><question-images paths="{{(currentQuestion.material.imagePaths) || []}}" /></view></view>
      </scroll-view>
      <text wx:if="{{!editLayout && paneOverflow.material}}" class="pra-scroll-hint">区域内滑动阅读</text>
    </view>
    <view class="pra-pane pra-stem-pane" hidden="{{!editLayout && keyboardVisible && !paneHeights.stem}}" style="{{editLayout ? '' : 'height:' + paneHeights.stem + 'px;'}}">
      <scroll-view class="pra-pane-scroll" scroll-y="{{!editLayout}}" enhanced bounces="{{false}}" show-scrollbar="{{false}}" scroll-top="{{paneScroll.stem}}" data-pane="stem" bindscroll="onPaneScroll">
        <view class="pra-pane-content" data-pane="stem"><view class="pra-stem"><rich-content text="{{(currentQuestion.stem) || ''}}" format="{{(currentQuestion.contentFormat) || 'PLAIN_TEXT'}}" blanks="{{currentQuestion.isFillBlank ? blankInputs : null}}" disabled="{{answerLocked}}" managed-keyboard="{{!editLayout}}" bindblankinput="inputBlank" bindblankfocus="onAnswerFocus" bindblankblur="onAnswerBlur" bindblankkeyboard="onKeyboardHeight" /></view><question-images paths="{{(currentQuestion.imagePaths) || []}}" /></view>
      </scroll-view>
      <text wx:if="{{!editLayout && paneOverflow.stem}}" class="pra-scroll-hint">区域内滑动阅读</text>
    </view>
  </view>
  <view wx:if="{{!currentQuestion.isFillBlank}}" id="layout-module-response" class="pra-module module-response {{editLayout ? 'layout-module' : ''}} {{dragId === 'response' ? 'layout-dragging' : ''}}" style="order: {{layoutRanks.response}};" data-module="response">
    <view class="layout-insert" wx:if="{{editLayout && dragTarget === 'response'}}">松手放在这里</view>
    <view class="layout-drag-surface" wx:if="{{editLayout}}" data-module="response" aria-label="拖动{{moduleLabels.response}}调整顺序" catchtouchstart="{{layoutDrag.start}}"></view>
    <view class="pra-pane pra-response-pane" style="{{editLayout ? '' : 'height:' + paneHeights.response + 'px;'}}">
      <scroll-view class="pra-pane-scroll" scroll-y="{{!editLayout && !currentQuestion.isShortAnswer}}" enhanced bounces="{{false}}" show-scrollbar="{{false}}" scroll-top="{{paneScroll.response}}" data-pane="response" bindscroll="onPaneScroll">
        <view class="pra-pane-content {{currentQuestion.isShortAnswer ? 'pra-textarea-content' : ''}}" data-pane="response">
<textarea data-no-swipe="true" adjust-position="{{editLayout}}" bindfocus="onAnswerFocus" bindblur="onAnswerBlur" bindkeyboardheightchange="onKeyboardHeight" wx:if="{{currentQuestion.isShortAnswer}}" value="{{answerText}}" disabled="{{answerLocked}}" maxlength="10000" placeholder="填写你的答案" bindinput="inputAnswerText" />
        <view class="pra-options">
          <view
            wx:for="{{currentQuestion.options}}"
            wx:key="key"
            class="pra-option {{item.selected ? 'is-selected' : ''}} {{item.isCorrectOption ? 'is-correct' : ''}} {{item.isWrongOption ? 'is-wrong' : ''}}"
            data-index="{{index}}"
            bindtap="selectOption"
            hover-class="pra-option-hover"
            hover-start-time="0"
            hover-stay-time="80"
          >
            <text class="pra-option-key">{{item.label}}</text>
            <view class="pra-option-text"><rich-content text="{{(item.text) || ''}}" format="{{(currentQuestion.contentFormat) || 'PLAIN_TEXT'}}" /></view>
          </view>
        </view>
        </view>
      </scroll-view>
      <text wx:if="{{!editLayout && !currentQuestion.isShortAnswer && paneOverflow.response}}" class="pra-scroll-hint">区域内滑动作答</text>
    </view>
  </view>
  <view id="layout-module-analysis" class="pra-module module-analysis {{editLayout ? 'layout-module' : ''}} {{dragId === 'analysis' ? 'layout-dragging' : ''}}" hidden="{{!editLayout && (!shouldRevealAnswer || keyboardVisible)}}" style="order: {{layoutRanks.analysis}};" data-module="analysis">
    <view class="layout-insert" wx:if="{{editLayout && dragTarget === 'analysis'}}">松手放在这里</view>
    <view class="layout-drag-surface" wx:if="{{editLayout}}" data-module="analysis" aria-label="拖动{{moduleLabels.analysis}}调整顺序" catchtouchstart="{{layoutDrag.start}}"></view>
    <view class="pra-pane pra-analysis-pane" style="{{editLayout ? '' : 'height:' + paneHeights.analysis + 'px;'}}">
      <scroll-view class="pra-pane-scroll" scroll-y="{{!editLayout}}" enhanced bounces="{{false}}" show-scrollbar="{{false}}" scroll-top="{{paneScroll.analysis}}" data-pane="analysis" bindscroll="onPaneScroll">
        <view class="pra-pane-content" data-pane="analysis">
<view class="pra-analysis" wx:if="{{shouldRevealAnswer}}">
        <view class="pra-analysis-head">
          <text class="pra-result-tag {{isCurrentAnswerCorrect ? 'ok' : 'no'}}">{{currentQuestion.isShortAnswer ? (currentQuestion.presentation === 'CODE_WRITING' ? '参考实现 · 不计分' : '参考思路 · 不计分') : (isViewMode ? '参考答案' : (isCurrentAnswerCorrect ? '答对啦' : '答错了'))}}</text>
          <rich-content text="{{(currentCorrectAnswerText) || ''}}" format="{{(currentQuestion.isShortAnswer ? currentQuestion.contentFormat : 'PLAIN_TEXT') || 'PLAIN_TEXT'}}" />
        </view>
        <rich-content class="pra-scoring" wx:for="{{currentQuestion.scoringPoints}}" wx:key="*this" text="{{(index + 1) + '. ' + (item || '')}}" format="{{(currentQuestion.contentFormat) || 'PLAIN_TEXT'}}" />

        <view class="pra-explanation {{explanationOpen ? 'is-open' : ''}}" wx:if="{{shouldShowExplanation}}">
          <text class="pra-side-title">解析</text>
          <rich-content class="pra-explanation-text" text="{{(currentExplanation) || ''}}" format="{{(currentQuestion.contentFormat) || 'PLAIN_TEXT'}}" />
          <view
            class="pra-explanation-toggle"
            bindtap="toggleExplanation"
            hover-class="chip-flat-hover"
            hover-start-time="0"
            hover-stay-time="80"
          >{{explanationOpen ? '收起解析' : '展开全部解析'}}</view>
        </view>

        <view class="pra-explanation-muted" wx:else>
          <text>解析已按偏好隐藏，可在「我的 · 学习偏好」中开启自动显示</text>
        </view>
      </view>
        </view>
      </scroll-view>
      <text wx:if="{{!editLayout && paneOverflow.analysis}}" class="pra-scroll-hint">区域内滑动阅读</text>
    </view>
  </view>
  <view id="layout-module-tools" class="pra-module module-tools {{editLayout ? 'layout-module' : ''}} {{dragId === 'tools' ? 'layout-dragging' : ''}}" hidden="{{!editLayout && keyboardCompact}}" style="order: {{layoutRanks.tools}};" data-module="tools">
    <view class="layout-insert" wx:if="{{editLayout && dragTarget === 'tools'}}">松手放在这里</view>
    <view class="layout-drag-surface" wx:if="{{editLayout}}" data-module="tools" aria-label="拖动{{moduleLabels.tools}}调整顺序" catchtouchstart="{{layoutDrag.start}}"></view>
<view class="pra-tools">
        <view class="pra-tool" bindtap="openFeedback" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80"><text class="pra-tool-text">纠错</text></view>
        <view
          class="pra-tool {{isCurrentQuestionFavorite ? 'on' : ''}}"
          bindtap="toggleFavorite"
          hover-class="chip-flat-hover"
          hover-start-time="0"
          hover-stay-time="80"
        >
          <view class="pra-tool-icon icon-star {{isCurrentQuestionFavorite ? 'on' : ''}}"></view>
          <text class="pra-tool-text">{{favoriteSaving ? '保存中…' : '收藏'}}</text>
        </view>

        <view
          class="pra-tool"
          bindtap="openOverview"
          hover-class="chip-flat-hover"
          hover-start-time="0"
          hover-stay-time="80"
        >
          <view class="pra-tool-icon icon-grid"></view>
          <text class="pra-tool-text">答题卡</text>
        </view>

        <view
          class="pra-tool {{isCurrentQuestionMarked ? 'marked' : ''}}"
          bindtap="toggleMark"
          hover-class="chip-flat-hover"
          hover-start-time="0"
          hover-stay-time="80"
        >
          <view class="pra-tool-icon icon-pen {{isCurrentQuestionMarked ? 'on' : ''}}"></view>
          <text class="pra-tool-text">{{isCurrentQuestionMarked ? '已标记' : '标记'}}</text>
        </view>
      </view>
  </view>
</view>
<view class="pra-body-pad"></view>
