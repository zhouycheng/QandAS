<view class="pra-actions">
        <button
          class="{{currentIndex === 0 ? 'q-button--disabled' : ''}} q-button  pra-btn {{currentIndex === 0 ? 'is-disabled' : ''}}"
          bindtap="goPrev"
          hover-class="q-button-hover"
          hover-start-time="0"
          hover-stay-time="80"
         disabled="{{currentIndex === 0}}">上一题</button>
        <button
          class="q-button q-button--primary pra-btn primary {{primaryActionDisabled ? 'q-button--disabled' : ''}}"
          disabled="{{primaryActionDisabled}}"
          bindtap="goNext"
          hover-class="q-button-hover"
          hover-start-time="0"
          hover-stay-time="80"
        >{{primaryActionText}}</button>
      </view>
