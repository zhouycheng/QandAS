<view class="pra-meta reading-meta">
  <text class="pra-meta-index">{{currentNumber}}/{{total}}</text>
  <view class="pra-meta-tags"><text wx:if="{{practiceModeText}}" class="pra-meta-type">{{practiceModeText}}</text><text class="pra-meta-type">阅读理解</text></view>
  <text class="pra-meta-timer">{{isTimed ? timerText : elapsedText}}</text>
</view>
<view class="reading-workspace" motion="{{ {version: readingVersion, geometry: readingGeometry, open: readingOpen, ratio: readingRatio, keyboard: keyboardVisible, enabled: !readingSuspended && !keyboardVisible && !showQuestionOverview && !showSubmitModal && !editingLocked} }}" change:motion="{{readingDrag.sync}}">
  <scroll-view class="reading-material" scroll-y enhanced bounces="{{false}}" scroll-top="{{paneScroll.material}}" data-pane="material" bindscroll="onPaneScroll">
    <view class="pra-material"><text class="pra-side-title">阅读原文</text><rich-content text="{{currentQuestion.material.passage || ''}}" format="{{currentQuestion.material.contentFormat || 'PLAIN_TEXT'}}" /><question-images paths="{{currentQuestion.material.imagePaths || []}}" /></view>
    <view wx:if="{{!readingOpen}}" class="reading-launcher-clearance"></view>
  </scroll-view>
  <view class="reading-panel" aria-hidden="{{!readingOpen && !keyboardVisible}}">
    <view class="reading-question-heading">
      <text class="reading-question-number">小题 {{readingGroupNumber}}/{{readingGroupTotal}}</text>
      <view class="reading-handle" aria-role="button" aria-label="拖动调整选项浮层高度" catchtap="{{readingDrag.tap}}" catchtouchstart="{{readingDrag.start}}" catchtouchmove="{{readingDrag.move}}" catchtouchend="{{readingDrag.end}}" catchtouchcancel="{{readingDrag.cancel}}"><view class="reading-grip"></view></view>
      <button class="q-button q-button--text reading-close" catchtap="closeReading" aria-label="关闭选项卡" hover-class="q-button-hover">×</button>
    </view>
    <scroll-view class="reading-question" scroll-y enhanced bounces="{{false}}" scroll-top="{{readingQuestionScrollTop}}" bindscroll="onReadingQuestionScroll">
      <view class="reading-question-content"><include src="practice-stem.wxml" /><view wx:if="{{!currentQuestion.isFillBlank}}" class="pra-module reading-response"><include src="practice-response.wxml" /></view></view>
    </scroll-view>
  </view>
  <button wx:if="{{!readingOpen && !keyboardVisible}}" class="q-button reading-launcher" catchtap="openReading" aria-label="打开选项卡，已答 {{readingGroupAnsweredCount}}／{{readingGroupTotal}}" hover-class="q-button-hover">
    <view class="reading-ring-track" aria-hidden="true"></view>
    <view class="reading-ring-half ring-right" aria-hidden="true"><view class="reading-ring-value" style="transform:rotate({{readingProgressDegrees > 180 ? 180 : readingProgressDegrees}}deg);"></view></view>
    <view class="reading-ring-half ring-left" aria-hidden="true"><view class="reading-ring-value" style="transform:rotate({{readingProgressDegrees > 180 ? readingProgressDegrees - 180 : 0}}deg);"></view></view>
    <text>选项卡</text>
  </button>
</view>
<view class="reading-tools" hidden="{{keyboardVisible}}"><include src="practice-tools.wxml" /></view>
