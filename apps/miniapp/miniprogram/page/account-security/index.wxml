<view class="secondary-page">
  <page-header title="{{title}}" />
  <view class="security-page">
    <view wx:if="{{stage === 'loading'}}" class="security-status">
      <text>{{loadError || '正在读取账号信息…'}}</text>
      <button wx:if="{{loadError}}" class="q-button q-button--primary btn btn-primary" bindtap="handleRetry" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">重新读取</button>
    </view>
    <view wx:elif="{{stage === 'test-account'}}" class="security-status"><text>测试账号的登录凭据由管理员管理。</text></view>
    <block wx:else>
      <view wx:if="{{stage === 'verify' || stage === 'email'}}" wx:for="{{stage === 'verify' ? ['verify'] : ['email']}}" wx:for-item="formStage" wx:key="*this">
        <view class="field" wx:if="{{stage === 'verify'}}">
          <text class="field-label">当前邮箱</text>
          <text class="security-email">{{emailMasked}}</text>
        </view>
        <view class="field" wx:else>
          <text class="field-label">{{emailMasked ? '新邮箱' : '邮箱'}}</text>
          <input class="field-input {{errorField === 'email' ? 'field-input-error' : ''}}" type="text" placeholder="输入邮箱地址" maxlength="254" data-key="email" bindinput="handleInput" disabled="{{submitting || sending}}" />
        </view>
        <view class="field">
          <text class="field-label">邮箱验证码</text>
          <view class="code-row {{errorField === 'code' ? 'field-input-error' : ''}}">
            <input class="field-input" type="number" placeholder="6 位验证码" maxlength="6" data-key="code" bindinput="handleInput" disabled="{{submitting}}" />
            <view class="code-btn {{cooldown || sending || submitting ? 'code-btn-off' : ''}}" role="button" bindtap="handleSendCode" hover-class="text-hover" hover-start-time="0" hover-stay-time="80">{{sending ? '发送中…' : cooldown ? cooldown + 's 后重发' : '发送验证码'}}</view>
          </view>
        </view>
      </view>
      <text class="security-error" wx:if="{{errorText}}">{{errorText}}</text>
      <button class="{{submitting || sending ? 'q-button--disabled' : ''}} q-button q-button--primary btn btn-primary" bindtap="handleSubmit" loading="{{submitting}}" disabled="{{submitting || sending}}" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">{{actionLabel}}</button>
      <text wx:if="{{stage === 'email'}}" class="security-note">绑定成功后需重新登录，学习记录保留。</text>
    </block>
  </view>
</view>
