@import "../../styles/auth-form.wxss";
@import "../../styles/settings-detail.wxss";
.security-page { padding-top: var(--space-md); }
.security-page .field + .field { margin-top: var(--space-lg); }
.security-page .field-label { margin: 0 0 var(--space-sm); font-size: var(--font-body); line-height: var(--leading-body); font-weight: 400; }
.security-page .field-input { box-sizing: border-box; width: 100%; height: 44px; margin: 0; padding: 0 12px; border: 0; border-radius: var(--radius-control); font-size: var(--font-body); font-weight: 400; }
.security-page .code-row { display: flex; align-items: center; gap: var(--space-sm); min-height: 44px; margin: 0; padding: 0; border: 0; background: transparent; }
.security-page .code-row .field-input { flex: 1; width: 0; min-width: 0; }
.security-page .security-code-button { flex: none; width: 88px; padding: 8px; font-size: var(--font-secondary); }
.security-page .field-input-error { box-shadow: inset 0 0 0 1px var(--danger); }
.security-email { display: block; margin: 0; font-size: var(--font-body); line-height: var(--leading-body); font-weight: 400; color: var(--text-main); }
.security-note, .security-error, .security-status { display: block; font-size: var(--font-secondary); line-height: var(--leading-secondary); color: var(--text-sub); }
.security-note, .security-error { margin-top: var(--space-md); }
.security-error { color: var(--danger); }
.security-page .btn { margin-top: var(--space-lg); }
