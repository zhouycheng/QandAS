@import "../../styles/auth-form.wxss";
.security-page { padding: 48rpx 41rpx calc(48rpx + env(safe-area-inset-bottom)); }
.security-page .field + .field { margin-top: 36rpx; }
.security-page .field-input { padding-left: 28rpx; padding-right: 28rpx; }
.security-password-input { padding-left: 28rpx; }
.security-page .code-row { padding-right: 28rpx; }
.security-page .code-row .field-input { min-width: 0; }
.security-email { display: block; margin: 24rpx 0 42rpx; font-size: var(--font-body); font-weight: 600; color: var(--text-main); }
.security-note { display: block; margin-top: 24rpx; color: var(--text-sub); font-size: var(--font-caption); line-height: 1.6; }
.security-error { display: block; margin-top: 24rpx; color: var(--danger); font-size: var(--font-secondary); line-height: 1.5; }
.security-status { font-size: var(--font-secondary); line-height: 1.7; color: var(--text-sub); }
.security-page button.btn { width: 100%;  box-sizing: border-box; }
