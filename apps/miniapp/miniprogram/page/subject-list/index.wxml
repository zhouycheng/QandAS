<!-- 首页（原型 552:1410）
     结构：蓝色头部（品牌 + 搜索 + 公告入口）→ 白色圆角内容区（倒计时卡 + 四宫格）
     头部与内容区之间靠负 margin 咬合，内容区圆角把蓝底"切"出一道弧，不需要额外装饰图。 -->
<view class="page home-page stagger">
  <view class="hero" style="padding-top: {{homeStatusBarHeight}}px;">
    <view class="hero-navigation" style="height: {{homeNavigationBarHeight}}px;">
      <view class="hero-brand">题小搭</view>
    </view>

    <view class="hero-search">
      <view
        class="search-box"
        bindtap="handleOpenSearch"
        hover-class="search-box-hover"
        hover-start-time="0"
        hover-stay-time="80"
      >
        <input
          class="search-input"
          value="{{searchKeyword}}"
          placeholder="搜索题库、章节、题目"
          placeholder-class="search-placeholder"
          confirm-type="search"
          bindinput="handleSearchInput"
          bindconfirm="handleSearchConfirm"
          bindfocus="handleOpenSearch"
        />
        <!-- 输入框里的放大镜只做视觉，热区是整条搜索框 -->
        <view class="search-icon"></view>
      </view>

      <!-- 有可见公告时，喇叭循环轻抬招呼，标签保持固定。 -->
      <view
        class="hero-notice-btn"
        aria-role="button"
        aria-label="{{hasAnnouncements ? '查看公告' : '暂无公告'}}"
        bindtap="handleAnnouncementTap"
        hover-class="hero-notice-hover"
        hover-start-time="0"
        hover-stay-time="80"
      >
        <image class="hero-notice-icon {{hasAnnouncements ? 'hero-notice-icon-active' : ''}}" src="/assets/home/announcement-megaphone.png" mode="aspectFit"></image>
        <text class="hero-notice-label">公告</text>
      </view>
    </view>
  </view>

  <view class="sheet">
    <!-- 考试倒计时：未设置时整张卡变成「去设置」引导，不显示 0 天 -->
    <view
      class="exam-card"
      bindtap="handleExamTap"
      hover-class="exam-card-hover"
      hover-start-time="0"
      hover-stay-time="80"
    >
      <!-- 底图 + 左侧压暗层：插画只在右侧，压暗层保证左边文字始终读得清。
           底图早/中/晚三张，由 home.coverImage 按时段给（utils/home-content.js），
           三张用同一个裁剪窗口，换图时书本与时钟不会在卡片里跳位置。 -->
      <image class="exam-cover" src="{{home.coverImage}}" mode="aspectFill"></image>
      <view class="exam-veil"></view>

      <view class="exam-body">
        <view class="exam-head">
          <text class="exam-greeting">{{home.greeting}}</text>
          <text class="exam-date">{{home.dateText}}</text>
        </view>

        <view class="exam-main" wx:if="{{exam.configured}}">
          <text class="exam-name">{{exam.examName}}</text>
          <text class="exam-status" wx:if="{{exam.isPast}}">已结束 · {{exam.examDate}}</text>
          <text class="exam-status exam-status-today" wx:elif="{{exam.isExamDay}}">今天考试</text>
          <view class="exam-countdown" wx:else>
            <text class="exam-label">还有</text><text class="exam-days">{{exam.dayText}}</text><text class="exam-label">天</text>
          </view>
        </view>

        <view class="exam-main exam-main-empty" wx:else>
          <text class="exam-text">设置考试倒计时</text>
        </view>

        <view class="exam-foot">
          <!-- 每日一句在这里，不再单独占一个弹层 -->
          <text class="exam-quote">{{home.quote}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{pinnedAnnouncement}}" class="home-pinned" data-id="{{pinnedAnnouncement.id}}" bindtap="handleAnnouncementDetail" aria-role="button" aria-label="查看置顶公告：{{pinnedAnnouncement.title}}" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80"><text class="notice-pin">置顶</text><text class="home-pinned-title">{{pinnedAnnouncement.title}}</text><text>›</text></view>
    <view class="entry-grid">
      <view
        wx:for="{{entries}}"
        wx:key="key"
        class="entry"
        data-key="{{item.key}}"
        bindtap="handleEntryTap"
        hover-class="entry-hover"
        hover-start-time="0"
        hover-stay-time="80"
      >
        <view class="entry-icon entry-icon-{{item.key}}">
          <view class="entry-badge" wx:if="{{item.badge}}">{{item.badge}}</view>
        </view>
        <text class="entry-label">{{item.label}}</text>
      </view>
    </view>

    <view class="load-note" wx:if="{{overviewLoading}}">正在读取学习摘要…</view>
    <view class="load-note" wx:if="{{overviewError}}" bindtap="handleRetryLoad" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">{{overviewError}} · 点击重试</view>
    <view wx:if="{{lastPractice.resumed}}" class="home-continue" bindtap="handleContinuePractice" aria-role="button" aria-label="继续答题，{{lastPractice.title}}" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">
      <view class="continue-detail"><text class="continue-title">继续答题</text><text class="continue-subtitle">{{lastPractice.title}} · {{lastPractice.metaText}}</text></view>
      <text class="continue-arrow">›</text>
    </view>
    <view wx:else class="home-create">
      <text class="continue-title">创建新答题</text>
      <text wx:if="{{recentLoading}}" class="continue-subtitle">正在读取最近练习…</text>
      <view wx:elif="{{recentError}}" class="recent-error" bindtap="handleRecentRetry" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">{{recentError}} · 点击重试</view>
      <block wx:elif="{{recentSubjects.length}}">
        <picker mode="multiSelector" range="{{recentColumns}}" value="{{recentPickerValue}}" bindcolumnchange="handleRecentColumnChange" bindchange="handleRecentSelect" bindcancel="handleRecentCancel">
        <view class="recent-picker" aria-role="button" aria-label="选择最近练过的科目和题库" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">
          <text class="recent-picker-name">{{recentSelectedName}}</text><text class="recent-picker-arrow">⌄</text>
        </view>
        </picker>
      </block>
      <text wx:else class="continue-subtitle">{{recentHasHistory ? '最近题库暂不可用，去题库选择题目' : '还没有练习记录，去题库选择题目'}}</text>
      <button class="{{recentLoading || recentError || newPracticeLoading ? 'q-button--disabled' : ''}} q-button q-button--primary new-practice-button {{recentLoading || recentError || newPracticeLoading ? 'new-practice-disabled' : ''}}" bindtap="handleNewPractice" aria-role="button" aria-disabled="{{recentLoading || recentError || newPracticeLoading}}" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80" disabled="{{recentLoading || recentError || newPracticeLoading}}" loading="{{newPracticeLoading}}">{{newPracticeLoading ? '正在开始…' : '新答题'}}</button>
    </view>
    <community-group id="home-community" hide-unavailable="{{true}}" />

  </view>

  <!-- 搜索结果按页读取，遮罩覆盖导航栏。 -->
  <root-portal enable="{{true}}">
  <view class="portal-theme search-panel portal-theme" wx:if="{{searchVisible}}">
    <view class="search-mask" catchtouchmove="noop" catchtap="handleSearchClose"></view>

    <view class="search-panel-body">
      <view class="search-panel-head">
        <text class="search-panel-title">搜索题库、章节、题目</text>
        <text class="search-panel-close" bindtap="handleSearchClose">关闭</text>
      </view>

      <scroll-view class="search-list" scroll-y enhanced bounces show-scrollbar="{{false}}">
        <view
          wx:for="{{searchResults}}"
          wx:key="questionId"
          class="search-item"
          data-id="{{item.questionId}}"
          bindtap="handleSearchResultTap"
          hover-class="search-item-hover"
          hover-start-time="0"
          hover-stay-time="80"
        >
          <text class="search-item-stem">{{item.stem}}</text>
          <text class="search-item-meta">{{item.typeText}}<text wx:if="{{item.sourceText}}"> · {{item.sourceText}}</text></text>
        </view>

        <view wx:if="{{searchLoading}}" class="search-empty"><text>正在搜索…</text></view>
        <view wx:if="{{searchHasMore && !searchLoading}}" class="search-item" bindtap="handleSearchMore" hover-class="search-item-hover" hover-start-time="0" hover-stay-time="80"><text>加载更多</text></view>

        <view class="search-empty" wx:if="{{searchSearched && searchResultCount === 0}}">
          <text class="search-empty-title">没有找到匹配的题目</text>
          <text class="search-empty-tip">试试更短的关键词，比如题干的头两个字</text>
        </view>

        <view class="search-empty" wx:if="{{!searchSearched}}">
          <text class="search-empty-title">输入关键词开始搜索</text>
          <text class="search-empty-tip">{{searchTotalText}}</text>
        </view>
      </scroll-view>
    </view>
  </view>
  </root-portal>

  <!-- 公告与底栏共用完整遮罩，正文在居中面板内滚动。 -->
  <bottom-sheet
    visible="{{announcementSheetVisible}}"
    title="{{selectedAnnouncement ? '公告详情' : '公告'}}"
    scroll-top="{{announcementScrollTop}}"
    bind:bodyscroll="handleAnnouncementScroll"
    placement="center"
    bind:close="handleAnnouncementClose"
  >
    <view class="notice-sheet portal-theme">
      <block wx:if="{{selectedAnnouncement}}">
        <button class="q-button q-button--text" bindtap="handleAnnouncementBack" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">返回公告列表</button>
        <text class="notice-title">{{selectedAnnouncement.title}}</text>
        <rich-content class="notice-body" text="{{selectedAnnouncement.body || selectedAnnouncement.summary || ''}}" format="MARKDOWN" />
        <community-group wx:if="{{announcementSheetVisible && selectedAnnouncement.showCommunityGroup}}" inline="{{true}}" />
      </block>
      <view hidden="{{selectedAnnouncement}}">
        <view class="notice-item notice-list-row" wx:for="{{announcements}}" wx:key="id" data-id="{{item.id}}" bindtap="handleAnnouncementDetail" aria-role="button" aria-label="阅读公告：{{item.title}}" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">
          <text class="notice-title">{{item.pinned ? '置顶 · ' : ''}}{{item.title}}</text><text class="notice-summary">{{item.summary}}</text><text class="notice-date">{{item.dateText}}</text>
        </view>
        <text class="notice-empty" wx:if="{{announcementLoading}}">正在读取公告…</text>
        <text class="notice-empty" wx:elif="{{announcementError}}" bindtap="handleAnnouncementRetry">{{announcementError}} · 点击重试</text>
        <text class="notice-empty" wx:elif="{{!hasAnnouncements}}">暂无公告</text>
        <view class="load-note" wx:if="{{announcementHasMore && !announcementLoading}}" bindtap="handleAnnouncementMore" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">加载更多公告</view>
      </view>
    </view>
  </bottom-sheet>

</view>

<include src="../../templates/refresh-status.wxml" />
