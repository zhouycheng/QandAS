@import "../../styles/controls.wxss";
/* 首页（原型 552:1410）
   蓝头 + 白底圆角内容区。整页背景交给头部渐变，页面本身不留 padding，
   否则蓝色到不了屏幕边缘。 */
.home-page {
  padding: 0;
  background: var(--card);
}

/* ==================== 蓝色头部 ==================== */

/* 状态栏、品牌栏与搜索共用垂直蓝色渐变。 */
.hero {
  padding: 0 36rpx 44rpx;
  background: linear-gradient(180deg, var(--brand) 0%, var(--brand) 62%, var(--brand) 100%);
}

.hero-navigation {
  display: flex;
  align-items: center;
}

.hero-brand {
  font-size: var(--font-title);
  font-weight: 600;
  letter-spacing: 0;
  line-height: var(--leading-title);
  color: var(--card);
}

.hero-search {
  flex-wrap: wrap;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}

/* 白色搜索条：只有输入区可点，点空白处也算点输入框 */
.search-box {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  display: flex;
  align-items: center;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: var(--card);
}

.search-box-hover {
  opacity: 0.82;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  font-size: var(--font-secondary);
  color: var(--text-main);
}

/* 微信 input 的 placeholder 不吃 color，必须用类 */
.search-placeholder {
  color: var(--text-sub);
}

.search-icon {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  margin-left: 12rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjMUYyOTM3IiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS13aWR0aD0iMi4yIj48Y2lyY2xlIGN4PSIxMC42IiBjeT0iMTAuNiIgcj0iNi42Ii8+PGxpbmUgeDE9IjE1LjYiIHkxPSIxNS42IiB4Mj0iMjAuNSIgeTI9IjIwLjUiLz48L3N2Zz4=");
}

/* 透明背景喇叭直接浮在页头，标签居中固定。 */
.hero-notice-btn {
  position: relative;
  z-index: 1;
  overflow: visible;
  flex: none;
  width: 96rpx;
  height: 96rpx;
  margin-left: 16rpx;
}

.hero-notice-hover {
  opacity: 0.82;
}

.hero-notice-icon {
  position: absolute;
  z-index: 1;
  left: -6rpx;
  top: -20rpx;
  display: block;
  width: 108rpx;
  height: 108rpx;
  transform-origin: 42% 62%;
  pointer-events: none;
}

.hero-notice-label {
  position: absolute;
  z-index: 2;
  left: 50%;
  bottom: 0;
  width: 68rpx;
  height: 36rpx;
  box-sizing: border-box;
  padding: 0;
  border: 3rpx solid var(--brand);
  border-radius: var(--radius-tag);
  background: var(--warning-soft);
  color: var(--brand);
  font-size: var(--font-caption);
  font-weight: 600;
  line-height: 1.5;
  box-shadow: 0 2rpx 0 var(--warning-soft);
  text-align: center;
  white-space: nowrap;
  transform: translateX(-50%);
  pointer-events: none;
}

.hero-notice-icon-active {
  animation: notice-call 3.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}

/* 招呼后停稳半个周期，回弹幅度逐次收小。 */
@keyframes notice-call {
  0%, 8%, 50%, 100% { transform: translateY(0) rotate(0deg) scale(1); }
  14% { transform: translateY(1rpx) rotate(-3deg) scale(0.98); }
  24% { transform: translateY(-5rpx) rotate(6deg) scale(1.04); }
  33% { transform: translateY(-2rpx) rotate(-2.5deg) scale(1.01); }
  41% { transform: translateY(-1rpx) rotate(1deg) scale(1); }
}

/* ==================== 白色内容区 ==================== */

/* 负 margin 让白圆角压住蓝底，形成原型里那道弧。
   底部 272rpx = tabbar 232 + 40 呼吸位，再叠加安全区。 */
.sheet {
  margin-top: -28rpx;
  padding: 36rpx 32rpx 272rpx;
  padding-bottom: calc(272rpx + env(safe-area-inset-bottom));
  border-radius: var(--radius-overlay) var(--radius-overlay) 0 0;
  background: var(--card);
}

/* ==================== 考试倒计时 ==================== */

/**
 * ⚠️ 高度写死，不用 min-height。
 *
 * 封面图是按 686:320 裁的，两者比例必须完全一致，否则 aspectFill 会裁掉边：
 * 之前高度随内容浮动，卡片比图「矮」时左右各被切掉一截，右边缘的时钟被切掉半个。
 * 改这里的 height，必须同步改 assets/home/exam-cover.jpg 的裁剪比例
 * （scripts/prepare-exam-cover.py 的 CARD_RATIO），tests/home-prototype.check.js 会比对。
 */
.exam-card {
  position: relative;
  overflow: hidden;
  height: 320rpx;
  padding: 30rpx 32rpx 28rpx;
  border-radius: var(--radius-card);
  /* 图片加载前的兜底底色，取封面图自身的深蓝，避免闪一下亮蓝 */
  background: linear-gradient(150deg, var(--brand) 0%, var(--brand) 55%, var(--brand) 100%);

}

/* 封面图铺满整卡（插画只占右侧，左侧本身就是纯色，靠压暗层统一） */
.exam-cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/**
 * 压暗层：这是满幅底图上放白字的唯一原因。
 *
 * 早期底图是「左侧留空、插画在右」的矢量图，所以只做了一道从左到右的横向渐变。
 * 现在的底图是三张**满幅写实插画**（书房/图书馆/夜景），左半屏也有内容：
 *  - 横向量降到 .70 起步，让画面透出来，不再糊成一块死蓝；
 *  - 但只靠横向压不住底部那行金句和「修改」，所以补一道**自下而上**的纵向压暗，
 *    底边 .62 起、44% 处收干净——正好盖住金句行，中间的画面细节不受影响。
 * 字始终压在这两层之上，任何一张底图都不会读出「白字浮在亮处」。
 */
.exam-veil {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background:
    linear-gradient(90deg, rgba(17, 31, 82, 0.70) 0%, rgba(17, 31, 82, 0.56) 30%, rgba(17, 31, 82, 0.30) 58%, rgba(17, 31, 82, 0.10) 80%, rgba(17, 31, 82, 0) 100%),
    linear-gradient(0deg, rgba(11, 20, 56, 0.74) 0%, rgba(11, 20, 56, 0.46) 26%, rgba(11, 20, 56, 0.14) 42%, rgba(11, 20, 56, 0) 56%);
}

/* 内容层压在封面图与压暗层之上。
   纵向三等分撑满：问候语贴顶、倒计时居中、金句贴底，高度固定时上下不会留一块空。 */
.exam-body {
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* 卡片本身是大色块，按压只改不透明度：
   改背景会盖掉插画，加 transform 会让整块卡位移 */
.exam-card-hover {
  opacity: 0.9;
}

.exam-head {
  display: flex;
  align-items: baseline;
}

.exam-greeting {
  font-size: var(--font-display);
  font-weight: 600;
  color: var(--card);
}

.exam-date {
  margin-left: 14rpx;
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.78);
}

/* 左对齐（不再居中）：插画占右侧约三分之一，居中的倒计时会压到书本和时钟上。
   纵向间距由 .exam-body 的 space-between 负责，这里不再写 margin-top。 */
.exam-main {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 4rpx;
  min-width: 0;
}

.exam-main-empty {
  /* 未设置时只有一行字，靠 space-between 会被拉到正中，这里让它回到偏上的位置 */
  margin-top: -40rpx;
}

.exam-text, .exam-name {
  font-size: var(--font-body);
  font-weight: 500;
  line-height: var(--leading-body);
  color: var(--card);
}
.exam-name { max-width: 100%; overflow-wrap: anywhere; }
.exam-countdown { display: flex; align-items: baseline; gap: 8rpx; }
.exam-label, .exam-status { color: rgba(255, 255, 255, .86); font-size: var(--font-secondary); line-height: var(--leading-secondary); }
.exam-status-today { color: var(--card); font-size: var(--font-title); font-weight: 500; line-height: var(--leading-title); }

.exam-days {
  font-size: var(--font-metric);
  font-weight: 600;
  line-height: var(--leading-metric);
  color: var(--card);
  font-variant-numeric: tabular-nums;
}

.exam-foot {
  display: flex;
  align-items: flex-end;
}

/* 每日一句：压两行截断，避免长句把卡片撑高、把插画挤到看不见 */
.exam-quote {
  flex: 1;
  min-width: 0;
  font-size: var(--font-caption);
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.86);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ==================== 我的学习空间 ==================== */

/* 四宫格：一个 flex 行 + flex:1 等分（不用 flex-wrap + calc，避免小数像素塌成一行一个） */
.entry-grid {
  margin-top: 40rpx;
  padding: 30rpx 10rpx 26rpx;
  display: flex;
  border-radius: var(--radius-card);
  background: var(--brand-soft);
}

.entry {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: var(--radius-card);
}

.entry-hover {
  opacity: 0.86;
}

/* ===== 四宫格图标 =====
   四个入口各一种颜色（橙 / 绿 / 红 / 蓝），之前全是橙色、只靠形状区分，
   用户反馈「配色风格太统一了，不容易识别」。
   整块（圆角方块 + 渐变 + 白色字形）都由一张 SVG 画好，这里只管尺寸和投影，
   免得再用 ::after 叠一层、两套颜色还要手动对齐。 */
.entry-icon {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-card);
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

/* 投影取各自的主色，压在同色背景上也看得出层次 */
.entry-icon-recent {
  background-image: url("data:image/svg+xml;base64,");

}

.entry-icon-mock {
  background-image: url("data:image/svg+xml;base64,");

}

.entry-icon-wrong {
  background-image: url("data:image/svg+xml;base64,");

}

.entry-icon-favorite {
  background-image: url("data:image/svg+xml;base64,");

}

/* 计数徽标压在图标右上角 */
.entry-badge {
  position: absolute;
  top: -10rpx;
  right: -14rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 9rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--danger);
  border: 3rpx solid var(--card);
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--card);
}

.entry-label {
  margin-top: 16rpx;
  font-size: var(--font-secondary);
  color: var(--text-main);
}

/* ==================== 搜索结果面板 ==================== */

.search-panel {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
}

.search-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 36, 0.35);
}

/* 面板从顶部弹出：搜索框在头部，结果贴着它出现比从底部滑上来更自然 */
.search-panel-body {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 300rpx;
  max-height: 62vh;
  display: flex;
  flex-direction: column;
  border-radius: var(--radius-card);
  background: var(--card);
  box-shadow: 0 20rpx 50rpx rgba(15, 23, 36, 0.2);
  overflow: hidden;
}

.search-panel-head {
  flex: none;
  padding: 26rpx 28rpx 18rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid var(--line);
}

.search-panel-title {
  flex: 1;
  min-width: 0;
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-main);
}

.search-panel-close {
  flex: none;
  padding: 8rpx 4rpx 8rpx 20rpx;
  font-size: var(--font-secondary);
  color: var(--brand);
}

.search-list {
  flex: 1;
  min-height: 200rpx;
  max-height: 52vh;
}

.search-item {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.search-item-hover {
  opacity: 0.86;
}

.search-item-stem {
  display: block;
  font-size: var(--font-body);
  line-height: 1.55;
  color: var(--text-main);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.search-item-meta {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-caption);
  color: var(--text-muted);
}

.search-empty {
  padding: 80rpx 40rpx;
  text-align: center;
}

.search-empty-title {
  display: block;
  font-size: var(--font-secondary);
  color: var(--text-sub);
}

.search-empty-tip {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-caption);
  color: var(--text-muted);
}

/* ==================== 公告弹层 ==================== */

.notice-sheet {
  padding: 0 4rpx 8rpx;
}

/* 弹窗顶部的喇叭徽标：与入口同一个图形，让「点的是它、弹出来的是它」对得上 */
.notice-badge {
  width: 96rpx;
  height: 96rpx;
  margin: 8rpx auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--brand-soft);
}

.notice-badge-icon {
  display: block;
  width: 80rpx;
  height: 80rpx;
}

.notice-item + .notice-item {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--line);
}

.notice-empty {
  display: block;
  text-align: center;
  color: var(--text-muted);
  font-size: var(--font-secondary);
}

.notice-title {
  display: block;
  font-size: var(--font-body);
  font-weight: 600;
  line-height: 1.55;
  text-align: center;
  color: var(--text-main);
}

.notice-body {
  display: block;
  margin-top: 20rpx;
  font-size: var(--font-secondary);
  line-height: 1.8;
  color: var(--text-sub);
  white-space: pre-wrap;
}
.home-continue { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; padding: 24rpx; border: 2rpx solid var(--page-bg); border-radius: var(--radius-card); background: var(--card); }
.continue-detail { flex: 1; min-width: 0; }
.continue-title { display: block; color: var(--text-main); font-size: var(--font-body); font-weight: 600; }
.continue-subtitle { display: block; margin-top: 8rpx; color: var(--text-sub); font-size: var(--font-caption); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.continue-arrow { margin-left: 16rpx; color: var(--text-sub); font-size: var(--font-title); }
.home-create { margin-top: 24rpx; padding: 24rpx; border: 2rpx solid var(--page-bg); border-radius: var(--radius-card); background: var(--card); }
.recent-picker { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding: 18rpx 20rpx; border-radius: var(--radius-tag); background: var(--page-bg); }
.recent-picker-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--font-secondary); color: var(--text-main); }
.recent-picker-arrow { margin-left: 16rpx; font-size: var(--font-secondary); color: var(--text-sub); }
.recent-error { margin-top: 12rpx; color: var(--danger); font-size: var(--font-caption); }
.new-practice-button { margin-top: 20rpx;        }
.new-practice-disabled { opacity: .5; }

.hero { background: var(--brand); }
.home-new-practice { min-width: 0; }
.new-practice-button { width: 100%; }
.exam-head { flex-wrap: wrap; row-gap: 4px; }

.new-practice-button { margin-top: var(--space-md); }
