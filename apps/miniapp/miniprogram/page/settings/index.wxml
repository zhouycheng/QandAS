<view class="secondary-page">
<page-header title="答题偏好" />
<view class="page settings-page settings-detail">
  <view class="menu-row settings-row" bindtap="handlePresets" aria-role="button" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80"><view class="menu-main"><text class="menu-title settings-label">默认答题配置</text><text class="menu-desc settings-note">{{presetSummary}}</text></view><image class="menu-arrow" src="/assets/icons/arco-down.svg" mode="aspectFit" aria-hidden="true" /></view>
  <view class="menu settings-group">
    <block wx:for="{{switches}}" wx:key="key">
    <view wx:if="{{item.heading}}" class="settings-section-head"><text class="settings-section-title">{{item.heading}}</text><text wx:if="{{item.note}}" class="settings-note">{{item.note}}</text></view>
    <view class="menu-row settings-row {{item.disabled ? 'settings-row-disabled' : ''}}">
      <view class="menu-main"><text class="menu-title settings-label">{{item.label}}</text><text wx:if="{{item.description}}" class="menu-desc settings-note">{{item.description}}</text></view>
      <switch class="menu-switch" checked="{{item.value}}" disabled="{{item.disabled}}" color="#2563EB" data-key="{{item.key}}" aria-label="{{item.label}}" aria-disabled="{{item.disabled}}" bindchange="handleSwitchChange" />
    </view>
    </block>
  </view>
  <view class="menu settings-group">
    <view class="settings-section-head"><text class="settings-section-title">题目显示</text></view>
    <view class="font-setting">
      <view class="font-heading"><text class="settings-label">题目文字大小</text><text class="font-current" aria-live="polite">{{fontLabel}}</text></view>
      <text class="settings-note">影响题干、选项、答案与解析</text>
      <slider class="font-slider" min="0" max="4" step="1" value="{{fontIndex}}" block-size="24" activeColor="#2563EB" backgroundColor="#E5E7EB" block-color="#2563EB" bindchanging="handleFontChanging" bindchange="handleFontChange" aria-label="题目文字大小，当前{{fontLabel}}" />
      <view class="font-stops">
        <button wx:for="{{fontOptions}}" wx:key="value" class="q-button font-stop {{fontIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="handleFontTap" aria-label="{{item.label}}字号" aria-pressed="{{fontIndex === index}}" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80"><view class="font-tick" aria-hidden="true" /><text>{{item.label}}</text></button>
      </view>
      <view class="font-preview">
        <text class="font-preview-label">预览</text>
        <scroll-view class="font-preview-scroll font-{{fontSize}}" scroll-y>
          <text class="font-preview-text">{{fontPreviewText}}</text>
          <text class="font-preview-text font-preview-option">A. 风能</text>
        </scroll-view>
      </view>
    </view>
  </view>
  <view class="settings-actions"><button class="q-button q-button--text section-reset" bindtap="handleResetPreferences" aria-role="button" aria-label="恢复默认答题偏好" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">恢复默认</button></view>
</view>
</view>
