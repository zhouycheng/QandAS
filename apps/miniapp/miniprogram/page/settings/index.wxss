@import "../../styles/settings-detail.wxss";
.settings-scroll {
  height: 100vh;
}

.settings-page {
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.section {
  margin-top: 12rpx;
}

.section + .section {
  margin-top: 40rpx;
}

.settings-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: auto;
  padding-top: 32rpx;
}

.section-note {
  font-size: var(--font-caption);
  color: var(--text-muted);
}

/* ==================== 菜单通用 ==================== */
.menu { padding: 0; }

.settings-page .menu-row {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  min-height: 0;
  padding: 14px 0;
}

.menu-main {
  flex: 1;
  min-width: 0;
}

.menu-title {
  display: block;
  font-size: var(--font-body);
  color: var(--text-main);

  font-weight: 400;
}

.menu-desc {
  display: block;
  font-size: var(--font-secondary);
  line-height: 1.5;
  color: var(--text-muted);
}

.menu-value {
  flex: none;
  margin-left: 16rpx;
  font-size: var(--font-secondary);
  color: var(--text-muted);
}

.menu-arrow {
  flex: none;
  width: 18px;
  height: 18px;
  transform: rotate(-90deg);
}

.menu-tag {
  flex: none;
  margin-left: 14rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--page-bg);
  font-size: var(--font-caption);
  color: var(--text-muted);
}

.menu-switch {
  flex: none;
  margin: 0;
  transform: scale(0.86);
  transform-origin: center right;
}

/* ==================== 选择型偏好 ==================== */
.choice-card {
  margin-top: 20rpx;
}

.choice-row {
  padding: var(--space-md) 0;
}

.choice-row + .choice-row {
  border-top: 1rpx solid var(--line);
}

.choice-head {
  display: flex;
  align-items: center;
}

.choice-badge {
  margin-left: 14rpx;
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  background: var(--warning-soft);
  font-size: var(--font-caption);
  color: var(--warning);
}

.choice-options {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  margin-right: -14rpx;
}

.choice-chip {
  margin: 0 14rpx 0 0;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--page-bg);
  font-size: var(--font-secondary);
  color: var(--text-sub);
  border: 2rpx solid transparent;
}

.choice-chip.active {
  color: var(--brand);
  font-weight: 600;
  background: var(--brand-soft);
  border-color: var(--brand);
}

/* 未开放的选择：视觉上明确降级，点了只给说明 */
.choice-chip.disabled {
  color: var(--text-muted);
  background: var(--page-bg);
}

.choice-chip.disabled.active {
  color: var(--text-muted);
  font-weight: 400;
  background: var(--page-bg);
  border-color: var(--line);
}

/* The preview inherits the same reading scale as practice content. */
.font-preview {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--radius-tag);
  background: var(--brand-soft);
  border: 1rpx dashed var(--line);
}

.font-preview-text {
  display: block;
  font-size: var(--reading-size, var(--reading-normal));
  line-height: 1.65;
  color: var(--text-sub);
}

/* ==================== 考试倒计时 ==================== */
.exam-row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.exam-label {
  flex: none;
  width: 160rpx;
  font-size: var(--font-secondary);
  color: var(--text-main);
}

.exam-input {
  flex: 1;
  height: 48rpx;
  font-size: var(--font-body);
  color: var(--text-main);
  text-align: right;
}

.exam-placeholder {
  color: var(--text-muted);
  font-size: var(--font-secondary);
}

.exam-value-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.exam-value {
  font-size: var(--font-body);
  color: var(--text-main);
}

.exam-value-empty {
  color: var(--text-muted);
}

.exam-status {
  display: flex;
  align-items: baseline;
  padding: 24rpx 0 6rpx;
}

.exam-status-text {
  font-size: var(--font-caption);
  color: var(--text-sub);
}

.exam-status-days {
  margin: 0 8rpx 0 12rpx;
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--brand);
}

.exam-status-unit {
  font-size: var(--font-caption);
  color: var(--text-sub);
}

.exam-status-idle {
  display: block;
  padding: 22rpx 0 6rpx;
}

.exam-status-idle .exam-status-text {
  font-size: var(--font-caption);
  color: var(--text-muted);
}

/* ==================== 账户与安全 ==================== */
.account-identity {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  padding: 24rpx 26rpx;
  border-radius: var(--radius-card);
  background: var(--card);
  box-shadow: 0 6rpx 24rpx rgba(31, 42, 55, 0.06);
}

.account-avatar {
  flex: none;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  overflow: hidden;
}

.account-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-soft);
}

.account-avatar-fallback .mi-icon {
  width: 46rpx;
  height: 46rpx;
  opacity: 0.6;
}

.account-identity-main {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.account-name {
  display: block;
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-main);
}

.account-provider {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-caption);
  color: var(--text-muted);
}

.account-hint {
  margin-bottom: 18rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-card);
  background: var(--brand-soft);
  border: 2rpx solid var(--brand-soft);
  font-size: var(--font-caption);
  line-height: 1.65;
  color: var(--text-sub);
}

/* ==================== 关于 ==================== */
.about-row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
}

.about-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-top: 1rpx solid var(--line);
}

.about-label {
  font-size: var(--font-secondary);
  color: var(--text-sub);
}

.about-value {
  flex: none;
  margin-left: 20rpx;
  font-size: var(--font-secondary);
  color: var(--text-muted);
}

.footer-note {
  margin-top: 36rpx;
  text-align: center;
  font-size: var(--font-caption);
  line-height: 1.6;
  color: var(--text-muted);
}

.settings-page > .menu { flex: none; }
.settings-page .menu-main { margin-left: 0; }
