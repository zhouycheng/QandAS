@import "../../styles/list-page.wxss";
page { background: var(--card); }

/* 复盘页（设计稿「复盘」画板，402x874，系数 750/402 ≈ 1.8657）
   页边距来自 styles/list-page.wxss，这里维护卡片与图表。
   换算：22px 页边距 → 41rpx；14px 卡内边距 → 26rpx；12px 圆角 → 22rpx；
        34px 分段高 → 63rpx；24px 指标数字 → 45rpx。

   页面白底与其他 Tab 一致，图表使用描边卡片。 */

.review-page {
  background: var(--card);
  padding-bottom: 272rpx;
  padding-bottom: calc(272rpx + env(safe-area-inset-bottom));
}

.review-page .page-head {
  flex: none;
  background: transparent;
}

.review-stage { position: relative; margin: 0 -41rpx; }
.review-content { padding: 0 41rpx; }
.review-page-locked { position: relative; height: 100vh; display: flex; flex-direction: column; overflow: hidden; padding-bottom: 0; }
.review-page-locked .review-stage { flex: 1; min-height: 0; overflow: hidden; }
.review-page-locked .page-head,
.review-content.is-locked { filter: blur(10rpx); pointer-events: none; user-select: none; }
.review-content.is-locked { height: 100%; box-sizing: border-box; overflow: hidden; }
.review-access { position: absolute; inset: 0; z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(31, 42, 55, .16); text-align: center; padding: 32rpx 32rpx 272rpx; padding-bottom: calc(272rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.review-lock { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; border-radius: 50%; background: var(--brand-soft); }
.review-lock .mi-icon { width: 60rpx; height: 60rpx; }
.review-access-title { margin-top: 28rpx; font-size: var(--font-body); font-weight: 600; color: var(--text-main); }
.review-access-desc { margin-top: var(--space-sm); font-size: var(--font-secondary); color: var(--text-sub); line-height: var(--leading-secondary); }
.review-login { align-self: stretch; margin-top: var(--space-md); }

.page-head-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* ---------- 区间切换 ---------- */

.segmented {
  display: flex;
  align-items: center;
  min-height: 44px;
  margin-top: var(--space-lg);
  padding: 6rpx;
  box-sizing: border-box;
  border-radius: var(--radius-card);
  background: var(--brand-soft);
}

.seg {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  min-height: 36px;
  border-radius: var(--radius-tag);
  font-size: var(--font-secondary);
  line-height: var(--leading-secondary);
  font-weight: 500;
  color: var(--text-sub);
  text-align: center;
  transition: background-color 0.16s ease, color 0.16s ease, opacity 100ms ease;
}

.seg-hover {
  opacity: 0.86;
}

/* 选中态：蓝色胶囊 + 白字。蓝底白字对比度足够，不要再叠透明度 */
.seg-active {
  background: var(--brand);
  color: var(--card);
  font-weight: 600;
}

/* ---------- 三个指标 ---------- */

.metric-row {
  display: flex;
  align-items: flex-start;
  margin-top: var(--space-lg);
  padding-bottom: 14rpx;
}

.metric {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.metric-label {
  display: block;
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  font-weight: 500;
  color: var(--text-sub);
}

.metric-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-top: 2rpx;
}

.metric-num {
  font-size: var(--font-display);
  line-height: var(--leading-display);
  font-weight: 600;
  color: var(--text-main);
}

.metric-unit {
  margin-left: 3rpx;
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  font-weight: 600;
  color: var(--text-main);
}

/* ---------- 错题本 / 收藏本入口卡 ---------- */

.entry-row {
  display: flex;
  margin-top: 26rpx;
}

.entry-card {
  flex: 1;
  min-width: 0;
  padding: 22rpx 22rpx 24rpx;
  box-sizing: border-box;
  border-radius: var(--radius-card);
  transition: opacity 0.1s ease;
}

/* 两张卡一左一右，右边固定 margin-left 而不是 gap —— WXSS 的 gap 在旧机型上不生效 */
.entry-card + .entry-card {
  margin-left: 24rpx;
}

.entry-card-hover {
  opacity: 0.86;
}

.entry-wrong {
  background: var(--danger-soft);
}

.entry-favorite {
  background: var(--brand-soft);
}

.entry-head {
  display: flex;
  align-items: center;
}

.entry-icon {
  flex: none;
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

.entry-icon-wrong {
  background-image: url("data:image/svg+xml;base64,");
}

.entry-icon-favorite {
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlLXdpZHRoPSIxLjciIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCI+PHBhdGggZD0iTTYuNiAzLjZoMTAuOHYxNi44TDEyIDE1LjlsLTUuNCA0LjV6IiBzdHJva2U9IiMyNTYzRUIiLz48L3N2Zz4=");
}

.entry-title {
  font-size: var(--font-body);
  line-height: var(--leading-body);
  font-weight: 600;
  color: var(--text-sub);
}

.entry-value {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.entry-num {
  font-size: var(--font-title);
  line-height: var(--leading-title);
  font-weight: 600;
  color: var(--text-main);
}

.entry-unit {
  margin-left: 4rpx;
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  font-weight: 600;
  color: var(--text-main);
}

.entry-caption {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-secondary);
  line-height: var(--leading-secondary);
  font-weight: 500;
  color: var(--text-sub);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 图表容器 ---------- */

.block {
  margin-top: var(--space-lg);
  padding: var(--space-md);
  border: 1px solid var(--line);
  border-radius: var(--radius-card);
  background: var(--card);
}

.block-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.block-title {
  font-size: var(--font-body);
  line-height: var(--leading-body);
  font-weight: 600;
  color: var(--text-main);
}

.block-caption {
  margin-left: auto;
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  font-weight: 500;
  color: var(--text-sub);
}

/* 两张图都按宽度铺满：SVG 的 viewBox 比例固定，宽度交给容器 */
.heatmap {
  display: block;
  width: 100%;
}

/* 图形保持原始比例，原生日期标签位于图形下方。 */
.trend-chart {
  display: block;
  width: 100%;
}
.chart-axis { position: relative; height: var(--leading-caption); margin-top: var(--space-xs); color: var(--text-sub); font-size: var(--font-caption); line-height: var(--leading-caption); }
.chart-axis-label { position: absolute; top: 0; white-space: nowrap; }
.chart-axis-center { transform: translateX(-50%); }
.chart-axis-end { transform: translateX(-100%); }

/* ---------- 热力图图例 ---------- */

.legend-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.legend-text {
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  color: var(--text-sub);
}

.legend-cell {
  width: 22rpx;
  height: 22rpx;
  margin: 0 4rpx;
  border-radius: 5rpx;
}

.legend-cell.lv-0 {
  background: var(--line);
}

.legend-cell.lv-1 {
  background: #DBEAFE;
}

.legend-cell.lv-2 {
  background: #93C5FD;
}

.legend-cell.lv-3 {
  background: #60A5FA;
}

.legend-cell.lv-4 {
  background: var(--brand);
}

/* ---------- 空态 ---------- */

.chart-empty {
  padding: var(--space-lg) 0;
  font-size: var(--font-secondary);
  line-height: var(--leading-secondary);
  color: var(--text-sub);
  text-align: center;
}
