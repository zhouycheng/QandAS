<view class="secondary-page">
  <page-header title="关于 QandA" />
  <view class="about-page">
    <view class="about-brand">
      <text class="about-name">QandA</text>
      <text class="about-description">课程复习与题库练习</text>
      <text class="about-version" bindtap="handleVersionTap" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">版本 {{version || '—'}}</text>
    </view>
    <view class="about-section" wx:if="{{developers.length}}">
      <text class="about-heading">开发团队</text>
      <view class="team-grid">
        <view class="team-member" wx:for="{{developers}}" wx:key="username" data-username="{{item.username}}" bindtap="handleDeveloperTap" aria-role="button" aria-label="复制 {{item.username}} 的 GitHub 主页地址" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">
          <image class="team-avatar" src="{{item.avatar}}" mode="aspectFill" />
        </view>
      </view>
    </view>
    <view class="about-section">
      <text class="about-heading">关于这个应用</text>
      <text class="about-paragraph" wx:for="{{paragraphs}}" wx:key="*this">{{item}}</text>
    </view>
    <community-group />
    <view class="donation-grid" wx:if="{{donationCodes.length}}">
      <view class="donation-card" wx:for="{{donationCodes}}" wx:key="image" data-index="{{index}}" bindtap="handleDonationTap" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">
        <image class="donation-code" src="{{item.image}}" mode="widthFix" show-menu-by-longpress="{{true}}" /><text class="donation-label">{{item.label}}</text>
      </view>
    </view>
    <view wx:if="{{playgroundEnabled}}" class="about-row" bindtap="handlePlaygroundTap" hover-class="row-hover" hover-start-time="0" hover-stay-time="80">
      <text>开发者 Playground</text><view class="chevron"></view>
    </view>
  </view>
</view>
