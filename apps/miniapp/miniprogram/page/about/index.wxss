@import "../../styles/settings-detail.wxss";
page { background: var(--card); }
.about-brand { display: flex; flex-direction: column; align-items: center; gap: 4rpx; padding: var(--space-sm) 0 var(--space-md); }
.about-name { color: var(--brand); font-size: var(--font-display); line-height: 1.4; font-weight: 600; }
.about-description { margin: 0; font-size: var(--font-secondary); line-height: var(--leading-secondary); color: var(--text-sub); }
.about-version { margin: 0; font-size: var(--font-secondary); line-height: var(--leading-secondary); color: var(--text-sub); }
.about-row { display: flex; align-items: center; justify-content: space-between; min-height: 101rpx; border-bottom: 2rpx solid var(--page-bg); color: var(--text-main); font-size: var(--font-secondary); }
.about-section { padding: var(--space-md) 0; }
.about-heading { display: block; margin-bottom: var(--space-md); color: var(--text-main); font-size: var(--font-body); font-weight: 400; }
.about-paragraph { display: block; margin-bottom: var(--space-md); color: var(--text-sub); font-size: var(--font-secondary); line-height: 1.65; }
.about-paragraph:last-child { margin-bottom: 0; }
.team-grid { display: flex; gap: 16rpx; }
.team-member { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; padding: 12rpx 0; }
.team-avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: var(--page-bg); }
.donation-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-md); margin-top: var(--space-md); }
.donation-card { flex: 1 1 260rpx; max-width: 320rpx; padding: var(--space-md); border: 1rpx solid var(--line); border-radius: var(--radius-control); box-sizing: border-box; }
.donation-code { display: block; width: 100%; }
.donation-label { display: block; margin-top: 16rpx; color: var(--text-sub); font-size: var(--font-secondary); line-height: 1.5; text-align: center; }
