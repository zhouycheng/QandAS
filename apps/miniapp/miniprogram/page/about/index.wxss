@import "../../styles/list-page.wxss";
page { background: #fff; }
.about-page { padding: 0 41rpx calc(40rpx + env(safe-area-inset-bottom)); }
.about-brand { display: flex; flex-direction: column; align-items: center; padding: 48rpx 0 40rpx; }
.about-name { color: #466bff; font-size: 64rpx; line-height: 1.4; font-weight: 700; }
.about-description { margin-top: 16rpx; font-size: 26rpx; color: #8b8f99; }
.about-version { padding: 24rpx; font-size: 24rpx; color: #8b8f99; }
.about-row { display: flex; align-items: center; justify-content: space-between; min-height: 101rpx; border-bottom: 2rpx solid #eef0f5; color: #141820; font-size: 28rpx; }
.about-section { margin-bottom: 44rpx; }
.about-heading { display: block; margin-bottom: 24rpx; color: #141820; font-size: 32rpx; font-weight: 600; }
.about-paragraph { display: block; margin-bottom: 24rpx; color: #566171; font-size: 28rpx; line-height: 1.9; }
.team-grid { display: flex; gap: 16rpx; }
.team-member { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; padding: 12rpx 0; }
.team-avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: #f6f8fb; }
.donation-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 28rpx; margin-bottom: 40rpx; }
.donation-card { width: 280rpx; padding: 20rpx; border: 2rpx solid #eef0f5; border-radius: 20rpx; box-sizing: border-box; }
.donation-code { display: block; width: 100%; }
.donation-label { display: block; margin-top: 16rpx; color: #566171; font-size: 25rpx; line-height: 1.5; text-align: center; }
