@import "../../styles/loading-skeleton.wxss";
@import "../../styles/config-icon.wxss";
@import "../../styles/controls.wxss";
/* 两栏背景铺满视口；滚动内容末尾为悬浮底栏留出可滚动空间。 */
page { background: var(--card); }
.bk-navigation { display: flex; align-items: center; padding-left: 4rpx; padding-right: 210rpx; }
.bank-detail-page {
  box-sizing: border-box;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--card);
}

/* ---------- 页内标题 + 搜索 + 筛选 ---------- */
.bk-head {
  flex: none;
  padding: 0 var(--space-lg) var(--space-md);
  background: var(--card);
}

.catalog-content {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.catalog-status {
  position: absolute;
  z-index: 1;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-bottom: 272rpx;
  padding-bottom: calc(272rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.catalog-status-note {
  border-radius: var(--radius-tag);
  background: var(--card);
  pointer-events: auto;
}

.catalog-empty {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 26rpx 272rpx;
  padding-bottom: calc(272rpx + env(safe-area-inset-bottom));
  color: var(--text-sub);
  font-size: var(--font-secondary);
  line-height: var(--leading-secondary);
  text-align: center;
}

.bank-group-title { display: block; margin: 28rpx 4rpx 16rpx; color: var(--text-sub); font-size: var(--font-body); font-weight: 600; line-height: var(--leading-body); }

.bk-title {
  font-size: var(--font-title);
  line-height: var(--leading-title);
  font-weight: 600;
  color: var(--text-main);
  letter-spacing: 0;
}

.bk-tools {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
}

.catalog-filters { display: flex; gap: 12rpx; margin-top: 16rpx; }
.catalog-picker { flex: 1; min-width: 0; }
.filter-select { position: relative; box-sizing: border-box; padding: 14rpx 32rpx 14rpx 16rpx; border-radius: var(--radius-tag); background: var(--page-bg); color: var(--text-sub); font-size: var(--font-secondary); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.filter-select::after { content: '▾'; position: absolute; right: 12rpx; }

.bk-search {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  background: var(--page-bg);
}

.bk-search-icon {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  /* 图标 base64 内联：微信不支持本地 .svg 的 background-image（见 AGENTS.md） */
  background-image: url("data:image/svg+xml;base64,");
}

.bk-search-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  margin-left: 14rpx;
  font-size: var(--font-secondary);
  color: var(--text-main);
}

.bk-search-ph {
  font-size: var(--font-secondary);
  color: var(--text-sub);
}

.bk-search-clear {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  line-height: var(--leading-body);
  text-align: center;
  font-size: var(--font-body);
  color: var(--text-sub);
}

.bk-filter {
  flex: none;
  width: 68rpx;
  height: 68rpx;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--page-bg);
  transition: background-color 120ms ease;
}

.bk-filter-icon {
  width: 30rpx;
  height: 30rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjNjY3MDg1IiBzdHJva2Utd2lkdGg9IjEuOSIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48cGF0aCBkPSJNMyA0aDE4bC03IDh2N2wtNCAydi05TDMgNHoiLz48L3N2Zz4=");
}

.bk-filter.is-on {
  background: var(--brand);
}

.bk-filter.is-on .bk-filter-icon {
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjRkZGRkZGIiBzdHJva2Utd2lkdGg9IjEuOSIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48cGF0aCBkPSJNMyA0aDE4bC03IDh2N2wtNCAydi05TDMgNHoiLz48L3N2Zz4=");
}

.bk-filter.is-off {
  opacity: 0.45;
}

/* 只有 icon 的圆形按钮：按压只压透明度，避免整块位移 */
.bk-icon-hover {
  opacity: 0.72;
}

.bk-filter.is-off.bk-icon-hover { opacity: 0.45; }

/* ---------- 左栏 + 右栏 ---------- */
.workbench {
  height: 100%;
  flex: 1;
  min-height: 0;
  display: flex;
}

.rail {
  flex: none;
  width: 176rpx;
  height: 100%;
  background: var(--page-bg);
}

.rail-inner {
  padding: 12rpx 0 272rpx;
  padding-bottom: calc(272rpx + env(safe-area-inset-bottom));
}

.rail-item {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  margin: 0 8rpx;
  padding-right: 10rpx;
  border-radius: var(--radius-tag);
}

.rail-bar {
  flex: none;
  width: 6rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: transparent;
}

.rail-body {
  flex: 1;
  min-width: 0;
  padding-left: 10rpx;
  display: flex;
  align-items: center;
}

.rail-name {
  font-size: var(--font-secondary);
  line-height: var(--leading-secondary);
  color: var(--text-sub);
}

.rail-count {
  margin-left: 8rpx;
  font-size: var(--font-caption);
  color: var(--text-sub);
}

.rail-item.is-active {
  background: var(--brand-soft);
}

.rail-item.is-active .rail-bar {
  background: var(--brand);
}

.rail-item.is-active .rail-name {
  font-weight: 600;
  color: var(--brand);
}

.rail-tool .rail-name {
  color: var(--brand);
}

.rail-item-hover {
  opacity: 0.72;
}

.panel {
  flex: 1;
  min-width: 0;
  height: 100%;
  background: var(--card);
}

.panel-inner {
  padding: 24rpx 24rpx 272rpx;
  padding-bottom: calc(272rpx + env(safe-area-inset-bottom));
}

/* ---------- 统计卡 ---------- */
.stat-card {
  padding: var(--space-md);
  border-radius: var(--radius-card);
  background: var(--brand);
  transition: opacity 100ms ease;
}

/* 卡片在 scroll-view 里：按压只改透明度 */
.stat-card-hover {
  opacity: 0.86;
}

.stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx;
}

.stat-scope {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.86);
}

.stat-more {
  white-space: nowrap;
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.72);
}

.stat-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: var(--font-title);
  font-weight: 600;
  line-height: var(--leading-title);
  color: var(--card);
}

.stat-label {
  margin-top: 8rpx;
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.72);
}

.stat-line {
  flex: none;
  width: 1rpx;
  height: 46rpx;
  background: rgba(255, 255, 255, 0.26);
}

/* ---------- 章节列表 ---------- */
.chapter-list {
  margin-top: 22rpx;
}

/* ---------- 搜索面板 ---------- */
.search-head {
  padding: 4rpx 4rpx 18rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.search-title {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-main);
}

.search-sub {
  font-size: var(--font-caption);
  color: var(--text-sub);
}

.search-row {
  margin-bottom: 16rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  border-radius: var(--radius-card);
  background: var(--page-bg);
  transition: opacity 100ms ease;
}

.search-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.search-row-title {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-main);
}

.search-row-sub {
  margin-top: 8rpx;
  font-size: var(--font-caption);
  color: var(--text-sub);
}

.search-row-arrow {
  flex: none;
  margin-left: 12rpx;
  font-size: var(--font-body);
  color: var(--text-sub);
}

.search-row-hover {
  opacity: 0.86;
}

.empty-block {
  padding: 72rpx 0;
  text-align: center;
  font-size: var(--font-caption);
  color: var(--text-sub);
}

/* ---------- 答题配置内容 ---------- */
.config-sub {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-secondary);
  line-height: var(--leading-secondary);
  color: var(--text-sub);
}

.config-rows {
  margin-top: 10rpx;
}

.config-note {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-caption);
  line-height: var(--leading-secondary);
  color: var(--text-sub);
}
.config-row.config-row-stacked {
  flex-direction: column;
  align-items: flex-start;
  padding: 24rpx 0;
}

.config-row-stacked .seg-group {
  margin-top: 18rpx;
}

.config-row-stacked .seg-chip:first-child {
  margin-left: 0;
}

.config-option-main {
  flex: 1;
  min-width: 0;
}

.config-row {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.config-label {
  font-size: var(--font-body);
  color: var(--text-main);
}

.config-row-chips {
  min-height: 76rpx;
}

.config-row-tail {
  display: flex;
  align-items: center;
}

.config-inline-hint {
  margin-right: 10rpx;
  font-size: var(--font-caption);
  color: var(--text-sub);
}

/* 原生开关按设计稿压小一档；只影响自身，不参与 hover 反馈 */
.config-switch {
  transform: scale(0.82);
  transform-origin: right center;
}

.seg-group {
  display: flex;
  align-items: center;
}

.seg-group-end {
  margin-left: auto;
}

.seg-chip {
  display: flex;
  align-items: center;
  min-height: 36px;
  margin-left: 12rpx;
  padding: 0 24rpx;
  line-height: var(--leading-secondary);
  border-radius: var(--radius-tag);
  font-size: var(--font-secondary);
  color: var(--text-sub);
  background: var(--page-bg);
  transition: background-color 100ms ease, color 100ms ease;
}

.seg-chip.is-active {
  font-weight: 600;
  color: var(--card);
  background: var(--brand);
}

.seg-chip.is-muted {
  opacity: 0.4;
}

.config-actions {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.config-btn {
  flex: 1;

}

.config-btn.ghost {
  margin-right: 20rpx;

}

.config-banks { width: 100%; margin: 18rpx 0 8rpx; white-space: nowrap; }
.config-bank-list { display: inline-flex; padding: 2rpx 4rpx 10rpx; }
.bank-chip { display: inline-flex; align-items: center; flex-shrink: 0; margin-left: 0; margin-right: 14rpx; }
.bank-check { width: 24rpx; height: 24rpx; line-height: var(--leading-caption); margin-right: 10rpx; border: 2rpx solid currentColor; border-radius: 6rpx; text-align: center; font-size: var(--font-caption); }

.mock-selection { display: flex; align-items: center; justify-content: space-between; }
.stat-more { flex: none; }
.mock-selection { padding: 16rpx 32rpx; background: var(--page-bg); }
.mock-selection-main { flex: 1; min-width: 0; }
.mock-selection .q-button.q-button--text { flex: none; width: auto; margin-left: 16rpx; white-space: nowrap; }
.config-wrap { flex-wrap: wrap; gap: 16rpx; }
.config-wrap .seg-chip { margin: 0; }
.config-wrap .q-button.seg-chip { flex: none; width: auto; }
.config-preset { flex: 1; min-width: 0; margin-right: 20rpx; }
.preset-picker { min-height: 44px; display: flex; align-items: center; gap: 8rpx; color: var(--text-sub); font-size: var(--font-secondary); }
.preset-picker-label { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.preset-picker-arrow { display: block; flex: none; width: 14px; height: 14px; }
.duration-input { box-sizing: border-box; width: 100%; height: 44px; margin-top: 20rpx; padding: 0 20rpx; background: var(--page-bg); border-radius: var(--radius-control); font-size: var(--font-body); }

.config-preset-row { display: flex; align-items: center; flex-wrap: wrap; }
.config-preset-row .q-button { width: auto; flex: none; }
.config-actions .config-btn { flex: none; }
