<view class="bank-detail-page">
  <view class="bk-head" style="padding-top: {{homeStatusBarHeight}}px;">
    <view class="bk-navigation" style="height: {{homeNavigationBarHeight}}px;"><text class="bk-title">题库</text></view>
    <view class="bk-tools">
      <view class="bk-search">
        <view class="bk-search-icon"></view>
        <input
          class="bk-search-input"
          value="{{searchKeyword}}"
          placeholder="搜索题库 / 章节"
          placeholder-class="bk-search-ph"
          confirm-type="search"
          maxlength="20"
          bindinput="handleSearchInput"
          bindconfirm="handleSearchConfirm"
        />
        <view
          class="bk-search-clear"
          wx:if="{{searchKeyword}}"
          bindtap="handleSearchClear"
          hover-class="bk-icon-hover"
          hover-start-time="0"
          hover-stay-time="80"
        >×</view>
      </view>
      <view
        class="bk-filter {{filterToggleEnabled ? 'is-on' : 'is-off'}}"
        bindtap="handleFilterToggle"
        aria-role="button"
        aria-disabled="{{!filterToggleEnabled}}"
        aria-label="{{filterToggleRestore ? '恢复上次筛选' : '重置筛选'}}"
        hover-class="bk-icon-hover"
        hover-start-time="0"
        hover-stay-time="80"
      >
        <view class="bk-filter-icon"></view>
      </view>
    </view>
    <view class="catalog-filters">
      <picker class="catalog-picker" range="{{filterColleges}}" range-key="name" value="{{filterCollegeIndex}}" bindchange="handleCollegeFilter"><view class="filter-select" aria-label="学院筛选">{{filterColleges[filterCollegeIndex].name || '全部学院'}}</view></picker>
      <picker class="catalog-picker" range="{{filterMajors}}" range-key="name" value="{{filterMajorIndex}}" bindchange="handleMajorFilter"><view class="filter-select" aria-label="专业筛选">{{filterMajors[filterMajorIndex].name || '全部专业'}}</view></picker>
      <picker class="catalog-picker" range="{{filterGrades}}" value="{{filterGradeIndex}}" bindchange="handleGradeFilter"><view class="filter-select" aria-label="年级筛选">{{filterGrades[filterGradeIndex] || '全部年级'}}</view></picker>
    </view>
    <view wx:if="{{filterError}}" class="load-note" bindtap="loadFilters" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">{{filterError}} · 重试</view>
  </view>

  <view class="catalog-content">
  <view class="catalog-empty" wx:if="{{!catalogLoading && !catalogError && !subject}}">
    <view>当前筛选下暂无公开题库</view>
    <view bindtap="handleRequestCourse" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">反馈缺少课程</view>
  </view>

  <view class="workbench" wx:if="{{subject}}">
    <scroll-view class="rail" scroll-y enhanced bounces show-scrollbar="{{false}}">
      <view class="rail-inner">
        <view
          class="rail-item {{railMode === 'recent' ? 'is-active' : ''}}"
          bindtap="handleRecentTap"
          hover-class="rail-item-hover"
          hover-start-time="0"
          hover-stay-time="80"
        >
          <view class="rail-bar"></view>
          <view class="rail-body">
            <text class="rail-name">最近在刷</text>
          </view>
        </view>

        <view class="rail-divider"></view>
        <view class="load-note" wx:if="{{subjectsHasMore}}" bindtap="handleSubjectsMore" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">更多科目</view>

        <view
          wx:for="{{subjects}}"
          wx:key="id"
          class="rail-item {{item.active ? 'is-active' : ''}}"
          data-subject-id="{{item.id}}"
          bindtap="handleSubjectSwitch"
          hover-class="rail-item-hover"
          hover-start-time="0"
          hover-stay-time="80"
        >
          <view class="rail-bar"></view>
          <view class="rail-body">
            <text class="rail-name">{{item.name}}</text>
          </view>
        </view>

      </view>
    </scroll-view>

    <scroll-view class="panel" scroll-y enhanced bounces show-scrollbar="{{false}}">
      <view class="panel-inner">
        <!-- 搜索态：跨科目命中，点一行直接配这一章 -->
        <block wx:if="{{searchActive}}">
          <view class="search-head">
            <text class="search-title">搜索结果</text>
            <text class="search-sub">{{searchResults.length}} 条</text>
          </view>

          <view
            wx:for="{{searchResults}}"
            wx:key="id"
            class="search-row"
            data-bank-id="{{item.bankId}}"
            data-chapter-id="{{item.chapterId}}"
            data-subject-id="{{item.subjectId}}"
            bindtap="handleSearchResultTap"
            hover-class="search-row-hover"
            hover-start-time="0"
            hover-stay-time="80"
          >
            <view class="search-row-main">
              <text class="search-row-title">{{item.chapterTitle}}</text>
              <text class="search-row-sub">{{item.subjectName}}<text wx:if="{{item.bankName}}"> · {{item.bankName}}</text> · {{item.metaText}}</text>
            </view>
            <text class="search-row-arrow">›</text>
          </view>

          <view class="load-note" wx:if="{{searchLoading}}">正在搜索…</view>
          <view class="load-note" wx:if="{{searchHasMore && !searchLoading}}" bindtap="handleSearchMore" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">加载更多结果</view>
          <view class="empty-block" wx:if="{{searchEmptyText && !searchLoading}}">
            <text>{{searchEmptyText}}</text>
          </view>
        </block>

        <block wx:else>
          <view
            class="stat-card"
            bindtap="handleStatTap"
            hover-class="stat-card-hover"
            hover-start-time="0"
            hover-stay-time="80"
          >
            <view class="stat-top">
              <text class="stat-scope">{{railMode === 'recent' ? '最近在刷 · ' : ''}}{{subject.name}}</text>
              <text class="stat-more">{{showBankTitles ? '题库练习 ›' : '整科 ›'}}</text>
            </view>
            <view class="stat-row" wx:if="{{stats}}">
              <view class="stat-item">
                <text class="stat-value">{{stats.total}}</text>
                <text class="stat-label">题目总数</text>
              </view>
              <view class="stat-line"></view>
              <view class="stat-item">
                <text class="stat-value">{{stats.answered}}</text>
                <text class="stat-label">已答题数</text>
              </view>
              <view class="stat-line"></view>
              <view class="stat-item">
                <text class="stat-value">{{stats.accuracyText}}</text>
                <text class="stat-label">正确率</text>
              </view>
            </view>
          </view>

          <view class="chapter-list">
            <view class="chapter-group" wx:for="{{chapterGroups}}" wx:for-item="group" wx:key="id">
              <text class="bank-group-title" wx:if="{{showBankTitles}}">{{group.name}}</text>
              <bank-list-item
                wx:for="{{group.rows}}"
                wx:key="id"
                bank="{{item}}"
                bind:open="handleBankOpen"
              />
            </view>
          </view>
          <view class="load-note" wx:if="{{catalogHasMore}}" bindtap="handleBanksMore" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">加载更多章节</view>

          <view class="empty-block" wx:if="{{!rows.length && !catalogLoading && !catalogError}}">
            <text>{{listEmptyText}}</text>
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <view class="catalog-status" wx:if="{{catalogLoading || catalogError}}" aria-live="polite">
    <view class="load-note catalog-status-note" wx:if="{{catalogLoading}}">正在读取题库…</view>
    <view class="load-note catalog-status-note" wx:else bindtap="handleRetryLoad" aria-role="button" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">{{catalogError}} · 点击重试</view>
  </view>
  </view>

  <!-- 答题配置抽屉：参数都是「本次答题」的，不写学习偏好 -->
  <root-portal enable="{{true}}">
  <view class="portal-theme config-sheet portal-theme" wx:if="{{configSheetVisible}}">
    <view class="config-mask" catchtouchmove="noop" catchtap="handleSheetClose"></view>
    <view class="config-panel">
      <view class="config-grip"></view>

      <view class="config-head">
        <text class="config-title">{{configTitle}}</text>
        <text class="config-sub">{{configSubtitle}}</text>
      </view>

      <scroll-view class="config-banks" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{sheetBanks.length}}">
        <view class="config-bank-list">
          <view class="seg-chip bank-chip {{sheetAllBanksSelected ? 'is-active' : ''}}" data-id="all" bindtap="handleSheetBank" aria-role="checkbox" aria-checked="{{sheetAllBanksSelected}}" aria-label="全选题库" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">
            <text class="bank-check">{{sheetAllBanksSelected ? '✓' : sheetSomeBanksSelected ? '−' : ''}}</text>全选
          </view>
          <view wx:for="{{sheetBanks}}" wx:key="id" class="seg-chip bank-chip {{item.selected ? 'is-active' : ''}}" data-id="{{item.id}}" bindtap="handleSheetBank" aria-role="checkbox" aria-checked="{{item.selected}}" aria-label="{{item.name}}" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">
            <text class="bank-check">{{item.selected ? '✓' : ''}}</text>{{item.name}}
          </view>
        </view>
      </scroll-view>

      <view class="config-row"><text>{{sheetSummary}}</text><text bindtap="handleAdvancedToggle" aria-role="button" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">{{advancedConfigVisible ? '收起配置' : '更多配置'}}</text></view>
      <view class="config-rows" wx:if="{{advancedConfigVisible}}">
        <view class="config-row"><text class="config-label">题量</text><view class="seg-group"><view wx:for="{{countOptions}}" wx:key="value" class="seg-chip {{sheetCount === item.value ? 'is-active' : ''}}" data-value="{{item.value}}" bindtap="handleSheetCount" hover-class="chip-flat-hover">{{item.label}}</view></view></view>
        <view class="config-row">
          <text class="config-label">模式</text>
          <view class="seg-group">
            <view
              wx:for="{{modeOptions}}"
              wx:key="value"
              class="seg-chip {{sheetMode === item.value ? 'is-active' : ''}}"
              data-value="{{item.value}}"
              bindtap="handleSheetMode"
              hover-class="chip-flat-hover"
              hover-start-time="0"
              hover-stay-time="80"
            >{{item.label}}</view>
          </view>
        </view>

        <view class="config-row">
          <text class="config-label">顺序</text>
          <view class="seg-group">
            <view
              wx:for="{{orderOptions}}"
              wx:key="value"
              class="seg-chip {{sheetOrder === item.value ? 'is-active' : ''}} {{sheetOrderDisabled ? 'is-muted' : ''}}"
              data-value="{{item.value}}"
              bindtap="handleSheetOrder"
              hover-class="chip-flat-hover"
              hover-start-time="0"
              hover-stay-time="80"
            >{{item.label}}</view>
          </view>
        </view>

        <view class="config-row">
          <text class="config-label">是否限时</text>
          <switch
            class="config-switch"
            checked="{{sheetTimed}}"
            color="#2563EB"
            bindchange="handleSheetTimed"
          />
        </view>

        <view class="config-row config-row-chips" wx:if="{{sheetTimed}}">
          <view class="seg-group seg-group-end">
            <view
              wx:for="{{durationOptions}}"
              wx:key="value"
              class="seg-chip {{sheetDuration === item.value ? 'is-active' : ''}}"
              data-value="{{item.value}}"
              bindtap="handleSheetDuration"
              hover-class="chip-flat-hover"
              hover-start-time="0"
              hover-stay-time="80"
            >{{item.label}}</view>
          </view>
        </view>

        <view class="config-row">
          <text class="config-label">只答错题</text>
          <view class="config-row-tail">
            <text class="config-inline-hint" wx:if="{{!sheetWrongCount}}">暂无错题</text>
            <switch
              class="config-switch"
              checked="{{sheetOnlyWrong}}"
              color="#2563EB"
              bindchange="handleSheetOnlyWrong"
            />
          </view>
        </view>
      </view>

      <view class="config-actions">
        <button
          class="q-button  config-btn ghost"
          bindtap="handleSheetClose"
          hover-class="q-button-hover"
          hover-start-time="0"
          hover-stay-time="80"
        >取消</button>
        <button
          class="{{sheetStartDisabled ? 'q-button--disabled' : ''}} q-button q-button--primary config-btn primary {{sheetStartDisabled ? 'is-disabled' : ''}}" aria-disabled="{{sheetStartDisabled}}"
          bindtap="handleConfigConfirm"
          hover-class="q-button-hover"
          hover-start-time="0"
          hover-stay-time="80"
         disabled="{{sheetStartDisabled}}">{{sheetStartText}}</button>
      </view>
    </view>
  </view>
  </root-portal>

</view>
