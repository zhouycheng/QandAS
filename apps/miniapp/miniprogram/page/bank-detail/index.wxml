<view class="bank-detail-page">
  <view class="bk-head" style="padding-top: {{homeStatusBarHeight}}px;">
    <view class="bk-navigation" style="height: {{homeNavigationBarHeight}}px;"><text class="bk-title">题库</text></view>
    <view class="bk-tools">
      <view class="bk-search">
        <view class="bk-search-icon"></view>
        <input
          class="bk-search-input"
          value="{{searchKeyword}}"
          placeholder="搜索题库 / 章节"
          placeholder-class="bk-search-ph"
          confirm-type="search"
          maxlength="20"
          bindinput="handleSearchInput"
          bindconfirm="handleSearchConfirm"
        />
        <view
          class="bk-search-clear"
          wx:if="{{searchKeyword}}"
          bindtap="handleSearchClear"
          hover-class="bk-icon-hover"
          hover-start-time="0"
          hover-stay-time="80"
        >×</view>
      </view>
      <view
        class="bk-filter {{filterToggleEnabled ? 'is-on' : 'is-off'}}"
        bindtap="handleFilterToggle"
        aria-role="button"
        aria-disabled="{{!filterToggleEnabled}}"
        aria-label="{{filterToggleRestore ? '恢复上次筛选' : '重置筛选'}}"
        hover-class="bk-icon-hover"
        hover-start-time="0"
        hover-stay-time="80"
      >
        <view class="bk-filter-icon"></view>
      </view>
    </view>
    <view class="catalog-filters">
      <picker class="catalog-picker" range="{{filterColleges}}" range-key="name" value="{{filterCollegeIndex}}" bindchange="handleCollegeFilter"><view class="filter-select" aria-label="学院筛选">{{filterColleges[filterCollegeIndex].name || '全部学院'}}</view></picker>
      <picker class="catalog-picker" range="{{filterMajors}}" range-key="name" value="{{filterMajorIndex}}" bindchange="handleMajorFilter"><view class="filter-select" aria-label="专业筛选">{{filterMajors[filterMajorIndex].name || '全部专业'}}</view></picker>
      <picker class="catalog-picker" range="{{filterGrades}}" value="{{filterGradeIndex}}" bindchange="handleGradeFilter"><view class="filter-select" aria-label="年级筛选">{{filterGrades[filterGradeIndex] || '全部年级'}}</view></picker>
    </view>
    <view wx:if="{{filterError}}" class="load-note" bindtap="loadFilters" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">{{filterError}} · 重试</view>
  </view>

  <view class="mock-selection" wx:if="{{mockSelection}}"><view class="mock-selection-main"><text>选择模拟考章节</text><text class="config-note">点击章节或整科卡片开考 · 45 分钟</text></view><button class="q-button q-button--text" bindtap="handleExitMock" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">退出选择</button></view>
  <view class="catalog-content">
  <view class="catalog-empty" wx:if="{{!catalogLoading && !catalogError && !subject}}">
    <view>当前筛选下暂无公开题库</view>
    <view bindtap="handleRequestCourse" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">反馈缺少课程</view>
  </view>

  <view class="workbench" wx:if="{{subject}}">
    <scroll-view class="rail" scroll-y enhanced bounces show-scrollbar="{{false}}" refresher-enabled="{{!configSheetVisible && !routeLoadingVisible}}" refresher-triggered="{{pullRefreshing}}" bindrefresherrefresh="onPullDownRefresh">
      <view class="rail-inner">
        <view
          class="rail-item {{railMode === 'recent' ? 'is-active' : ''}}"
          bindtap="handleRecentTap"
          hover-class="rail-item-hover"
          hover-start-time="0"
          hover-stay-time="80"
        >
          <view class="rail-bar"></view>
          <view class="rail-body">
            <text class="rail-name">最近在刷</text>
          </view>
        </view>

        <view class="rail-divider"></view>
        <view class="load-note" wx:if="{{subjectsHasMore}}" bindtap="handleSubjectsMore" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">更多科目</view>

        <view
          wx:for="{{subjects}}"
          wx:key="id"
          class="rail-item {{item.active ? 'is-active' : ''}}"
          data-subject-id="{{item.id}}"
          bindtap="handleSubjectSwitch"
          hover-class="rail-item-hover"
          hover-start-time="0"
          hover-stay-time="80"
        >
          <view class="rail-bar"></view>
          <view class="rail-body">
            <text class="rail-name">{{item.name}}</text>
          </view>
        </view>

      </view>
    </scroll-view>

    <scroll-view class="panel" scroll-y enhanced bounces show-scrollbar="{{false}}" refresher-enabled="{{!configSheetVisible && !routeLoadingVisible}}" refresher-triggered="{{pullRefreshing}}" bindrefresherrefresh="onPullDownRefresh">
      <view class="panel-inner">
        <!-- 搜索态：跨科目命中，点一行直接配这一章 -->
        <block wx:if="{{searchActive}}">
          <view class="search-head">
            <text class="search-title">搜索结果</text>
            <text class="search-sub">{{searchResults.length}} 条</text>
          </view>

          <view
            wx:for="{{searchResults}}"
            wx:key="id"
            class="search-row"
            data-bank-id="{{item.bankId}}"
            data-chapter-id="{{item.chapterId}}"
            data-subject-id="{{item.subjectId}}"
            bindtap="handleSearchResultTap"
            hover-class="search-row-hover"
            hover-start-time="0"
            hover-stay-time="80"
          >
            <view class="search-row-main">
              <text class="search-row-title">{{item.chapterTitle}}</text>
              <text class="search-row-sub">{{item.subjectName}}<text wx:if="{{item.bankName}}"> · {{item.bankName}}</text> · {{item.metaText}}</text>
            </view>
            <button wx:if="{{!mockSelection}}" class="config-icon" catchtap="handleSearchConfigure" aria-label="配置本次答题" hover-class="config-icon-hover" hover-start-time="0" hover-stay-time="80" data-bank-id="{{item.bankId}}" data-chapter-id="{{item.chapterId}}" data-subject-id="{{item.subjectId}}"><image class="config-icon-image" src="/assets/icons/tiaojie.svg" mode="aspectFit" aria-hidden="true" /></button>
          </view>

          <view class="load-note" wx:if="{{searchLoading}}">正在搜索…</view>
          <view class="load-note" wx:if="{{searchHasMore && !searchLoading}}" bindtap="handleSearchMore" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">加载更多结果</view>
          <view class="empty-block" wx:if="{{searchEmptyText && !searchLoading}}">
            <text>{{searchEmptyText}}</text>
          </view>
        </block>

        <block wx:else>
          <view
            class="stat-card"
            bindtap="handleStatTap"
            hover-class="stat-card-hover"
            hover-start-time="0"
            hover-stay-time="80"
          >
            <view class="stat-top">
              <text class="stat-scope">{{railMode === 'recent' ? '最近在刷 · ' : ''}}{{subject.name}}</text>
              <text class="stat-more">{{mockSelection ? '开始模拟考' : '整科练习'}}</text>
            </view>
            <view class="stat-row" wx:if="{{stats}}">
              <view class="stat-item">
                <text class="stat-value">{{stats.total}}</text>
                <text class="stat-label">题目总数</text>
              </view>
              <view class="stat-line"></view>
              <view class="stat-item">
                <text class="stat-value">{{stats.answered}}</text>
                <text class="stat-label">已答题数</text>
              </view>
              <view class="stat-line"></view>
              <view class="stat-item">
                <text class="stat-value">{{stats.accuracyText}}</text>
                <text class="stat-label">正确率</text>
              </view>
            </view>
          </view>

          <view class="chapter-list">
            <view class="chapter-group" wx:for="{{chapterGroups}}" wx:for-item="group" wx:key="id">
              <text class="bank-group-title" wx:if="{{showBankTitles}}">{{group.name}}</text>
              <bank-list-item
                wx:for="{{group.rows}}"
                wx:key="id"
                bank="{{item}}"
                show-config="{{!mockSelection}}"
                bind:open="handleBankOpen"
                bind:configure="handleBankConfigure"
              />
            </view>
          </view>
          <view class="load-note" wx:if="{{catalogHasMore}}" bindtap="handleBanksMore" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">加载更多章节</view>

          <view class="empty-block" wx:if="{{!rows.length && !catalogLoading && !catalogError}}">
            <text>{{listEmptyText}}</text>
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <view class="catalog-status" wx:if="{{catalogLoading || catalogError}}" aria-live="polite">
    <view class="load-note catalog-status-note" wx:if="{{catalogLoading}}">正在读取题库…</view>
    <view class="load-note catalog-status-note" wx:else bindtap="handleRetryLoad" aria-role="button" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">{{catalogError}} · 点击重试</view>
  </view>
  </view>

  <bottom-sheet visible="{{configSheetVisible}}" title="{{configTitle}}" fixed-footer bind:close="handleSheetClose">
        <view class="config-body">
          <text class="config-sub">{{configSubtitle}}</text>
          <scroll-view class="config-banks" scroll-x wx:if="{{sheetBanks.length}}"><view class="config-bank-list">
            <view class="seg-chip bank-chip {{sheetAllBanksSelected ? 'is-active' : ''}}" data-id="all" bindtap="handleSheetBank" aria-role="checkbox" aria-checked="{{sheetAllBanksSelected}}" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">全选</view>
            <view class="seg-chip bank-chip {{item.selected ? 'is-active' : ''}}" wx:for="{{sheetBanks}}" wx:key="id" data-id="{{item.id}}" bindtap="handleSheetBank" aria-role="checkbox" aria-checked="{{item.selected}}" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">{{item.selected ? '✓ ' : ''}}{{item.name}}</view>
          </view></scroll-view>
          <view class="config-rows">
            <view class="config-row config-row-stacked" wx:if="{{!mockSelection}}"><text class="config-label">答题模式</text><view class="seg-group">
              <view wx:for="{{modeOptions}}" wx:key="value" class="seg-chip {{sheetMode === item.value ? 'is-active' : ''}}" data-value="{{item.value}}" bindtap="handleSheetMode" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">{{item.label}}</view>
            </view></view>
            <view class="config-row config-row-stacked" wx:if="{{sheetMode === 'practice'}}">
              <text class="config-label">反馈时机</text>
              <view class="seg-group config-wrap">
                <button class="q-button seg-chip {{sheetFeedback === 'IMMEDIATE' ? 'is-active' : ''}}" data-value="IMMEDIATE" bindtap="handleSheetFeedback" aria-pressed="{{sheetFeedback === 'IMMEDIATE'}}" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">即时反馈</button>
                <button class="q-button seg-chip {{sheetFeedback === 'AFTER_FINISH' ? 'is-active' : ''}}" data-value="AFTER_FINISH" bindtap="handleSheetFeedback" aria-pressed="{{sheetFeedback === 'AFTER_FINISH'}}" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">交卷后反馈</button>
              </view>
              <text class="config-note">{{sheetFeedback === 'IMMEDIATE' ? '确认答案后显示对错，可查看答案与解析' : '交卷后统一查看对错、答案与解析'}}</text>
            </view>
            <view class="config-row config-row-stacked" wx:if="{{sheetMode === 'practice'}}">
              <text class="config-label">出题顺序</text>
              <view class="seg-group config-wrap">
                <button class="q-button seg-chip {{sheetOrder === 'order' ? 'is-active' : ''}}" data-value="order" bindtap="handleSheetOrder" aria-pressed="{{sheetOrder === 'order'}}" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">顺序出题</button>
                <button class="q-button seg-chip {{sheetOrder === 'random' ? 'is-active' : ''}}" data-value="random" bindtap="handleSheetOrder" aria-pressed="{{sheetOrder === 'random'}}" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">随机出题</button>
              </view>
            </view>
            <view class="config-row config-row-stacked"><text class="config-label">这次做多少题</text><view class="seg-group config-wrap">
              <button wx:for="{{countOptions}}" wx:key="value" class="q-button seg-chip {{sheetCount === item.value ? 'is-active' : ''}}" data-value="{{item.value}}" disabled="{{item.disabled}}" bindtap="handleSheetCount" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">{{item.label}}</button>
            </view><text class="config-note" wx:if="{{sheetLimitHint}}">{{sheetLimitHint}}</text></view>
            <view wx:if="{{sheetMode !== 'view'}}" class="config-row config-row-stacked"><text class="config-label">答题时间</text><view class="seg-group config-wrap">
              <view wx:for="{{durationOptions}}" wx:key="value" class="seg-chip {{!sheetDurationCustom && sheetDuration === item.value ? 'is-active' : ''}}" data-value="{{item.value}}" bindtap="handleSheetDuration" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">{{item.label}}</view>
              <view class="seg-chip {{sheetDurationCustom ? 'is-active' : ''}}" data-value="custom" bindtap="handleSheetDuration" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">自定义</view>
            </view><input wx:if="{{sheetDurationCustom}}" class="duration-input" type="number" value="{{sheetDuration || ''}}" bindinput="handleCustomDuration" placeholder="1～1440 分钟" aria-label="自定义分钟数" /><text class="config-note" wx:if="{{sheetDurationError}}">{{sheetDurationError}}</text></view>
            <view class="config-row"><text class="config-label">只答错题</text><view class="config-row-tail"><text class="config-inline-hint" wx:if="{{!sheetWrongCount}}">暂无错题</text><switch checked="{{sheetOnlyWrong}}" color="#2563EB" bindchange="handleSheetOnlyWrong" aria-label="只答错题" /></view></view>
            <text class="config-note" wx:if="{{sheetScopeLoading}}">正在读取可练习题数…</text>
            <button class="q-button q-button--text" wx:if="{{sheetScopeError}}" bindtap="refreshSheetScope" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">{{sheetScopeError}} · 重试</button>
          </view>
        </view>
        <view slot="footer" class="config-actions">
          <view class="config-preset-row">
          <picker class="config-preset" range="{{sheetPresets}}" range-key="name" value="{{sheetPresetIndex}}" disabled="{{!sheetPresets.length}}" bindchange="handleSheetPreset"><view class="preset-picker" aria-label="选择本次答题预设"><text class="preset-picker-label">{{sheetPresets.length ? '预设：' + sheetPresetName : '暂无模拟考预设'}}</text><image wx:if="{{sheetPresets.length}}" class="preset-picker-arrow" src="/assets/icons/arco-down.svg" mode="aspectFit" aria-hidden="true" /></view></picker>
            <button class="q-button q-button--text" bindtap="handlePresetSave" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">保存为预设</button>
          </view>
          <button class="q-button q-button--primary config-btn" disabled="{{sheetStartDisabled}}" bindtap="handleConfigConfirm" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">{{sheetStartText}}</button>
        </view>
  </bottom-sheet>
</view>

<include src="../../templates/refresh-status.wxml" />
