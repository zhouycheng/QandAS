@import "../../styles/auth-form.wxss";

.secondary-page > .auth-page {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: auto;
  padding: 48rpx 67rpx;
  padding-bottom: calc(144rpx + env(safe-area-inset-bottom));
}

.auth-brand-area {
  flex: none;
  margin-bottom: 52rpx;
}

.brand {
  height: auto;
}

.brand-name {
  font-size: var(--font-display);
  line-height: 1.3;
}

.login-area {
  flex: none;
}

.login-form {
  margin-top: 0;
}

.login-notice {
  padding: 24rpx;
  border-radius: var(--radius-card);
  background: var(--brand-soft);
  color: var(--brand);
  font-size: var(--font-secondary);
  line-height: 1.6;
}

.login-notice + .login-form { margin-top: 32rpx; }

/* 两个字段之间 24px（45rpx）：比注册页的 12px 松，是这张画板的节奏 */
.login-form .field + .field {
  margin-top: 40rpx;
}

.login-form .field-input {
  padding: 0 28rpx;
  border: 0;
}

.login-code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 11rpx;
}

.login-code-row .field-input {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  padding: 0 28rpx;
}

.login-code-send {
  flex: none;
  width: 196rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  white-space: nowrap;
}

.login-code-send-off { background: var(--page-bg); color: var(--text-sub); }

.login-code-hint {
  display: block;
  margin-top: 18rpx;
  color: var(--text-sub);
  font-size: var(--font-caption);
  line-height: 1.5;
}

.agree-row { align-items: center; justify-content: flex-start; flex-wrap: wrap; row-gap: 8rpx; margin-top: 28rpx; }
.agree-left { flex: none; align-items: center; }
.agree-left .checkbox { margin-top: 0; }
.agree-link { color: var(--brand); }

/* 协议行与主按钮的间距。 */
.login-submit {
  margin-top: 32rpx;
}

.wechat-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
}

/* Arco Design IconWechat (MIT); the SVG includes its original license notice. */
.wechat-icon {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  background: url("data:image/svg+xml;base64,") center / contain no-repeat;
}

.q-button.login-code-send { width: 88px; min-height: 48px; padding: 8px; font-size: var(--font-secondary); }
.login-code-row .field-input { height: 48px; padding: 0 12px; }
.login-code-row { gap: 8px; }
.login-submit, .wechat-btn { width: 100%; }
@media (max-width: 350px) {
  .secondary-page > .auth-page { padding-left: 32rpx; padding-right: 32rpx; }
}

.brand-name { font-size: var(--font-metric); line-height: var(--leading-metric); }
.login-submit { margin-top: var(--space-lg); }
.wechat-btn { margin-top: var(--space-md); }
