<!-- 登录页｜设计稿 Figma 763:567（画板 402x874，系数 750/402） -->
<view class="secondary-page">
<page-header />
<view class="auth-page">
  <view class="brand">
    <text class="brand-name">QandA</text>
    <text class="brand-sub">答题系统</text>
  </view>

  <text class="page-title">登录</text>
  <view wx:if="{{loginNotice}}" class="login-notice">{{loginNotice}}</view>

  <view class="form login-form">
    <view class="field">
      <text class="field-label">邮箱</text>
      <input
        class="field-input {{errorField === 'email' ? 'field-input-error' : ''}}"
        type="text"
        value="{{email}}"
        placeholder="请输入邮箱"
        placeholder-class="field-ph"
        maxlength="128"
        confirm-type="next"
        bindinput="handleEmailInput"
      />
    </view>

    <view class="field" wx:if="{{!codeMode}}">
      <text class="field-label">密码</text>
      <password-input
        error="{{errorField === 'password'}}"
        value="{{password}}"
        placeholder="请输入密码"
        maxlength="16"
        confirm-type="done"
        bindinput="handlePasswordInput"
        bindconfirm="handleLoginTap"
      />
    </view>
    <view class="field" wx:if="{{codeMode}}"><text class="field-label">邮箱验证码</text><input class="field-input" type="number" maxlength="6" value="{{code}}" placeholder="请输入六位验证码" bindinput="handleCodeInput" /><view role="button" hover-class="text-hover" hover-start-time="0" hover-stay-time="80" bindtap="handleSendCode" aria-disabled="{{cooldown > 0}}">{{cooldown > 0 ? cooldown + ' 秒后重发' : '获取验证码'}}</view></view>
  </view>
  <view class="entry-link" role="button" hover-class="text-hover" hover-start-time="0" hover-stay-time="80" bindtap="handleModeTap">{{codeMode ? '使用密码登录' : '使用邮箱验证码登录'}}</view>

  <view class="agree-row">
    <view
      class="agree-left"
      bindtap="handleToggleAgreed"
      hover-class="ghost-flat-hover"
      hover-start-time="0"
      hover-stay-time="80"
    >
      <view class="checkbox {{agreed ? 'checkbox-on' : ''}} {{errorField === 'agreed' ? 'checkbox-error' : ''}}">
        <view class="checkbox-tick" wx:if="{{agreed}}"></view>
      </view>
      <text class="agree-text">已阅读并同意用户协议和隐私政策</text>
    </view>

    <text
      class="forgot-link"
      bindtap="handleForgotTap"
      hover-class="text-hover"
      hover-start-time="0"
      hover-stay-time="80"
    >忘记密码？</text>
  </view>

  <view
    class="btn btn-primary login-submit"
    bindtap="handleLoginTap"
    hover-class="btn-hover"
    hover-start-time="0"
    hover-stay-time="80"
  >登录</view>

  <text class="or-text">或</text>

  <view
    class="btn btn-wechat wechat-btn"
    bindtap="handleWechatTap"
    hover-class="btn-hover"
    hover-start-time="0"
    hover-stay-time="80"
  >微信登录</view>


  <text
    class="entry-link"
    bindtap="handleRegisterTap"
    hover-class="text-hover"
    hover-start-time="0"
    hover-stay-time="80"
  >没有账号？立即注册</text>
</view>
</view>
