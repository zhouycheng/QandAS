@import "../../styles/list-page.wxss";
@import "../../styles/profile-selectors.wxss";
.setup-page { min-height: 100vh; box-sizing: border-box; display: flex; flex-direction: column; background: #fff; }
.setup-body { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 48rpx 40rpx; }
.setup-hint { color: #68758a; font-size: 26rpx; line-height: 1.7; margin-bottom: 32rpx; }
.setup-actions { padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom)); }
.setup-save { border-radius: 18rpx; background: #466bff; color: #fff; font-size: 30rpx; }
.setup-save[disabled] { background: #e6e9f0; color: #7d8797; }
.setup-skip { margin-top: 12rpx; background: transparent; color: #68758a; font-size: 26rpx; min-height: 88rpx; }
.setup-skip::after, .setup-save::after { border: 0; }
.setup-error { color: #b93838; font-size: 24rpx; }
.setup-retry { margin-top: 16rpx; color: #466bff; font-size: 26rpx; background: #f3f6ff; }

.setup-pressed { opacity: .7; }
