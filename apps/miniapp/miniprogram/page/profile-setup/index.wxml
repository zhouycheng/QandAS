<import src="../../templates/profile-selectors.wxml" />
<view class="setup-page">
  <page-header title="完善学习资料" show-back="{{false}}" />
  <view class="profile-select-mask" wx:if="{{collegePickerVisible || majorPickerVisible || gradePickerVisible}}" catchtap="handlePickersClose"></view>
  <view class="setup-body">
    <text class="setup-hint">选择学院、专业和年级，为你匹配更合适的题库。</text>
    <template is="profile-selectors" data="{{draft, collegePickerVisible, collegeOptions, collegeLoading, collegeError, collegeHasMore, majorPickerVisible, majorOptions, majorLoading, majorError, majorHasMore, gradePickerVisible, gradeLabels}}" />
    <text wx:if="{{loading}}" class="setup-hint">正在读取资料…</text>
    <text wx:if="{{loadError}}" class="setup-error">{{loadError}}</text>
    <button wx:if="{{loadError}}" class="setup-retry" bindtap="handleReload" hover-class="setup-pressed" hover-start-time="0" hover-stay-time="80">重新读取</button>
  </view>
  <view class="setup-actions">
    <button class="setup-save" disabled="{{!canContinue}}" loading="{{saving}}" bindtap="handleSaveTap" hover-class="setup-pressed" hover-start-time="0" hover-stay-time="80">确认保存</button>
    <button class="setup-skip" disabled="{{saving}}" bindtap="handleSkip" hover-class="setup-pressed" hover-start-time="0" hover-stay-time="80">先不填，我先看看</button>
  </view>
</view>
