@import "../../styles/list-page.wxss";
page { background: var(--card); }
.feedback-dot { flex: none; width: 20rpx; height: 20rpx; margin-left: 10rpx; border-radius: 50%; background: var(--feedback-dot); }

/* 我的｜设计稿 Figma 781:1922（画板 402x874，系数 750/402 ≈ 1.8657）
   三页公共的行高 / 分隔线 / 配色在 styles/list-page.wxss，这里只写本页差异。 */

.profile-hover {
  opacity: 0.86;
}

/* 分区标题与第一行之间留 8px（设计稿 276 → 284） */
.group-title {
  margin-bottom: 15rpx;
}

.link-hover {
  opacity: 0.72;
}

/* 已登录时把让位空间交给独立的退出按钮，未登录时仍由协议区兜底。 */
.links-compact {
  padding-bottom: 0;
}

.logout-block {
  margin-top: 44rpx;
  padding-bottom: 272rpx;
}

.logout-button {
  width: 100%;
  background: var(--page-bg);
  color: var(--text-main);
}

.logout-note {
  display: block;
  margin-top: 14rpx;
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  font-weight: 500;
  color: var(--text-sub);
  text-align: center;
}
