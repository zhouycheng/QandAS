<!-- 我的｜设计稿 Figma 781:1922（画板 402x874，系数 750/402 ≈ 1.8657）
     页内大标题 + 资料头 + 设置 + 法律协议。 -->
<view class="list-page" style="padding-top: {{homeStatusBarHeight}}px;">
  <view class="page-head" style="height: {{homeNavigationBarHeight}}px; padding-right: 210rpx;">
    <text class="page-head-title">我的</text>
  </view>

  <!-- 资料头：未登录时登录，已登录时编辑资料 -->
  <view
    class="profile"
    bindtap="handleProfileTap"
    aria-role="button"
    aria-label="{{auth.loggedIn ? '个人资料' : '登录'}}"
    hover-class="profile-hover"
    hover-start-time="0"
    hover-stay-time="80"
  >
    <view class="profile-avatar">
      <image class="profile-avatar-img" src="{{auth.avatarUrl}}" mode="aspectFill" wx:if="{{auth.avatarUrl}}"></image>
      <view class="avatar-icon" wx:else></view>
    </view>
    <view class="profile-main">
      <text class="profile-name">{{auth.displayName}}</text>
      <text class="profile-sub" wx:if="{{auth.loggedIn}}">{{auth.subText}}</text>
      <text class="profile-sub" wx:else>{{auth.accountTag}}</text>
      <text class="profile-meta">{{auth.metaText}}</text>
    </view>
  </view>

  <view class="group">
    <text class="group-title">设置</text>
    <view
      class="row"
      wx:for="{{learnRows}}"
      wx:key="key"
      data-key="{{item.key}}"
      aria-role="button"
      aria-label="{{item.title + (item.unread ? '，有未读反馈' : '')}}"
      bindtap="handleRowTap"
      hover-class="row-hover"
      hover-start-time="0"
      hover-stay-time="80"
    >
      <text class="row-label">{{item.title}}</text>
      <view wx:if="{{item.unread}}" class="feedback-dot" aria-hidden="true"></view>
      <text class="row-value">{{item.value}}</text>
      <view class="chevron"></view>
    </view>
    <view wx:if="{{auth.loggedIn}}" class="row" bindtap="confirmLogout" hover-class="row-hover" hover-start-time="0" hover-stay-time="80" aria-role="button">
      <text class="row-label">退出登录</text>
      <view class="chevron"></view>
    </view>
  </view>

  <view class="links">
    <text
      class="link"
      data-key="agreement"
      bindtap="handleRowTap"
      hover-class="link-hover"
      hover-start-time="0"
      hover-stay-time="80"
    >用户协议</text>
    <view class="link-divider"></view>
    <text
      class="link"
      data-key="privacy"
      bindtap="handleRowTap"
      hover-class="link-hover"
      hover-start-time="0"
      hover-stay-time="80"
    >隐私政策</text>
  </view>
</view>

<!-- 协议正文通过共享弹层展示。 -->
<bottom-sheet
  visible="{{sheet !== ''}}"
  title="{{sheetTitle}}"
  placement="center"
  bind:close="handleSheetClose"
>
  <text class="sheet-text" user-select>{{sheetBody}}</text>

  <view class="sheet-actions">
    <button
      class="q-button q-button--primary bottom-btn"
      bindtap="handleSheetClose"
      hover-class="q-button-hover"
      hover-start-time="0"
      hover-stay-time="80"
    >知道了</button>
  </view>
</bottom-sheet>

<include src="../../templates/refresh-status.wxml" />
