@import "../../styles/list-page.wxss";
@import "../../styles/profile-selectors.wxss";

button.avatar-button[size="mini"] {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  min-width: 128rpx;
  max-width: 128rpx;
  margin: 20rpx auto 40rpx;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: #F0F3FF;
  overflow: hidden;
}
.avatar-button::after { border: none; }
.avatar-button .profile-avatar-img { width: 100%; height: 100%; }
.avatar-button .avatar-icon { width: 58rpx; height: 58rpx; }
.avatar-hover { opacity: .7; }
.nickname-field { display: flex; align-items: center; box-sizing: border-box; height: 86rpx; margin-top: 15rpx; padding: 0 26rpx; border-radius: 15rpx; background: #efefef; overflow: hidden; }
.nickname-field .field-input { flex: 1; min-width: 0; width: 0; height: 86rpx; margin: 0; padding: 0; }
.nickname-wechat-button { flex: none; display: flex; align-items: center; justify-content: flex-end; width: auto; min-width: 0; height: 86rpx; margin: 0 0 0 20rpx; padding: 0; border: 0; border-radius: 0; line-height: 45rpx; font-size: 22rpx; font-weight: 500; color: #466bff; background: transparent; box-shadow: none; }
.nickname-wechat-button::after { border: none; }
