<view class="list-page page-with-bottom-bar">
  <text class="section-note" wx:if="{{required}}">完善学院、专业与年级，查看适合你的题库。以后可以随时修改。</text>
  <view class="section">
    <text class="group-title">个人信息</text>

    <!-- 头像：微信现行唯一可用的头像是 open-type="chooseAvatar"，不能再用 getUserProfile -->
    <view class="avatar-row">
      <view class="profile-avatar avatar-sm">
        <image
          class="profile-avatar-img"
          src="{{draft.avatarUrl}}"
          mode="aspectFill"
          wx:if="{{draft.avatarUrl}}"
        ></image>
        <view class="avatar-icon" wx:else></view>
      </view>
      <text class="avatar-label">头像（本机）</text>
      <button
        class="link-btn"
        open-type="chooseAvatar"
        bindchooseavatar="handleChooseAvatar"
        hover-class="link-btn-hover"
        hover-start-time="0"
        hover-stay-time="80"
      >
        <text class="info-action">更换头像</text>
        <view class="chevron"></view>
      </button>
    </view>

    <view class="field">
      <text class="field-label">昵称</text>
      <input
        class="field-input"
        type="nickname"
        value="{{draft.nickname}}"
        placeholder="填写昵称，答题记录里会显示"
        placeholder-class="field-placeholder"
        maxlength="32"
        data-key="nickname"
        bindinput="handleFieldInput"
        bindblur="handleFieldBlur"
      />
    </view>

    <!-- 学院：设计稿「我的」页要显示这一行，所以得有个能填的地方 -->
    <view class="field">
      <text class="field-label">学院</text>
      <view class="field-input" bindtap="handleCollegeOpen" hover-class="card-hover" hover-start-time="0" hover-stay-time="80">{{draft.college || '未选择'}}</view>
    </view>
    <view class="field">
      <text class="field-label">专业</text>
      <view class="field-input" bindtap="handleMajorOpen" hover-class="card-hover" hover-start-time="0" hover-stay-time="80">{{draft.major || '请选择专业'}}</view>
    </view>
    <view class="field">
      <text class="field-label">当前年级</text>
      <picker range="{{gradeLabels}}" value="{{draft.currentGrade ? draft.currentGrade - 1 : 0}}" bindchange="handleGradeChange">
        <view class="field-input" hover-class="card-hover" hover-start-time="0" hover-stay-time="80">{{draft.gradeLabel || '请选择年级'}}</view>
      </picker>
    </view>
    <text class="section-note">每年 9 月自动升一级，大四后为已毕业。你可以随时调整。</text>
  </view>

  <view class="group">
    <text class="group-title">账号信息</text>

    <view
      class="info-item"
      bindtap="handleEmailTap"
      hover-class="row-hover"
      hover-start-time="0"
      hover-stay-time="80"
    >
      <text class="info-label">绑定邮箱</text>
      <view class="info-line">
        <text class="info-value">{{profile.emailMasked || '未绑定'}}</text>
        <text class="info-action">更换</text>
        <view class="chevron"></view>
      </view>
    </view>

    <view
      class="info-item"
      bindtap="handleWechatTap"
      hover-class="row-hover"
      hover-start-time="0"
      hover-stay-time="80"
    >
      <text class="info-label">微信绑定</text>
      <view class="info-line">
        <text class="info-value">{{profile.wechatStatus}}</text>
        <text class="info-action">{{profile.wechatStatus === '已绑定' ? '管理' : '绑定'}}</text>
        <view class="chevron"></view>
      </view>
    </view>

    <view
      class="info-item"
      bindtap="handlePasswordTap"
      hover-class="row-hover"
      hover-start-time="0"
      hover-stay-time="80"
    >
      <text class="info-label">登录密码</text>
      <view class="info-line">
        <text class="info-value">{{profile.passwordStatus}}</text>
        <text class="info-action">{{profile.passwordStatus === '已设置' ? '修改' : '设置'}}</text>
        <view class="chevron"></view>
      </view>
    </view>

    <text class="section-note">邮箱用于登录、找回密码与接收提醒。</text>
  </view>
</view>
<bottom-sheet visible="{{collegePickerVisible}}" title="选择学院" bind:close="handleCollegeClose">
  <view class="load-note" wx:for="{{collegeOptions}}" wx:key="id" data-index="{{index}}" bindtap="handleCollegePick" hover-class="card-hover" hover-start-time="0" hover-stay-time="80">{{item.name}}</view>
  <view class="load-note" wx:if="{{collegeLoading}}">正在读取院校…</view>
  <view class="load-note" wx:if="{{collegeError}}" bindtap="handleCollegeOpen" hover-class="card-hover" hover-start-time="0" hover-stay-time="80">{{collegeError}} · 点击重试</view>
  <view class="load-note" wx:if="{{collegeHasMore && !collegeLoading}}" bindtap="handleCollegeMore" hover-class="card-hover" hover-start-time="0" hover-stay-time="80">加载更多院校</view>
</bottom-sheet>
<bottom-sheet visible="{{majorPickerVisible}}" title="选择专业" bind:close="handleMajorClose">
  <view class="load-note" wx:for="{{majorOptions}}" wx:key="id" data-index="{{index}}" bindtap="handleMajorPick" hover-class="card-hover" hover-start-time="0" hover-stay-time="80">{{item.name}}</view>
  <view class="load-note" wx:if="{{majorLoading}}">正在读取专业…</view>
  <view class="load-note" wx:if="{{majorError}}" bindtap="handleMajorOpen" hover-class="card-hover" hover-start-time="0" hover-stay-time="80">{{majorError}} · 点击重试</view>
  <view class="load-note" wx:if="{{majorHasMore && !majorLoading}}" bindtap="handleMajorMore" hover-class="card-hover" hover-start-time="0" hover-stay-time="80">加载更多专业</view>
</bottom-sheet>

<view class="bottom-bar">
  <view
    class="bottom-btn {{dirty ? '' : 'bottom-btn-disabled'}}"
    bindtap="handleSaveTap"
    hover-class="bottom-btn-hover"
    hover-start-time="0"
    hover-stay-time="80"
  >保存资料</view>
</view>
