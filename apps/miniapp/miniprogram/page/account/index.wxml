<view class="secondary-page">
<page-header title="个人资料" />
<view class="list-page page-with-bottom-bar account-page settings-detail">
    <button
      class="profile-avatar avatar-button"
      size="mini"
      open-type="chooseAvatar"
      bindchooseavatar="handleChooseAvatar"
      disabled="{{avatarPreparing || saving}}"
      aria-label="更换头像"
      hover-class="avatar-hover"
      hover-start-time="0"
      hover-stay-time="80"
    >
        <image
          class="profile-avatar-img"
          src="{{draft.avatarUrl}}"
          mode="aspectFill"
          wx:if="{{draft.avatarUrl}}"
        ></image>
        <view class="avatar-icon" wx:else></view>
        <view class="avatar-edit" aria-hidden="true"><view class="avatar-edit-icon"></view></view>
    </button>

    <view class="field">
      <view class="nickname-label-row">
        <text class="field-label">昵称</text>
        <button wx:if="{{profile.wechatBound}}" class="q-button q-button--text nickname-wechat-button" bindtap="handleUseWechatNickname" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">使用微信昵称</button>
      </view>
      <view class="nickname-field">
      <input
        class="field-input"
        type="nickname"
        value="{{draft.nickname}}"
        placeholder="填写昵称，答题记录里会显示"
        placeholder-class="field-placeholder"
        maxlength="32"
        data-key="nickname"
        bindinput="handleFieldInput"
        bindblur="handleFieldBlur"
        bindnicknamereview="handleNicknameReview"
        focus="{{nicknameFocus}}"
      />
      </view>
    </view>

    <view
      class="info-item settings-divider"
      bindtap="handleEmailTap"
      hover-class="row-hover"
      hover-start-time="0"
      hover-stay-time="80"
    >
      <text class="info-label">邮箱</text>
      <view class="info-line">
        <text class="info-value {{profile.emailMasked ? '' : 'info-value-highlight'}}">{{profile.emailMasked ? '绑定' : '未绑定'}}</text>
      </view>
    </view>

    <view
      class="info-item settings-divider"
      bindtap="handleWechatTap"
      hover-class="row-hover"
      hover-start-time="0"
      hover-stay-time="80"
    >
      <text class="info-label">微信</text>
      <view class="info-line">
        <text class="info-value">{{wechatBinding ? '正在绑定…' : profile.wechatStatus}}</text>
        <text wx:if="{{profile.wechatAction && !profile.isTestAccount}}" class="info-action">{{profile.wechatAction}}</text>
        <view wx:if="{{!profile.wechatBound && !profile.isTestAccount}}" class="chevron"></view>
      </view>
    </view>


    <text class="section-note">{{profile.isTestAccount ? '测试账号使用固定登录码，凭据由管理员管理。' : '邮箱与微信用于登录和验证账号操作。'}}</text>

    <button class="q-button account-delete" bindtap="handleAccountDeletion" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">注销账号</button>
</view>
<view class="bottom-bar">
  <button
    class="{{!dirty || avatarPreparing || saving ? 'q-button--disabled' : ''}} q-button q-button--primary bottom-btn"
    bindtap="handleSaveTap"
    hover-class="q-button-hover"
    hover-start-time="0"
    hover-stay-time="80"
   disabled="{{!dirty || avatarPreparing || saving}}" loading="{{avatarPreparing || saving}}">保存资料</button>
</view>
</view>
