@import "../../styles/settings-detail.wxss";
page { background: var(--card); }
.feedback-page { padding-top: var(--space-md); }
.feedback-page.has-footer { padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }
.feedback-footer { position: fixed; left: 32rpx; right: 32rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); z-index: 5; }
.feedback-footer .primary { width: 100%;  margin: 0;   }
.tabs { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.tab { flex: 1; display: flex; align-items: center; justify-content: center; text-align: center; padding: 20rpx; border-radius: var(--radius-tag); background: var(--page-bg); }
.feedback-dot { flex: none; width: 14rpx; height: 14rpx; margin-left: 12rpx; border-radius: 50%; background: var(--danger); }
.selected { color: var(--brand); background: var(--brand-soft); }
.entry { padding: var(--space-md) 0; }
.entry text, .hint { display: block; white-space: pre-wrap; word-break: break-all; }
.title { font-size: var(--font-body); font-weight: 500; margin: var(--space-sm) 0; }
.status, .hint { color: var(--text-sub); font-size: var(--font-secondary); }
.hint { padding: 28rpx 0; }
.reply { background: var(--page-bg); border-radius: var(--radius-control); padding: var(--space-md); margin-top: var(--space-md); font-size: var(--font-secondary); white-space: pre-wrap; }
.form { padding-top: var(--space-md); }
.form .settings-input { margin-top: var(--space-sm); margin-bottom: var(--space-md); }
.field.settings-input { display: flex; align-items: center; }
.feedback-body.settings-input { height: auto; min-height: 240rpx; padding: 12px; line-height: 1.65; }
.tabs > .q-button { flex: 1; }
.form-placeholder { color: var(--text-sub); }
button::after { border: 0; }
.pressed { opacity: .78; }
