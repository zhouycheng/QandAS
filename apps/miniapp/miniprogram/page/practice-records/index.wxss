page { background: #ffffff; }
.records { padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); }
.record { padding: 28rpx 26rpx; margin-bottom: 24rpx; background: #ffffff; border: 2rpx solid #e5ebf3; border-left: 8rpx solid #3b82f6; border-radius: 20rpx; }
.record-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.title { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 600; line-height: 1.5; color: #182230; }
.status { flex-shrink: 0; max-width: 210rpx; padding: 5rpx 12rpx; border-radius: 10rpx; font-size: 21rpx; line-height: 1.6; color: #245dc1; background: #edf4ff; }
.tags { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin-top: 20rpx; font-size: 22rpx; line-height: 1.6; }
.mode, .feedback { padding: 3rpx 12rpx; border-radius: 8rpx; }
.mode { color: #315ba3; background: #eff5ff; }
.feedback { color: #766044; background: #faf3e9; }
.count { color: #667085; }
.record-foot { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #eef2f6; font-size: 22rpx; }
.time { color: #778397; }
.action { display: flex; flex-shrink: 0; align-items: center; gap: 10rpx; color: #245dc1; font-weight: 500; }
.arrow { font-size: 32rpx; line-height: 1; }
.record-waiting { border-left-color: #e7a337; }
.record-waiting .status { color: #955711; background: #fff3df; }
.record-waiting .action { color: #955711; }
.record-ended { border-left-color: #2a9d82; }
.record-ended .status { color: #18765f; background: #e8f7f0; }
.record-ended .action { color: #18765f; }
.hint { padding: 32rpx 0; color: #667085; font-size: 26rpx; }
.pressed { opacity: .75; }
