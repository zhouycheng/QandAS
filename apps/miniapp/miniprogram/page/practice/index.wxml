<wxs module="layoutDrag" src="../../utils/layout-drag.wxs" />
<wxs module="analysisDrag" src="../../utils/analysis-drag.wxs" />
<wxs module="readingDrag" src="../../utils/reading-drag.wxs" />
<!-- 答题页：顶部导航、题目模块与底部操作共用练习模板。 -->
<view class="page practice-page pra-viewport {{keyboardVisible ? 'pra-keyboard-open' : ''}} font-{{preferences.fontSize}}" style="{{practiceWindowHeight ? 'height:' + practiceWindowHeight + 'px;min-height:0;' : ''}}">
  <light-toast id="practice-hint" />
  <include src="../../templates/practice-head.wxml" />
  <view wx:if="{{trialNotice}}" class="load-note">{{trialNotice}}</view>
  <view wx:if="{{loadingPractice}}" class="load-note">正在读取本次练习…</view>
  <view wx:if="{{submitting}}" class="pra-modal"><view class="pra-modal-panel"><text>正在确认交卷结果…</text></view></view>
  <view wx:if="{{loadError}}" class="pra-modal"><view class="pra-modal-panel"><text>{{loadError}}</text><button class="q-button  pra-btn" bindtap="returnBankDetail" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">返回题库</button></view></view>
  <block wx:if="{{!isCompleted && !loadingPractice && !loadError}}">
    <view wx:if="{{canRetrySync && saveStatusText}}" class="load-note" aria-live="polite">{{saveStatusText}}<text bindtap="retrySync" role="button" hover-class="text-hover" hover-start-time="0" hover-stay-time="80"> · 重试同步</text></view>
    <view class="pra-body {{readingLayout ? 'pra-reading' : ''}}" bindtap="onQuestionTap" hover-class="none" bindtouchstart="onQuestionTouchStart" bindtouchmove="onQuestionTouchMove" bindtouchend="onQuestionTouchEnd" bindtouchcancel="ignoreSwipe" bind:textselection="onTextSelection" bind:contentready="scheduleMeasure">
      <block wx:if="{{readingLayout}}">
        <include src="../../templates/practice-reading.wxml" />
      </block>
      <block wx:else><include src="../../templates/practice-content.wxml" /></block>
    </view>
    <view class="pra-footer"><include src="../../templates/practice-actions.wxml" /></view>

    <root-portal enable="{{true}}" wx:if="{{shouldRevealAnswer && hasAnswered && feedback === 'IMMEDIATE' && !isViewMode && analysisAreaHeight && !analysisSuspended && !keyboardVisible && !showQuestionOverview && !showSubmitModal && !editingLocked}}">
      <view class="portal-theme analysis-layer font-{{preferences.fontSize}}" style="top:{{analysisAreaTop}}px;height:{{analysisAreaHeight}}px;">
        <view class="analysis-mask" catchtap="closeAnalysis" catchtouchmove="blockAnalysisTouch"></view>
        <view class="analysis-sheet" motion="{{ {version: analysisSheetVersion, height: analysisSheetHeight, offset: analysisSheetOffset} }}" change:motion="{{analysisDrag.sync}}">
          <view class="analysis-surface" aria-role="dialog" aria-label="第{{currentNumber}}题答案解析" aria-hidden="{{!analysisSheetOpen && !analysisDragging}}">
            <view class="analysis-sheet-header"><text>第 {{currentNumber}} 题 · 答案解析</text><button class="q-button q-button--text analysis-close" catchtap="closeAnalysis" aria-label="收起答案解析" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">×</button></view>
            <scroll-view class="analysis-sheet-body" scroll-y enhanced bounces="{{false}}" show-scrollbar="{{false}}" scroll-top="{{analysisScrollTop}}"><include src="../../templates/practice-analysis.wxml" /></scroll-view>
          </view>
          <view class="analysis-handle" aria-role="button" aria-label="{{analysisSheetOpen ? '拖动调整解析位置，点按收起' : '下拉或点按展开答案解析'}}" aria-expanded="{{analysisSheetOpen}}" catchtap="{{analysisDrag.tap}}" catchtouchstart="{{analysisDrag.start}}" catchtouchmove="{{analysisDrag.move}}" catchtouchend="{{analysisDrag.end}}" catchtouchcancel="{{analysisDrag.cancel}}" hover-class="none">
            <view class="analysis-handle-shape" aria-hidden="true"><view class="analysis-grip"></view></view>
          </view>
        </view>
      </view>
    </root-portal>

    <!-- 未答完的二次确认：居中卡片，两个按钮等宽 -->
    <view class="pra-modal" wx:if="{{showSubmitModal}}">
      <view class="pra-modal-mask" bindtap="closeSubmitModal"></view>
      <view class="pra-modal-panel">
        <text class="pra-modal-title">确认交卷</text>
        <text class="pra-modal-desc">未答 {{unansweredCount}} 题，待确认 {{pendingConfirmationCount}} 题。交卷将确认所有已保存的作答，未答客观题不得分。</text>
        <view class="pra-modal-actions">
          <button class="q-button  pra-btn" bindtap="closeSubmitModal" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">继续答题</button>
          <button class="q-button q-button--primary pra-btn primary" bindtap="forceSubmit" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">确认交卷</button>
        </view>
      </view>
    </view>

    <question-overview-sheet
      visible="{{showQuestionOverview}}"
      items="{{overviewItems}}"
      unanswered-count="{{unansweredCount}}"
      marked-count="{{markedCount}}"
      answered-count="{{total - unansweredCount - pendingConfirmationCount}}"
      draft-count="{{pendingConfirmationCount}}"
      total="{{total}}"
      show-status="{{!isViewMode}}"
      can-submit="{{!isViewMode}}"
      bind:close="closeOverview"
      bind:jump="jumpToQuestion"
      bind:submit="handleOverviewSubmit"
      bind:jumpmarked="jumpToFirstMarked"
    />
  </block>

  <block wx:elif="{{isCompleted}}">
    <scroll-view class="pra-result" scroll-y enhanced bounces show-scrollbar="{{false}}">
      <view wx:if="{{submitError}}" class="pra-submit-error">
        <text class="pra-submit-error-text">{{submitError}}</text>
        <button
          class="q-button q-button--text pra-submit-retry"
          bindtap="retrySubmit"
          hover-class="q-button-hover"
          hover-start-time="0"
          hover-stay-time="80"
        >重试提交</button>
      </view>

      <!-- 蓝色渐变统计卡：三格数据，白字压在渐变上 -->
      <view class="res-card">
        <view class="res-card-cell">
          <text class="res-card-value">{{elapsedText}}</text>
          <text class="res-card-label">总用时</text>
        </view>
        <view class="res-card-split"></view>
        <view class="res-card-cell">
          <text class="res-card-value">{{total - unansweredCount}}/{{total}}</text>
          <text class="res-card-label">已答/总题</text>
        </view>
        <view class="res-card-split"></view>
        <view class="res-card-cell">
          <text class="res-card-value">{{scoreText}}</text>
          <text class="res-card-label">{{objectiveCount ? '客观题得分' : '本次练习'}}</text>
        </view>
      </view>

      <!-- 答题明细：与答题过程中的答题卡同一套配色 -->
      <view class="res-detail">
        <view class="res-detail-head">
          <text class="res-detail-title">答题明细</text>
          <text class="res-detail-sub">客观正确率 {{objectiveAccuracyText}}<text wx:if="{{objectiveCount}}"> · 最高分 {{bestScore}}</text></text>
        </view>

        <view class="res-legend">
          <view class="res-legend-item"><view class="res-dot dot-correct"></view><text class="res-legend-text">答对</text></view>
          <view class="res-legend-item"><view class="res-dot dot-wrong"></view><text class="res-legend-text">答错</text></view>
          <view class="res-legend-item"><view class="res-dot dot-pending"></view><text class="res-legend-text">未答</text></view>
          <view class="res-legend-item"><view class="res-mark-dot"></view><text class="res-legend-text">标记</text></view>
        </view>

        <view class="res-grid">
          <view
            wx:for="{{overviewItems}}"
            wx:key="index"
            class="res-cell {{item.answered ? (item.isShortAnswer ? 'cell-unscored' : (item.isCorrect ? 'cell-correct' : 'cell-wrong')) : 'cell-pending'}}"
            data-index="{{item.index}}"
            bindtap="jumpToQuestion"
            hover-class="cell-flat-hover"
            hover-start-time="0"
            hover-stay-time="80"
          >
            <text class="res-cell-number">{{item.number}}</text>
            <view class="res-cell-mark" wx:if="{{item.isMarked}}"></view>
          </view>
        </view>
      </view>

      <view class="res-actions">
        <button class="q-button  pra-btn" bindtap="returnBankDetail" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">返回题库</button>
        <button class="q-button q-button--primary pra-btn primary" bindtap="restartPractice" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">再来一次</button>
      </view>

      <view class="res-actions res-actions-extra" wx:if="{{hasWrongQuestions}}">
        <button class="q-button  pra-btn highlight" bindtap="redoWrongQuestions" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">重练错题 {{wrongCount}} 题</button>
        <button class="q-button  pra-btn" bindtap="returnHome" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">回到首页</button>
      </view>

      <view class="res-review">
        <text class="res-review-title">逐题回顾</text>

        <view class="res-review-bar">
          <view class="res-filters">
            <view
              class="res-filter {{resultFilter === 'all' ? 'active' : ''}}"
              data-filter="all"
              bindtap="handleResultFilter"
              hover-class="chip-flat-hover"
              hover-start-time="0"
              hover-stay-time="80"
            >全部 {{resultFilterCounts.all}}</view>
            <view
              class="res-filter {{resultFilter === 'correct' ? 'active' : ''}}"
              data-filter="correct"
              bindtap="handleResultFilter"
              hover-class="chip-flat-hover"
              hover-start-time="0"
              hover-stay-time="80"
            >正确 {{resultFilterCounts.correct}}</view>
            <view
              class="res-filter {{resultFilter === 'wrong' ? 'active' : ''}}"
              data-filter="wrong"
              bindtap="handleResultFilter"
              hover-class="chip-flat-hover"
              hover-start-time="0"
              hover-stay-time="80"
            >错误 {{resultFilterCounts.wrong}}</view>
            <view
              class="res-filter {{resultFilter === 'unanswered' ? 'active' : ''}}"
              data-filter="unanswered"
              bindtap="handleResultFilter"
              hover-class="chip-flat-hover"
              hover-start-time="0"
              hover-stay-time="80"
            >未答 {{resultFilterCounts.unanswered}}</view>
            <view class="res-filter {{resultFilter === 'unscored' ? 'active' : ''}}" data-filter="unscored" bindtap="handleResultFilter" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">不计分 {{resultFilterCounts.unscored}}</view>
            <view class="res-filter {{resultFilter === 'review' ? 'active' : ''}}" data-filter="review" bindtap="handleResultFilter" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">待复习 {{resultFilterCounts.review}}</view>
          </view>

          <input
            class="res-search"
            type="text"
            value="{{resultKeyword}}"
            placeholder="搜索题干或选项"
            placeholder-class="res-search-ph"
            bindinput="handleResultSearch"
          />
        </view>

        <view wx:if="{{!filteredResultItems.length}}" class="res-empty">
          <text>{{resultFilterEmptyText}}</text>
        </view>

        <view
          wx:for="{{filteredResultItems}}"
          wx:key="id"
          class="res-item {{item.answered && !item.isShortAnswer && !item.isCorrect ? 'is-wrong' : ''}}"
          data-id="{{item.id}}"
          bindtap="handleOpenQuestionDetail"
          hover-class="res-item-hover"
          hover-start-time="0"
          hover-stay-time="80"
        >
          <view class="res-item-head">
            <text class="res-item-number">{{item.number}}</text>
            <text class="res-item-type">{{item.typeText}}</text>
            <text class="res-item-flag {{item.answered ? (item.isShortAnswer ? 'skip' : (item.isCorrect ? 'ok' : 'no')) : 'skip'}}">{{item.isShortAnswer ? (item.answered ? '已作答 · 不计分' : '未作答 · 不计分') : (item.answered ? (item.isCorrect ? '正确' : '错误') : '未答')}}</text>
          </view>
          <view class="pra-material" wx:if="{{item.material}}"><rich-content text="{{(item.material.passage) || ''}}" format="{{(item.material.contentFormat) || 'PLAIN_TEXT'}}" /></view>
          <question-images wx:if="{{item.material}}" paths="{{(item.material.imagePaths) || []}}" />
          <rich-content class="res-item-stem" text="{{(item.stem) || ''}}" format="{{(item.contentFormat) || 'PLAIN_TEXT'}}" blanks="{{item.blankInputs}}" disabled />
          <question-images paths="{{(item.imagePaths) || []}}" />
          <view class="res-item-line">
            <text class="res-item-label">你的答案</text>
            <rich-content class="res-item-value" text="{{(item.selectedText) || ''}}" code-language="{{(item.presentation === 'CODE_WRITING' ? item.codeLanguage : '') || ''}}" />
          </view>
          <view class="res-item-line">
            <text class="res-item-label">{{item.isShortAnswer ? (item.presentation === 'CODE_WRITING' ? '参考实现' : '参考思路') : '正确答案'}}</text>
            <rich-content class="res-item-value" text="{{(item.correctText) || ''}}" format="{{(item.isShortAnswer ? item.contentFormat : 'PLAIN_TEXT') || 'PLAIN_TEXT'}}" />
          </view>
          <view class="res-item-line" wx:if="{{item.scoringPoints.length}}">
            <text class="res-item-label">参考要点</text>
            <rich-content class="res-scoring-point" wx:for="{{item.scoringPoints}}" wx:for-item="point" wx:for-index="pointIndex" wx:key="*this" text="{{(pointIndex + 1) + '. ' + (point || '')}}" format="{{(item.contentFormat) || 'PLAIN_TEXT'}}" />
          </view>
          <view class="res-self-assessment" wx:if="{{item.isShortAnswer && item.answered}}">
            <text class="res-item-label">这道题掌握了吗？{{item.selfAssessment === 'CORRECT' ? '已掌握' : (item.selfAssessment === 'WRONG' ? '还需复习' : '')}}</text>
            <view class="res-assessment-actions">
              <button class="q-button  q-button--compact res-assessment-option {{item.selfAssessment === 'CORRECT' ? 'is-selected' : ''}}" catchtap="assessResult" data-id="{{item.id}}" data-value="CORRECT" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">已掌握</button>
              <button class="q-button  q-button--compact res-assessment-option {{item.selfAssessment === 'WRONG' ? 'is-selected' : ''}}" catchtap="assessResult" data-id="{{item.id}}" data-value="WRONG" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">还需复习</button>
            </view>
          </view>
          <view class="res-item-line">
            <text class="res-item-label">解析</text>
            <rich-content class="res-item-value" text="{{(item.explanation) || ''}}" format="{{(item.contentFormat) || 'PLAIN_TEXT'}}" />
          </view>
        </view>
      </view>

      <view class="pra-body-pad"></view>
    </scroll-view>
  </block>
</view>
