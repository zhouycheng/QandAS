@import "../../styles/practice.wxss";
@import "../../styles/settings-detail.wxss";
.settings-detail.layout-editor { padding: 0; }
.layout-editor .pra-body { padding: 0 var(--space-lg); }
.layout-editor .pra-footer { padding-left: var(--space-lg); padding-right: var(--space-lg); }
.layout-module { position: relative; padding: 20rpx; border: 1rpx solid var(--line); border-radius: var(--radius-control); margin: 8rpx 0; background: var(--card); }
.layout-drag-surface { position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 2; }
.layout-dragging { box-shadow: 0 8rpx 24rpx var(--brand-soft); opacity: .9; }
.layout-insert { position: absolute; top: -10rpx; left: 0; right: 0; border-top: 5rpx solid var(--brand); color: var(--brand); font-size: var(--font-caption); z-index: 12; }
.layout-end { color: var(--brand); border-top: 5rpx solid var(--brand); font-size: var(--font-caption); }
.layout-editor .pra-content { padding-top: 4rpx; }
.layout-editor .pra-stem { margin: 0; }
.layout-editor .pra-meta, .layout-editor .pra-tools { margin: 0; padding: 0; }
.layout-editor .pra-analysis { margin: 0; padding: 0; border: 0; }
.layout-editor .pra-analysis-head { margin-bottom: 12rpx; }
.layout-editor .pra-option { min-height: 80rpx; padding: 16rpx; margin-bottom: 12rpx; }
.layout-editor .pra-option:last-child { margin-bottom: 0; }
.layout-editor .pra-material { margin-bottom: 16rpx; padding: 16rpx; }
.layout-editor .pra-body-pad { height: 12rpx; }
.layout-tip { display: block; margin-bottom: 12rpx; color: var(--text-sub); font-size: var(--font-caption); line-height: var(--leading-caption); text-align: center; }
.layout-actions { display: flex; gap: var(--space-md); }
.layout-actions > .q-button { flex: 1; }
