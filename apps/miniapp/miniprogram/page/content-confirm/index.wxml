<view class="secondary-page">
  <page-header title="内容确认" />
  <view class="confirmation-page">
    <block wx:if="{{completed}}"><text>已确认，请返回管理端等待检查结果。</text></block>
    <block wx:else>
      <text>粘贴管理端本次操作的确认码。</text>
      <textarea class="confirmation-code" value="{{confirmationCode}}" bindinput="handleInput" maxlength="120" placeholder="确认码" disabled="{{loading}}" />
      <button class="{{loading ? 'q-button--disabled' : ''}} q-button q-button--primary btn btn-primary" bindtap="handleInspect" loading="{{loading}}" disabled="{{loading}}" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">查看本次内容</button>
      <view wx:if="{{invitation}}" class="confirmation-preview">
        <text>{{invitation.title}}</text>
        <text wx:for="{{invitation.preview}}" wx:key="index" class="confirmation-excerpt">{{item}}</text>
        <text>确认后，微信将检查本次内容。结果返回原管理端操作。</text>
        <button class="{{loading ? 'q-button--disabled' : ''}} q-button q-button--primary btn btn-primary" bindtap="handleConfirm" loading="{{loading}}" disabled="{{loading}}" hover-class="q-button-hover" hover-start-time="0" hover-stay-time="80">确认并开始检查</button>
      </view>
    </block>
    <text wx:if="{{error}}" class="confirmation-error">{{error}}</text>
  </view>
</view>
