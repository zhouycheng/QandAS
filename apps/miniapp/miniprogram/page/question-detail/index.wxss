@import "../../styles/controls.wxss";
.detail-page {
  display: flex;
  flex-direction: column;
  background: var(--card);
}

.detail-loading,
.detail-empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: var(--font-secondary);
  color: var(--text-sub);
}

.detail-area {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 60rpx;
}

.detail-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.detail-type {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand-dark);
  font-size: var(--font-caption);
}

.detail-source {
  flex: 1;
  margin-left: 16rpx;
  font-size: var(--font-caption);
  color: var(--text-sub);
}

.detail-stem {
  display: block;
  font-size: var(--reading-size, var(--reading-normal));
  line-height: 1.65;
  color: var(--text-main);
}

.detail-option {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
  border-radius: var(--radius-tag);
  background: var(--brand-soft);
}

.detail-option.correct {
  background: var(--success-soft);
}

.detail-option.wrong {
  background: var(--danger-soft);
}

.detail-option-label {
  flex-shrink: 0;
  width: 40rpx;
  font-size: var(--reading-size, var(--reading-normal));
  color: var(--brand-dark);
}

.detail-option-text {
  flex: 1;
  font-size: var(--reading-size, var(--reading-normal));
  line-height: 1.65;
  color: var(--text-main);
}

.answer-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.answer-label {
  flex-shrink: 0;
  width: 140rpx;
  font-size: var(--font-secondary);
  color: var(--text-sub);
}

.answer-value {
  flex: 1;
  font-size: var(--reading-size, var(--reading-normal));
  line-height: 1.65;
  color: var(--text-main);
}

.answer-value.ok {
  color: var(--success);
}

.answer-value.no {
  color: var(--danger);
}

.correct-value {
  color: var(--success);
}

.answer-flag {
  padding: 14rpx 0 0;
  font-size: var(--font-secondary);
}

.answer-flag.ok {
  color: var(--success);
}

.answer-flag.no {
  color: var(--danger);
}

.explain-text {
  display: block;
  font-size: var(--reading-size, var(--reading-normal));
  line-height: 1.65;
  color: var(--text-sub);
}

.favorite-btn {
  margin-top: 24rpx;

}

