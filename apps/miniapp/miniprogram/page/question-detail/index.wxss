@import "../../styles/controls.wxss";
.detail-page {
  display: flex;
  flex-direction: column;
  background: var(--card);
  min-height: 0;
  height: 0;
}

.detail-loading,
.detail-empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: var(--font-secondary);
  color: var(--text-sub);
}

.detail-area {
  flex: 1;
  min-height: 0;
  height: 0;
}
.detail-content {
  padding: var(--space-md) var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom));
}
.detail-material { margin-bottom: var(--space-lg); padding: var(--space-md); border-radius: var(--radius-tag); background: var(--page-bg); font-size: var(--reading-size, var(--reading-normal)); line-height: 1.65; }
.detail-scoring { display: block; margin-top: var(--space-sm); font-size: var(--reading-size, var(--reading-normal)); line-height: 1.65; }

.detail-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.detail-type {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand-dark);
  font-size: var(--font-caption);
}

.detail-source {
  flex: 1;
  margin-left: 16rpx;
  font-size: var(--font-caption);
  color: var(--text-sub);
}

.detail-stem {
  display: block;
  font-size: var(--reading-size, var(--reading-normal));
  line-height: 1.65;
  color: var(--text-main);
}

.detail-option {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  min-height: 44px;
  padding: 12rpx 0;
  margin-top: 8rpx;
  box-sizing: border-box;
}

.detail-option.correct .detail-option-label {
  background: var(--success);
  color: var(--card);
}

.detail-option.wrong .detail-option-label {
  background: var(--danger);
  color: var(--card);
}

.detail-option-label {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  line-height: 1;
  font-size: var(--font-body);
  color: var(--text-sub);
  background: var(--page-bg);
}

.detail-option-text {
  flex: 1;
  min-width: 0;
  font-size: var(--reading-size, var(--reading-normal));
  line-height: 1.65;
  color: var(--text-main);
}

.detail-option.correct .detail-option-text {
  color: var(--success);
}

.detail-option.wrong .detail-option-text {
  color: var(--danger);
}

.answer-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 40rpx;
  padding: 24rpx 0 36rpx;
}

.answer-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
  max-width: 100%;
}

.answer-label {
  flex-shrink: 0;
  font-size: var(--font-secondary);
  color: var(--text-sub);
}

.answer-value {
  display: block;
  flex: 1;
  min-width: 0;
  font-size: var(--reading-size, var(--reading-normal));
  line-height: 1.65;
  color: var(--text-main);
}

.answer-value.ok {
  color: var(--success);
}

.answer-value.no {
  color: var(--danger);
}

.answer-value.correct-value {
  color: var(--success);
}

.answer-summary-block,
.answer-summary-block .answer-row {
  display: block;
}
.answer-summary-block .answer-row + .answer-row {
  margin-top: var(--space-md);
}
.answer-summary-block .answer-value {
  margin-top: 8rpx;
}
.detail-subjective {
  display: block;
  margin-top: var(--space-sm);
  font-size: var(--font-secondary);
  color: var(--text-sub);
}
.explain-block {
  margin-bottom: var(--space-lg);
}
.detail-explanation-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
  padding-top: 32rpx;
  border-top: 14rpx solid var(--page-bg);
  font-size: var(--reading-size, var(--reading-normal));
  font-weight: 600;
  color: var(--text-main);
}
.detail-explanation-title::before,
.detail-explanation-title::after {
  content: '';
  width: 40rpx;
  height: 2rpx;
  background: var(--line);
}

.explain-text {
  display: block;
  font-size: var(--reading-size, var(--reading-normal));
  line-height: 1.8;
  color: var(--text-main);
}

.favorite-btn {
  margin-top: var(--space-md);
}
