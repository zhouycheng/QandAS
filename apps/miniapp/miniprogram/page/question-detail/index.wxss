@import "../../styles/controls.wxss";
.detail-page {
  display: flex;
  flex-direction: column;
  background: var(--card);
  min-height: 0;
  height: 0;
}

.detail-loading,
.detail-empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: var(--font-secondary);
  color: var(--text-sub);
}

.detail-area {
  flex: 1;
  min-height: 0;
  padding: var(--space-md) var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom));
}
.detail-card, .answer-card, .explain-card { margin-bottom: var(--space-lg); }
.detail-material { margin-bottom: var(--space-lg); padding: var(--space-md); border-radius: var(--radius-tag); background: var(--page-bg); font-size: var(--reading-size, var(--reading-normal)); line-height: 1.65; }
.detail-scoring { display: block; margin-top: var(--space-sm); font-size: var(--reading-size, var(--reading-normal)); line-height: 1.65; }

.detail-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.detail-type {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand-dark);
  font-size: var(--font-caption);
}

.detail-source {
  flex: 1;
  margin-left: 16rpx;
  font-size: var(--font-caption);
  color: var(--text-sub);
}

.detail-stem {
  display: block;
  font-size: var(--reading-size, var(--reading-normal));
  line-height: 1.65;
  color: var(--text-main);
}

.detail-option {
  display: flex;
  align-items: flex-start;
  padding: var(--space-md);
  margin-top: var(--space-sm);
  border-radius: var(--radius-tag);
  background: var(--brand-soft);
}

.detail-option.correct {
  background: var(--success-soft);
}

.detail-option.wrong {
  background: var(--danger-soft);
}

.detail-option-label {
  flex-shrink: 0;
  min-width: 1.5em;
  line-height: 1.65;
  font-size: var(--reading-size, var(--reading-normal));
  color: var(--brand-dark);
}

.detail-option-text {
  flex: 1;
  font-size: var(--reading-size, var(--reading-normal));
  line-height: 1.65;
  color: var(--text-main);
}

.answer-row {
  display: block;
  margin-bottom: var(--space-md);
}

.answer-label {
  display: block;
  margin-bottom: 4px;
  font-size: var(--font-secondary);
  color: var(--text-sub);
}

.answer-value {
  display: block;
  min-width: 0;
  font-size: var(--reading-size, var(--reading-normal));
  line-height: 1.65;
  color: var(--text-main);
}

.answer-value.ok {
  color: var(--success);
}

.answer-value.no {
  color: var(--danger);
}

.correct-value {
  color: var(--success);
}

.answer-flag {
  padding: 14rpx 0 0;
  font-size: var(--font-secondary);
}

.answer-flag.ok {
  color: var(--success);
}

.answer-flag.no {
  color: var(--danger);
}

.explain-text {
  display: block;
  font-size: var(--reading-size, var(--reading-normal));
  line-height: 1.65;
  color: var(--text-sub);
}

.favorite-btn {
  margin-top: var(--space-md);
}
