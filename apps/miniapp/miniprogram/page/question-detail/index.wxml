<view class="secondary-page secondary-page-fill">
<page-header title="题目详情" />
<view class="page detail-page font-{{fontSize}}">
  <view wx:if="{{!ready}}" class="detail-loading">
    <text>加载中…</text>
  </view>

  <block wx:else>
    <view wx:if="{{emptyText}}" class="detail-empty">
      <text>{{emptyText}}</text>
    </view>

    <scroll-view wx:else class="detail-area" scroll-y enhanced bounces show-scrollbar="{{false}}">
      <view class="detail-card card">
        <view class="detail-head">
          <text class="detail-type">{{typeText}}</text>
          <text class="detail-source">{{subjectName}} · {{bankName}}</text>
        </view>

        <view wx:if="{{material}}" class="detail-material"><text class="section-title">阅读材料</text><rich-content text="{{(material.passage) || ''}}" format="{{(material.contentFormat) || 'PLAIN_TEXT'}}" /></view>
        <question-images wx:if="{{material}}" paths="{{(material.imagePaths) || []}}" />
        <rich-content class="detail-stem" text="{{(stem) || ''}}" format="{{(contentFormat) || 'PLAIN_TEXT'}}" blanks="{{blankInputs}}" disabled />
        <question-images paths="{{(imagePaths) || []}}" />

        <view
          wx:for="{{options}}"
          wx:key="key"
          class="detail-option {{item.isCorrectOption ? 'correct' : ''}} {{canReveal && item.isSelected && !item.isCorrectOption ? 'wrong' : ''}}"
        >
          <text class="detail-option-label">{{item.label}}</text>
          <rich-content class="detail-option-text" text="{{(item.text) || ''}}" format="{{(contentFormat) || 'PLAIN_TEXT'}}" />
        </view>
      </view>

      <view wx:if="{{hasAnswer || canReveal}}" class="answer-card card">
        <text class="section-title">作答情况</text>
        <view wx:if="{{hasAnswer}}" class="answer-row">
          <text class="answer-label">你的答案</text>
          <rich-content class="answer-value" text="{{(selectedText) || ''}}" code-language="{{(presentation === 'CODE_WRITING' ? codeLanguage : '') || ''}}" />
        </view>
        <view wx:if="{{canReveal}}" class="answer-row">
          <text class="answer-label">{{isShortAnswer ? (presentation === 'CODE_WRITING' ? '参考实现' : '参考思路') : '正确答案'}}</text>
          <rich-content class="answer-value" text="{{(correctText) || ''}}" format="{{(isShortAnswer ? contentFormat : 'PLAIN_TEXT') || 'PLAIN_TEXT'}}" />
        </view>
        <view wx:if="{{canReveal && hasAnswer && !isShortAnswer}}" class="answer-flag {{isCorrect ? 'ok' : 'no'}}">
          <text>{{isCorrect ? '回答正确' : '回答错误'}}</text>
        </view>
        <text wx:if="{{isShortAnswer}}">{{hasAnswer ? '已作答' : '未作答'}} · 不计分</text>
      </view>

      <view wx:if="{{explanation}}" class="explain-card card">
        <text class="section-title">解析</text>
        <rich-content class="explain-text" text="{{(explanation) || ''}}" format="{{(contentFormat) || 'PLAIN_TEXT'}}" />
        <rich-content wx:for="{{scoringPoints}}" wx:key="*this" text="{{(item) || ''}}" format="{{(contentFormat) || 'PLAIN_TEXT'}}" />
      </view>

      <view
        class="favorite-btn {{isFavorite ? 'active' : ''}}"
        bindtap="handleToggleFavorite"
        hover-class="btn-flat-hover"
        hover-start-time="0"
        hover-stay-time="80"
      >{{isFavorite ? '已收藏' : '收藏本题'}}</view>
      <view class="favorite-btn" bindtap="handleFeedback" hover-class="btn-flat-hover" hover-start-time="0" hover-stay-time="80">题目纠错</view>
    </scroll-view>
  </block>
</view>
</view>
