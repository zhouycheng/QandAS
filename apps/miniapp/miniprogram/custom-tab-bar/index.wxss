@import "../styles/controls.wxss";
/* 整条底栏浮在安全区之上：下方写 0 兜底，不支持 env() 的机型退回贴底 */
.tabbar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  bottom: env(safe-area-inset-bottom);
  height: 232rpx;
  pointer-events: none;
}

/* 弹层打开时整条底栏让位。用 display:none 而不是 opacity:0 ——
   后者虽然看不见但仍在最上层，会把弹层下方的按钮点击全吃掉。 */

.tabbar {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 16rpx;
  /* 左右留白使首尾图标远离胶囊边缘。 */
  padding: 0 24rpx;
  box-sizing: border-box;
  height: 120rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  /* 毛玻璃：半透明白 + 背景模糊。
     不支持的机型会退化成「半透明白条」，仍然比纯白实心透气，
     所以底色保留透明度而不是写死 var(--card)。 */
  /* saturate 是关键：只加模糊会让底下的内容整体发灰，
     提高饱和度才像 iOS 那种「透亮」的玻璃。
     白色底的 0.76 是折中值：再透一点（0.7）时深色卡片滚到底栏下面，
     var(--text-sub) 的未选中文字会糊在背景里认不出。 */
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(22px) saturate(180%);
  -webkit-backdrop-filter: blur(22px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 8rpx 28rpx rgba(31, 42, 55, 0.08), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  pointer-events: auto;
}

/* 四个 tab 等宽排列。 */
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 120rpx;
  transition: opacity 100ms ease;
}

.tab-item-hover {
  opacity: 0.72;
}

/* 四个图标同一个盒子、同一描边，避免「有的显大有的显小」 */
.tab-icon {
  width: 50rpx;
  height: 50rpx;
}

.tab-text {
  margin-top: 4rpx;
  font-size: 11px;
  font-size: var(--font-caption);
  color: #667085;
  color: var(--text-sub);
}

.tab-item.active .tab-text {
  color: var(--brand);
  font-weight: 500;
}
