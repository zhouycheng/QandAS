@import "./controls.wxss";
/**
 * 答题页样式（按 2026-10-27 设计稿重做）
 *
 * 答题与布局编辑共用同一套骨架：
 *   顶部导航 → 进度条 → 可排序内容模块 → 上一题/下一题
 *
 * 换算：设计板 402px 宽 → rpx = px × 1.8657
 *
 * ⚠️ 本文件**不出现 transform**：interaction-audit 对 scroll-view 内 hover 类只要匹配到
 *    `transform:`（哪怕值是 none）就判定「按压时画面抖动」。按压反馈一律只用 opacity，
 *    hover 类统一用 app.wxss 里的 `-flat` 无位移版本。
 */

/* ============ 页面骨架 ============ */

.practice-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: var(--card);
  overflow: hidden;
  min-height: 0;
  padding: 0;
}

/* ============ ② 细进度条 ============ */

.pra-progress {
  flex: none;
  height: 4rpx;
  background: var(--page-bg);
}

.pra-progress-fill {
  height: 100%;
  background: var(--brand);
  border-radius: 0 4rpx 4rpx 0;
  transition: width 220ms ease;
}

/* ============ ③ 信息行 ============ */

.pra-meta {
  flex: none;
  display: flex;
  align-items: center;
  padding: 26rpx 40rpx 6rpx;
  box-sizing: border-box;
}

.pra-meta-index {
  flex: none;
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--brand);
  margin-right: 16rpx;
}

.pra-meta-type {
  font-size: var(--font-caption);
  color: var(--text-sub);
  padding: 4rpx 14rpx;
  background: var(--page-bg);
  border-radius: 8rpx;
}
.pra-meta-tags { display: flex; flex-wrap: wrap; gap: 6rpx; margin-right: 12rpx; }

.pra-meta-timer {
  flex: none;
  margin-left: auto;
  font-size: var(--font-caption);
  color: var(--text-sub);
  font-variant-numeric: tabular-nums;
}

/* ============ ④ 题目区 ============ */

.pra-body {
  flex: 1;
  min-height: 0;
  padding: 0 var(--space-lg);
  box-sizing: border-box;
}

.pra-body-pad {
  height: var(--space-lg);
}

.pra-content {
  display: flex;
  flex-direction: column;
  padding-top: var(--space-md);
}

/* 答题态使用固定分区；布局编辑使用相同比例预览和外层拖拽滚动。 */
.pra-pane { position: relative; min-width: 0; }
.pra-viewport .pra-body { overflow: hidden; }
.pra-viewport .pra-content { height: 100%; min-height: 0; gap: var(--space-md); padding-bottom: var(--space-md); }
.pra-viewport .pra-module { flex: none; margin: 0; min-height: 0; }
.pra-viewport .pra-pane { overflow: hidden; }
.pra-viewport .pra-pane-scroll { display: block; height: 100%; }
.pra-viewport .pra-pane-content { padding-bottom: 18px; min-width: 0; }
.pra-viewport .pra-material-pane { margin-bottom: var(--space-md); border-radius: var(--radius-tag); background: var(--page-bg); }
.pra-viewport .pra-material { margin: 0; }
.pra-viewport .pra-textarea-content { height: 100%; padding-bottom: 0; }
.pra-viewport .pra-textarea-content textarea { height: 100%; min-height: 0; }
.pra-viewport .pra-analysis { margin-top: 0; padding-top: 0; border-top: 0; }
.pra-viewport .pra-analysis-head { flex-wrap: wrap; gap: var(--space-xs); }
.pra-viewport .load-note { flex: none; }
.pra-keyboard-open .pra-footer { padding-bottom: var(--space-md); }
.pra-scroll-hint { position: absolute; right: 0; bottom: 0; padding: 0 6px; font-size: var(--font-caption); line-height: 18px; color: var(--text-sub); background: var(--card); pointer-events: none; }
.pra-material-pane .pra-scroll-hint { background: var(--page-bg); }

.pra-stem {
  order: 2;
  margin-top: 0;
}

.pra-stem {
  font-size: var(--reading-size, var(--reading-normal));
  font-weight: 400;
  line-height: 1.65;
  color: var(--text-main);
  margin-bottom: 0;
}

.pra-options {
  display: flex;
  flex-direction: column;
}
.pra-options-content { display: flex; flex-direction: column; justify-content: flex-end; box-sizing: border-box; }
.pra-options-content .pra-option:last-child { margin-bottom: 0; }

/* 选项：白底卡片 + 字母圆标。选中 / 答对 / 答错三态靠底色 + 描边区分 */
.pra-option {
  display: flex;
  align-items: center;
  min-height: 44px;
  padding: var(--space-md);
  margin-bottom: var(--space-sm);
  box-sizing: border-box;
  background: var(--card);
  border: 2rpx solid var(--page-bg);
  border-radius: var(--radius-card);
  transition: opacity 100ms ease, background-color 160ms ease, border-color 160ms ease;
}

.pra-option-hover {
  opacity: 0.86;
}

.pra-option-key {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  line-height: 1.5;
  margin-right: 20rpx;
  text-align: center;
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--text-sub);
  background: var(--page-bg);
  border-radius: 50%;
  transition: background-color 160ms ease, color 160ms ease;
}

.pra-option-text {
  flex: 1;
  font-size: var(--reading-size, var(--reading-normal));
  line-height: 1.65;
  color: var(--text-main);
}

/* 选中与答对共用绿色系，答错用橙色。
   顺序很重要：越靠后权重越高，保证「选了且错了」显示橙色而不是绿色 */
.pra-option.is-correct {
  background: var(--success-soft);
  border-color: var(--success);
}

.pra-option.is-correct .pra-option-key {
  color: var(--card);
  background: var(--success);
}

.pra-option.is-wrong {
  background: var(--warning-soft);
  border-color: var(--warning);
}

.pra-option.is-wrong .pra-option-key {
  color: var(--card);
  background: var(--warning);
}

/* ============ ⑤ 解析 ============ */

.pra-analysis {
  margin-top: 12rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid var(--page-bg);
}

.pra-analysis-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.pra-result-tag {
  flex: none;
  font-size: var(--font-caption);
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.pra-result-tag.ok {
  color: var(--success);
  background: var(--success-soft);
}

.pra-result-tag.no {
  color: var(--warning);
  background: var(--warning-soft);
}

.pra-analysis-answer {
  flex: 1;
  font-size: var(--reading-size, var(--reading-normal));
  color: var(--text-sub);
}

.pra-side-title {
  display: block;
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 10rpx;
}

.pra-explanation-text {
  display: block;
  font-size: var(--reading-size, var(--reading-normal));
  line-height: 1.65;
  color: var(--text-sub);
}

.pra-explanation-muted {
  font-size: var(--reading-size, var(--reading-normal));
  color: var(--text-sub);
  line-height: 1.65;
  padding: 20rpx 24rpx;
  background: var(--page-bg);
  border-radius: var(--radius-tag);
}

/* ============ ⑥ 底部工具行 + 两个按钮 ============ */

.pra-footer {
  flex: none;
  padding: var(--space-md) var(--space-lg) calc(var(--space-md) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.pra-tools {
  display: flex;
  flex-wrap: wrap;
  row-gap: var(--space-sm);
  align-items: center;
  margin-bottom: 18rpx;
}

/* 三个 pill 按内容宽度靠左排（设计稿如此，不是平分整行） */
.pra-tool {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 36px;
  padding: 0 var(--space-md);
  margin-right: 16rpx;
  background: var(--card);
  border: 2rpx solid var(--page-bg);
  border-radius: var(--radius-tag);
  transition: opacity 100ms ease, background-color 160ms ease, border-color 160ms ease;
}

.pra-tool:last-child {
  margin-right: 0;
}

.pra-tool.on {
  background: var(--brand-soft);
  border-color: var(--brand-soft);
}

.pra-tool.marked {
  background: var(--warning-soft);
  border-color: var(--warning-soft);
}

.pra-tool-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

.pra-tool-text {
  font-size: var(--font-caption);
  color: var(--text-sub);
}

.pra-tool.on .pra-tool-text {
  color: var(--brand);
  font-weight: 600;
}

.pra-tool.marked .pra-tool-text {
  color: var(--warning);
  font-weight: 600;
}

/* 图标 base64 内联：微信不支持本地 .svg 的 background-image（见 AGENTS.md） */
.icon-star {
  background-image: url("data:image/svg+xml;base64,");
}

.icon-star.on {
  background-image: url("data:image/svg+xml;base64,");
}

.icon-grid {
  background-image: url("data:image/svg+xml;base64,");
}

.icon-pen {
  background-image: url("data:image/svg+xml;base64,");
}

.icon-pen.on {
  background-image: url("data:image/svg+xml;base64,");
}

.pra-actions {
  display: flex;
  align-items: center;
}

/* 两个按钮严格等宽：flex:1 + 只有后一个留左边距 */
.pra-btn {
  flex: 1;

  box-sizing: border-box;

}

.pra-btn + .pra-btn {
  margin-left: 24rpx;
}

/* ============ ⑦ 未答完的二次确认 ============ */

.pra-modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pra-modal-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 22, 33, 0.45);
}

.pra-modal-panel {
  position: relative;
  width: calc(100% - 64rpx);
  padding: var(--space-xl) var(--space-lg) var(--space-lg);
  box-sizing: border-box;
  background: var(--card);
  border-radius: var(--radius-card);
  display: flex;
  flex-direction: column;
}

.pra-modal-panel > .pra-btn + .pra-btn {
  margin-left: 0;
  margin-top: 20rpx;
}

.pra-modal-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--text-main);
}

.pra-modal-desc {
  margin-top: var(--space-sm);
  margin-bottom: var(--space-lg);
  font-size: var(--font-secondary);
  line-height: var(--leading-secondary);
  color: var(--text-sub);
}

.pra-modal-actions {
  display: flex;
}

/* ============ ⑧ 结果页 ============ */

.pra-result {
  flex: 1;
  min-height: 0;
  padding: var(--space-md) var(--space-lg) 0;
  box-sizing: border-box;
}

.pra-submit-error {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  background: var(--warning-soft);
  border-radius: var(--radius-tag);
}

.pra-submit-error-text {
  flex: 1;
  font-size: var(--font-caption);
  color: var(--warning);
}

.pra-submit-retry {
  flex: none;
  margin-left: 20rpx;

}

/* 蓝色渐变统计卡：三格数据 + 两条细分隔线 */
.res-card {
  display: flex;
  align-items: center;
  padding: 34rpx 24rpx;
  background: var(--brand);
  border-radius: var(--radius-card);
}

.res-card-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.res-card-value {
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--card);
  line-height: var(--leading-title);
  font-variant-numeric: tabular-nums;
}

.res-card-label {
  margin-top: 10rpx;
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.8);
}

.res-card-split {
  width: 2rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.28);
}

/* 答题明细 */
.res-detail {
  margin-top: var(--space-lg);
}

.res-detail-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.res-detail-title {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-main);
}

.res-detail-sub {
  margin-left: auto;
  font-size: var(--font-caption);
  color: var(--text-sub);
}

.res-legend {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 22rpx;
}

.res-legend-item {
  display: flex;
  align-items: center;
  margin-right: 26rpx;
}

.res-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.res-mark-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  background: var(--warning);
}

.dot-correct {
  background: var(--success);
}

.dot-wrong {
  background: var(--warning);
}

.dot-pending {
  background: var(--line);
}

.res-legend-text {
  font-size: var(--font-caption);
  color: var(--text-sub);
}

/* 6 列网格：固定宽 + 自动换行，第 6 个去掉右边距 */
.res-grid {
  display: flex;
  flex-wrap: wrap;
}

.res-cell {
  position: relative;
  flex: 0 0 auto;
  /* 6 格正好铺满一行：(100% - 5×间距) / 6。写死 88rpx 会剩一条右边空档 */
  width: calc((100% - 75rpx) / 6);
  height: 88rpx;
  margin-right: 15rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-tag);
  background: var(--page-bg);
  transition: opacity 100ms ease;
}

.res-cell:nth-child(6n) {
  margin-right: 0;
}

.res-cell-number {
  font-size: var(--font-secondary);
  font-weight: 600;
  color: var(--text-sub);
}

.res-cell.cell-correct {
  background: var(--success-soft);
}

.res-cell.cell-correct .res-cell-number {
  color: var(--success);
}

.res-cell.cell-wrong {
  background: var(--warning-soft);
}

.res-cell.cell-wrong .res-cell-number {
  color: var(--warning);
}

/* 标记点：右上角小橙点，不遮题号 */
.res-cell-mark {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--warning);
}

.cell-flat-hover {
  opacity: 0.86;
}

.res-actions {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
}

.res-actions-extra {
  margin-top: 20rpx;
}

/* ============ ⑨ 逐题回顾 ============ */

.res-review {
  margin-top: 44rpx;
}

.res-review-title {
  display: block;
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 22rpx;
}

.res-review-bar {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.res-filters {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.res-filter {
  padding: 10rpx 22rpx;
  margin-right: 14rpx;
  margin-bottom: 12rpx;
  font-size: var(--font-secondary);
  color: var(--text-sub);
  background: var(--page-bg);
  border-radius: 999rpx;
  transition: opacity 100ms ease, background-color 160ms ease, color 160ms ease;
}

.res-filter.active {
  color: var(--card);
  background: var(--brand);
  font-weight: 600;
}

.res-search {
  height: 76rpx;
  padding: 0 26rpx;
  font-size: var(--font-secondary);
  color: var(--text-main);
  background: var(--page-bg);
  border-radius: var(--radius-tag);
  box-sizing: border-box;
}

.res-search-ph {
  color: var(--text-sub);
}

.res-empty {
  padding: var(--space-xl) 0;
  text-align: center;
  font-size: var(--font-secondary);
  line-height: var(--leading-secondary);
  color: var(--text-sub);
}

.res-item {
  padding: 26rpx;
  margin-bottom: 20rpx;
  background: var(--card);
  border: 2rpx solid var(--page-bg);
  border-radius: var(--radius-card);
  transition: opacity 100ms ease;
}

.res-item-hover {
  opacity: 0.86;
}

.res-item.is-wrong {
  border-color: var(--warning-soft);
}

.res-item-head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.res-item-number {
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--text-main);
  margin-right: 14rpx;
}

.res-item-type {
  font-size: var(--font-caption);
  color: var(--text-sub);
  padding: 2rpx 12rpx;
  background: var(--page-bg);
  border-radius: 6rpx;
}

.res-item-flag {
  margin-left: auto;
  font-size: var(--font-caption);
  font-weight: 600;
}

.res-item-flag.ok {
  color: var(--success);
}

.res-item-flag.no {
  color: var(--warning);
}

.res-item-flag.skip {
  color: var(--text-sub);
}

.res-item-stem {
  display: block;
  font-size: var(--reading-size, var(--reading-normal));
  line-height: 1.65;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.res-item-line {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 24rpx;
  min-width: 0;
}

.res-item-label {
  flex: none;
  font-size: var(--font-secondary);
  color: var(--text-sub);
}

.res-item-value {
  display: block;
  width: 100%;
  min-width: 0;
  font-size: var(--reading-size, var(--reading-normal));
  line-height: 1.65;
  color: var(--text-sub);
}

.res-scoring-point { display: block; min-width: 0; margin-top: var(--space-sm); color: var(--text-sub); font-size: var(--reading-size, var(--reading-normal)); line-height: 1.65; }
.res-self-assessment { margin-top: 24rpx; }
.res-assessment-actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 14rpx; }
.res-assessment-option {      white-space: nowrap; }

.res-item-value.is-correct {
  color: var(--success);
}

/* ============ 阅读字号与内容模块 ============ */

/* 字母圆标是固定尺寸的圆圈，字号变大时圈也得放大，否则字会顶边 */
.pra-content .pra-meta { padding: 0; }
.pra-viewport .module-info .pra-meta { padding-top: 8px; }
.pra-module { position: relative; margin-bottom: var(--space-lg); }
.pra-content .pra-tools { padding: 0; margin: 0; }
.pra-module textarea { width: 100%; min-height: 180rpx; padding: 20rpx; box-sizing: border-box; background: var(--page-bg); border-radius: var(--radius-tag); }
.pra-material { margin-bottom: 28rpx; padding: 24rpx; background: var(--page-bg); border-radius: var(--radius-tag); white-space: pre-wrap; }
.pra-material text { display: block; }
.pra-material .pra-side-title { margin-bottom: 16rpx; }
.pra-blank { display: flex; align-items: center; gap: 20rpx; margin-bottom: 20rpx; }
.pra-blank input { flex: 1; min-width: 0; padding: 22rpx; background: var(--page-bg); border-radius: var(--radius-tag); }
.pra-scoring { display: block; margin-top: 12rpx; }

.cell-unscored { background: var(--page-bg); color: var(--text-sub); }

.pra-option.is-selected { border-color: var(--brand); background: var(--brand-soft); }
.pra-option.is-selected .pra-option-key { background: var(--brand); color: var(--card); }
.pra-option.is-correct { border-color: var(--success); background: var(--success-soft); }
.pra-option.is-correct .pra-option-key { background: var(--success); color: var(--card); }
.pra-option.is-wrong { border-color: var(--danger); background: var(--danger-soft); }
.pra-option.is-wrong .pra-option-key { background: var(--danger); color: var(--card); }
.pra-material, .pra-scoring, .pra-blank input, .pra-module textarea { font-size: var(--reading-size, var(--reading-normal)); line-height: 1.65; }
.pra-option-key { min-width: 24px; min-height: 24px; width: 1.65em; height: 1.65em; font-size: var(--reading-size, var(--reading-normal)); line-height: 1.65; }

.layout-editor .pra-pane-scroll { height: 100%; }
.layout-editor .pra-pane { overflow: hidden; }
