.config-icon.config-icon { display: flex; flex: 0 0 44px; align-items: center; justify-content: center; box-sizing: border-box; width: 44px; height: 44px; min-width: 44px; margin: 0 -11px 0 8rpx; padding: 0; border: 0; border-radius: var(--radius-control); background: transparent; }
.config-icon::after { border: 0; }
.config-icon-image { display: block; width: 22px; height: 22px; opacity: 0.6; }
.config-icon-hover { opacity: 0.65; }
