@import "./controls.wxss";

.list-page {
  min-height: 100vh;
  padding: 0 41rpx;
  box-sizing: border-box;
  background: var(--card);
  color: var(--text-main);
}

/* ---------- 页内标题（「我的」是 tab 页，导航栏标题留空） ---------- */

.page-head {
  display: flex;
  align-items: center;
  height: 131rpx;
  margin: 0 -41rpx;
  padding: 0 36rpx;
}

.page-head-title {
  font-size: var(--font-title);
  line-height: var(--leading-title);
  font-weight: 600;
  color: var(--text-main);
}

/* ---------- 资料头 ---------- */

.profile {
  display: flex;
  align-items: center;
  padding-top: 26rpx;
}

.profile-avatar {
  flex: none;
  width: 104rpx;
  height: 104rpx;
  margin-top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  overflow: hidden;
  background: var(--brand-soft);
}

.profile-avatar-img {
  display: block;
  width: 104rpx;
  height: 104rpx;
}

/* 蓝描边用户图标：app.wxss 里的 .mi-user 是白色描边（给蓝底卡片用），
   放在浅色头像底上会看不见，所以这里单独一份 */
.avatar-icon {
  width: 52rpx;
  height: 52rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  background-image: url("data:image/svg+xml;base64,");
}

.profile-main {
  flex: 1;
  min-width: 0;
  margin-left: 26rpx;
}

.profile-name {
  display: block;
  font-size: var(--font-body);
  line-height: var(--leading-body);
  font-weight: 600;
  color: var(--text-main);
}

.profile-sub {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  font-weight: 500;
  color: var(--text-main);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.profile-meta {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  font-weight: 500;
  color: var(--text-sub);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 灰底整行入口（设计稿里的「账号管理」） ---------- */

.pill-row {
  display: flex;
  align-items: center;
  height: 101rpx;
  margin-top: 47rpx;
  padding: 0 26rpx;
  border-radius: var(--radius-card);
  background: var(--page-bg);
  transition: background-color 100ms ease;
}

.pill-row-hover {
  background: var(--line);
}

.pill-row-label {
  font-size: var(--font-body);
  line-height: var(--leading-body);
  font-weight: 500;
  color: var(--text-main);
}

.pill-row-value {
  margin-left: auto;
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  font-weight: 500;
  color: var(--text-sub);
}

/* ---------- 分组与行 ---------- */

.group {
  margin-top: 52rpx;
}

.group-title {
  display: block;
  font-size: var(--font-body);
  line-height: var(--leading-body);
  font-weight: 600;
  color: var(--text-main);
}

.row {
  display: flex;
  align-items: center;
  min-height: 101rpx;
  border-bottom: 2rpx solid var(--page-bg);
  background: transparent;
  transition: background-color 100ms ease;
}

.row-hover {
  background: var(--page-bg);
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-label {
  display: block;
  font-size: var(--font-body);
  line-height: var(--leading-body);
  font-weight: 500;
  color: var(--text-main);
}

.row-desc {
  display: block;
  margin-top: 3rpx;
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  font-weight: 500;
  color: var(--text-sub);
}

.row-value {
  flex: none;
  margin-left: 22rpx;
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  font-weight: 500;
  color: var(--text-sub);
}

.row-strong {
  flex: none;
  margin-left: auto;
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  font-weight: 500;
  color: var(--brand);
}

/* 右向箭头：用边框画，比文字「›」在各机型上更稳定 */
.chevron {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  margin-left: 18rpx;
  border-top: 3rpx solid var(--text-sub);
  border-right: 3rpx solid var(--text-sub);
  transform: rotate(45deg);
}

.chevron-strong {
  border-color: var(--brand);
}

/* ---------- 底部协议链接 ---------- */

.links {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 52rpx;
  padding-bottom: 272rpx;
}

.link {
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  font-weight: 500;
  color: var(--text-sub);
}

.link-divider {
  width: 2rpx;
  height: 19rpx;
  margin: 0 30rpx;
  background: var(--page-bg);
}

/* ---------- 账号管理页：表单项 ---------- */

.section {
  margin-top: 49rpx;
}

.field {
  margin-top: 15rpx;
}

.field-label {
  display: block;
  margin-top: 22rpx;
  font-size: var(--font-secondary);
  line-height: var(--leading-secondary);
  font-weight: 500;
  color: var(--text-main);
}

.field-input {
  height: 86rpx;
  margin-top: 15rpx;
  padding: 0 26rpx;
  border-radius: var(--radius-tag);
  background: var(--page-bg);
  font-size: var(--font-body);
  line-height: var(--leading-body);
  color: var(--text-main);
}

.field-placeholder {
  color: var(--text-sub);
}

/* 账号信息项：两行（标签 + 状态与操作），行高合计 80px */
.info-item {
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--page-bg);
}

.info-label {
  display: block;
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  font-weight: 500;
  color: var(--text-main);
}

.info-line {
  display: flex;
  align-items: center;
  margin-top: 7rpx;
}

.info-value {
  font-size: var(--font-body);
  line-height: var(--leading-body);
  font-weight: 500;
  color: var(--text-sub);
}

.info-action {
  margin-left: auto;
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  font-weight: 500;
  color: var(--brand);
}

.section-note {
  display: block;
  margin-top: 11rpx;
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  font-weight: 500;
  color: var(--text-sub);
}

/* ---------- 底部固定主按钮 ---------- */

.bottom-bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 67rpx;
  bottom: calc(67rpx + env(safe-area-inset-bottom));
}

.bottom-btn-hover {
  opacity: 0.86;
}

.bottom-btn-disabled {
  background: var(--brand-soft);
}

/* 内容底部让位：90rpx 按钮 + 67rpx 底距 + 呼吸位，再叠安全区 */
.page-with-bottom-bar {
  padding-bottom: 240rpx;
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
}

/* ---------- 开关行 ---------- */

.switch-row {
  display: flex;
  align-items: center;
  min-height: 101rpx;
  border-bottom: 2rpx solid var(--page-bg);
}

.switch-row-tall {
  min-height: 134rpx;
}

/* 原生 switch 最小就是 52x32，缩放贴近设计稿的 40x24 */
.switch {
  flex: none;
  margin-left: auto;
  transform: scale(0.78);
  transform-origin: right center;
}

/* ---------- 考试记录 ---------- */

.exam-row {
  display: flex;
  align-items: center;
  min-height: 93rpx;
  border-bottom: 2rpx solid var(--page-bg);
}

.exam-date {
  margin-left: auto;
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  font-weight: 500;
  color: var(--text-sub);
}

.status-pill {
  flex: none;
  margin-left: 15rpx;
  padding: 0 11rpx;
  height: 34rpx;
  border-radius: 7rpx;
  background: var(--page-bg);
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  font-weight: 500;
  color: var(--text-sub);
  text-align: center;
}

.status-pill-upcoming {
  background: var(--brand-soft);
  color: var(--brand);
}

.status-pill-today {
  background: var(--success-soft);
  color: var(--success);
}

.add-btn {
  height: 67rpx;
  margin-top: 22rpx;
  border-radius: var(--radius-tag);
  background: var(--page-bg);
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  font-weight: 500;
  color: var(--brand);
  text-align: center;
  transition: background-color 100ms ease;
}

.add-btn-hover {
  background: var(--line);
}

/* ---------- 提前提醒勾选 ---------- */

.checkbox-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.checkbox-item {
  display: flex;
  align-items: center;
}

.checkbox {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-tag);
  border: 2rpx solid var(--line);
  background: var(--card);
  transition: background-color 0.16s ease, border-color 0.16s ease;
}

.checkbox-checked {
  border-color: var(--brand);
  background: var(--brand);
}

/* 白色对勾：两根边框拼出来，不依赖图片资源 */
.checkbox-check {
  width: 8rpx;
  height: 15rpx;
  margin: -3rpx 0 0 0;
  border-right: 3rpx solid var(--card);
  border-bottom: 3rpx solid var(--card);
  transform: rotate(45deg);
}

.checkbox-label {
  margin-left: 11rpx;
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  font-weight: 500;
  color: var(--text-main);
}

.checkbox-hint {
  display: block;
  margin-top: 15rpx;
  font-size: var(--font-caption);
  line-height: var(--leading-caption);
  color: var(--text-sub);
}

/* ---------- 弹层内容共用 ---------- */

.sheet-text {
  display: block;
  padding: 8rpx 0 24rpx;
  font-size: var(--font-secondary);
  line-height: var(--leading-secondary);
  color: var(--text-sub);
  white-space: pre-wrap;
}

.sheet-actions {
  padding-bottom: 40rpx;
}
