@import "./controls.wxss";

.auth-page {
  min-height: 100vh;
  padding: 48rpx 67rpx 60rpx;
  box-sizing: border-box;
  background: var(--card);
  /* 设计稿顶部留白 116px 已含状态栏与导航栏，导航栏本身占掉约 91px，
     所以页面内只需补 25px（≈48rpx），品牌名才会落在设计稿的位置 */
  font-family: var(--font-family);
}

/* ---------- 头部 ---------- */

.brand {
  display: flex;
  align-items: flex-end;
  height: 97rpx;
}

.brand-name {
  font-size: var(--font-display);
  line-height: 1.5;
  font-weight: 600;
  color: var(--text-main);
  letter-spacing: -1rpx;
}

.brand-sub {
  margin-left: 11rpx;
  margin-bottom: 7rpx;
  font-size: var(--font-caption);
  line-height: 1.5;
  font-weight: 500;
  color: var(--text-main);
}
.page-title {
  display: block;
  margin-top: 34rpx;
  font-size: var(--font-title);
  line-height: 1.5;
  font-weight: 600;
  color: var(--text-main);
}

/* ---------- 表单 ---------- */

.form {
  margin-top: 75rpx;
}

.field + .field {
  margin-top: 22rpx;
}

.field-label {
  display: block;
  font-size: var(--font-secondary);
  line-height: 1.5;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.9);
}

.field-input {
  display: block;
  width: 100%;
  height: 97rpx;
  margin-top: 11rpx;
  padding: 0 52rpx;
  box-sizing: border-box;
  border-radius: var(--radius-card);
  background: var(--page-bg);
  font-size: var(--font-body);
  font-weight: 500;
  color: var(--text-main);
}

.field-ph {
  font-size: var(--font-body);
  font-weight: 500;
  color: var(--text-sub);
}

/* 错误态用内阴影而不是 border：border 会吃掉 2rpx 高度，输入框会跟着抖一下 */
.field-input-error {
  box-shadow: inset 0 0 0 2rpx var(--danger);
}

/* 验证码输入行：输入框 + 右侧「发送验证码」 */
.code-row {
  display: flex;
  align-items: center;
  margin-top: 11rpx;
  height: 97rpx;
  padding: 0 52rpx 0 0;
  box-sizing: border-box;
  border-radius: var(--radius-card);
  background: var(--page-bg);
}

.code-row .field-input {
  flex: 1;
  margin-top: 0;
  height: 97rpx;
  background: transparent;
}

.code-btn {
  flex: none;
  padding-left: 16rpx;
  font-size: var(--font-caption);
  line-height: 1.5;
  font-weight: 500;
  color: var(--brand);
}

.code-btn-off {
  color: var(--text-sub);
}

/* ---------- 协议勾选 ---------- */

.agree-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 35rpx;
}

.agree-left {
  display: flex;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
}

.checkbox {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  margin-top: 1rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--line);
  border-radius: var(--radius-tag);
  background: var(--card);
}

.checkbox-on {
  border-color: var(--brand);
  background: var(--brand);
}

.checkbox-error {
  border-color: var(--danger);
}

/* 对勾：纯 CSS 两条边旋转，避免再引一张图 */
.checkbox-tick {
  width: 8rpx;
  height: 14rpx;
  margin: 4rpx 0 0 9rpx;
  border-right: 3rpx solid var(--card);
  border-bottom: 3rpx solid var(--card);
  transform: rotate(45deg);
}

.agree-text {
  margin-left: 9rpx;
  font-size: var(--font-caption);
  line-height: 1.5;
  font-weight: 500;
  color: var(--text-main);
}

.forgot-link {
  flex: none;
  margin-left: 16rpx;
  font-size: var(--font-caption);
  line-height: 1.5;
  font-weight: 500;
  color: var(--brand);
}

/* ---------- 按钮与入口 ---------- */

.btn {

  margin-top: 41rpx;

}

.text-hover {
  opacity: 0.72;
}

.or-text {
  display: block;
  margin-top: 15rpx;
  font-size: var(--font-secondary);
  line-height: 1.5;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.2);
  text-align: center;
}

.entry-link {
  display: block;
  margin-top: 22rpx;
  font-size: var(--font-secondary);
  line-height: 1.5;
  font-weight: 500;
  color: var(--brand);
  text-align: center;
}

.back-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-top: 41rpx;
}

.back-tip {
  font-size: var(--font-caption);
  line-height: 1.5;
  font-weight: 400;
  color: var(--text-main);
}
.back-link {
  margin-left: 8rpx;
  font-size: var(--font-secondary);
  line-height: 1.5;
  font-weight: 500;
  color: var(--brand);
}

/* 找回密码页那句说明，设计稿里是 12px 常规字重 */
.hint-line {
  display: block;
  margin-top: 45rpx;
  font-size: var(--font-caption);
  line-height: 1.5;
  font-weight: 400;
  color: var(--text-main);
}

.field-input { height: 48px; border: 1px solid var(--control-border); font-weight: 400; }
.field-ph { color: var(--text-sub); font-weight: 400; }
.code-row, .code-row .field-input { height: 48px; }
.agree-left { min-height: 44px; }
