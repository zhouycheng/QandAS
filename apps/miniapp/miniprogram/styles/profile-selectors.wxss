@import "./controls.wxss";
.profile-select-mask { position: fixed; inset: 0; z-index: 40; }
.profile-selector { position: relative; }
.profile-selector.is-open { z-index: 41; }
.profile-select { display: flex; align-items: center; min-height: 88rpx; padding: 0 24rpx; border: 2rpx solid var(--line); border-radius: var(--radius-tag); background: var(--card); }
.profile-select-value { flex: 1; min-width: 0; font-size: var(--font-body); color: var(--text-main); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.profile-select-value.is-placeholder { color: var(--text-sub); }
.profile-select-arrow { width: 12rpx; height: 12rpx; margin: 0 4rpx 6rpx 20rpx; border-right: 3rpx solid var(--text-sub); border-bottom: 3rpx solid var(--text-sub); transform: rotate(45deg); }
.profile-options { position: absolute; left: 0; right: 0; top: calc(100% + 8rpx); max-height: 360rpx; border: 2rpx solid var(--line); border-radius: var(--radius-tag); background: var(--card); box-shadow: 0 10rpx 32rpx rgba(22, 34, 58, .12); animation: profile-options-enter 140ms ease-out; }
.profile-option, .profile-option-note { padding: 23rpx 24rpx; font-size: var(--font-secondary); line-height: 1.5; color: var(--text-main); }
.profile-option.is-selected { background: var(--brand-soft); color: var(--brand); }
.profile-option-note { color: var(--text-sub); }
@keyframes profile-options-enter { from { opacity: 0; transform: translateY(-8rpx); } to { opacity: 1; transform: translateY(0); } }
